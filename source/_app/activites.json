{"tpl":"\n<helmet>\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/colors.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/typography.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/spacing.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/effects.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/base.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/styles.css\">\n  <script src=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/_ds_bundle.js\"></script>\n  <link rel=\"preload\" href=\"/assets/fonts/fraunces-latin.woff2\" as=\"font\" type=\"font/woff2\" crossorigin=\"anonymous\">\n  <link rel=\"preload\" href=\"/assets/fonts/nunito-sans-latin.woff2\" as=\"font\" type=\"font/woff2\" crossorigin=\"anonymous\">\n  <style>\n    @font-face { font-family: 'Caveat'; font-style: normal; font-weight: 400 600; font-display: swap; src: url(/assets/fonts/caveat-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Caveat'; font-style: normal; font-weight: 400 600; font-display: swap; src: url(/assets/fonts/caveat-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 300 600; font-display: swap; src: url(/assets/fonts/fraunces-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 300 600; font-display: swap; src: url(/assets/fonts/fraunces-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    @font-face { font-family: 'Nunito Sans'; font-style: normal; font-weight: 300 700; font-display: swap; src: url(/assets/fonts/nunito-sans-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Nunito Sans'; font-style: normal; font-weight: 300 700; font-display: swap; src: url(/assets/fonts/nunito-sans-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    :root {\n      --font-display: 'Fraunces', Georgia, serif;\n      --font-body: 'Nunito Sans', system-ui, sans-serif;\n      --font-accent: 'Caveat', cursive;\n    }\n    /* Saison : automne par défaut (aucun attribut), \"neutre\" = palette d'origine. Réglage : prop season. */\n    /* Palette d'automne : mêmes rôles que la palette d'origine, teintes terre cuite, ocre et olive brun. */\n    html:not([data-season=\"neutre\"]) {\n      --blush: #F6E6D6; --blush-deep: #EFD3BD; --pale-rose: #E8C3A4;\n      --rose: #A85A3E; --rose-deep: #8C4630;\n      --sage: #B9A56A; --sage-soft: #F1DCC6; --olive-soft: #E8E0CB;\n      --deep-olive: #5C5431;\n      --paper: #FFFCF8; --paper-warm: #FAF1E8; --border-faint: #E9D9C8;\n    }\n    body { margin: 0; background: var(--paper-warm, #FCF6F2); }\n    a { color: var(--rose); }\n    a:hover { color: var(--rose-deep); }\n    ::selection { background: var(--blush); }\n    /* Pop-up Kit : autoriser le défilement sur mobile (leur fenêtre dépasse l'écran) */\n    @media (max-width: 700px) {\n      .formkit-overlay, .formkit-modal { overflow-y: auto !important; -webkit-overflow-scrolling: touch !important; align-items: flex-start !important; }\n      .formkit-modal { max-height: 100dvh !important; }\n      .formkit-modal .formkit-form, .formkit-modal > div { max-height: none !important; }\n    }\n    /* Navigation : liens en ligne sur ordinateur, menu replié sur mobile */\n    .pp-burger { display: none; }\n    @media (max-width: 700px) {\n      .pp-nav-desktop { display: none !important; }\n      .pp-burger { display: inline-flex !important; }\n    }\n    @media (min-width: 701px) {\n      .pp-nav-mobile { display: none !important; }\n    }\n  </style>\n</helmet>\n\n<div style=\"min-height:100vh;display:flex;flex-direction:column;background:var(--paper-warm)\">\n\n  <!-- ═══════════ HEADER ═══════════ -->\n  <header style=\"display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px 24px;padding:18px min(48px,5vw);border-bottom:1px solid var(--border-faint);background:var(--paper-warm);position:sticky;top:0;z-index:10\">\n    <span onClick=\"{{ goAccueil }}\" style=\"cursor:pointer;font-family:var(--font-display);font-size:22px;color:var(--deep-olive);letter-spacing:0.06em\">Papier Pivoine</span>\n    <span class=\"pp-burger\" onClick=\"{{ toggleMenu }}\" role=\"button\" aria-label=\"Menu\" style=\"display:none;align-items:center;justify-content:center;width:44px;height:44px;margin:-8px -10px;cursor:pointer\">\n      <sc-if value=\"{{ menuClosed }}\" hint-placeholder-val=\"{{ true }}\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--deep-olive)\" stroke-width=\"1.4\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M3 8h18\"></path><path d=\"M3 16h18\"></path></svg></sc-if>\n      <sc-if value=\"{{ menuOpen }}\" hint-placeholder-val=\"{{ false }}\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--deep-olive)\" stroke-width=\"1.4\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M6 6l12 12\"></path><path d=\"M18 6L6 18\"></path></svg></sc-if>\n    </span>\n    <nav class=\"pp-nav-desktop\" style=\"display:flex;gap:6px 24px;align-items:center;flex-wrap:wrap\">\n      <span onClick=\"{{ goAccueil }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCAccueil }};border-bottom:1px solid {{ navUAccueil }}\">Accueil</span>\n      <span onClick=\"{{ goProgramme }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCProgramme }};border-bottom:1px solid {{ navUProgramme }}\">Programme d'écriture</span>\n      \n      <sc-if value=\"{{ showActivites }}\" hint-placeholder-val=\"{{ true }}\"><span onClick=\"{{ goActivites }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCActivites }};border-bottom:1px solid {{ navUActivites }}\">Carnets d'activités</span></sc-if>\n      <span onClick=\"{{ goMethode }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCMethode }};border-bottom:1px solid {{ navUMethode }}\">La méthode</span>\n      <span onClick=\"{{ goApropos }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCApropos }};border-bottom:1px solid {{ navUApropos }}\">À propos</span>\n      <span onClick=\"{{ goNewsletter }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCNewsletter }};border-bottom:1px solid {{ navUNewsletter }}\">La newsletter</span>\n    </nav>\n    <sc-if value=\"{{ menuOpen }}\" hint-placeholder-val=\"{{ false }}\">\n      <nav class=\"pp-nav-mobile\" style=\"flex-basis:100%;display:flex;flex-direction:column;padding:2px 0 8px\">\n        <span onClick=\"{{ goAccueil }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCAccueil }};border-top:1px solid var(--border-faint)\">Accueil</span>\n        <span onClick=\"{{ goProgramme }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCProgramme }};border-top:1px solid var(--border-faint)\">Programme d'écriture</span>\n        \n        <sc-if value=\"{{ showActivites }}\" hint-placeholder-val=\"{{ true }}\"><span onClick=\"{{ goActivites }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCActivites }};border-top:1px solid var(--border-faint)\">Carnets d'activités</span></sc-if>\n        <span onClick=\"{{ goMethode }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCMethode }};border-top:1px solid var(--border-faint)\">La méthode</span>\n        <span onClick=\"{{ goApropos }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCApropos }};border-top:1px solid var(--border-faint)\">À propos</span>\n        <span onClick=\"{{ goNewsletter }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCNewsletter }};border-top:1px solid var(--border-faint)\">La newsletter</span>\n      </nav>\n    </sc-if>\n  </header>\n\n  <main style=\"flex:1\">\n\n    <!-- ═══════════ ACCUEIL ═══════════ -->\n    \n\n    <!-- ═══════════ PROGRAMME D'ÉCRITURE · MENTAL LÉGER ═══════════ -->\n    \n\n    <!-- ═══════════ CARNETS D'ÉCRITURE ═══════════ -->\n    \n\n    <!-- ═══════════ CARNETS D'ACTIVITÉS ═══════════ -->\n    <sc-if value=\"{{ isActivites }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Carnets d'activités\">\n\n        <div style=\"padding:clamp(56px,9vw,88px) min(48px,5vw) 64px;text-align:center\">\n          <sc-if value=\"{{ saisonAutomne }}\" hint-placeholder-val=\"{{ true }}\"><div class=\"pp-eyebrow\" style=\"margin-bottom:20px\">Se poser au chaud</div></sc-if>\n          \n          <h1 style=\"font-family:var(--font-display);font-weight:400;font-size:clamp(30px,5.5vw,42px);line-height:1.16;letter-spacing:0.04em;color:var(--deep-olive);max-width:24ch;margin:0 auto 22px\">Les carnets d'activités</h1>\n          <p style=\"font-family:var(--font-body);font-size:clamp(16px,2.4vw,19px);color:var(--ink-soft);line-height:1.7;max-width:52ch;margin:0 auto\">Coloriage, écritures guidées, puzzles, jeux de mots et petits tests, au fil des saisons. De quoi te poser cinq minutes ou une heure entière. Chaque carnet existe en livre broché sur Amazon.</p>\n        </div>\n\n        <div style=\"background:var(--paper);border-top:1px solid var(--border-faint);border-bottom:1px solid var(--border-faint);padding:72px min(48px,5vw)\">\n          <div style=\"max-width:1000px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:40px;align-items:stretch\">\n\n            <div style=\"display:flex;flex-direction:column;background:var(--paper);border:1px solid var(--border-faint);border-radius:18px;overflow:hidden\">\n              <div style=\"background:var(--sage-soft);padding:36px 0;display:flex;align-items:center;justify-content:center\">\n                <img src=\"/assets/cover-cocon-hiver.jpg\" width=\"533\" height=\"800\" loading=\"lazy\" alt=\"Couverture : Mon cocon d'hiver\" style=\"display:block;height:320px;width:auto;border-radius:6px;border:1px solid var(--border-faint);box-shadow:0 16px 32px rgba(101,109,68,0.2)\">\n              </div>\n              <div style=\"padding:30px 32px 32px;display:flex;flex-direction:column;flex:1\">\n                <x-import component-from-global-scope=\"PapierPivoineDesignSystem_2e8f20.Tag\" tone=\"rose\" hint-size=\"150px,26px\">Hiver · bientôt</x-import>\n                <h2 style=\"font-family:var(--font-display);font-weight:400;font-size:clamp(24px,3.4vw,30px);letter-spacing:0.04em;color:var(--deep-olive);margin:16px 0 8px\">Mon cocon d'hiver</h2>\n                <p style=\"font-family:var(--font-body);font-size:15px;font-style:italic;color:var(--rose-deep);margin:0 0 16px\">Pour les longues soirées au chaud</p>\n                <p style=\"font-family:var(--font-body);font-size:15px;color:var(--ink-soft);line-height:1.7;margin:0 0 20px\">Écriture, coloriage, jeux et petits tests, pour les soirs où il fait nuit tôt. Il arrive bientôt.</p>\n                <div style=\"margin-top:auto\">\n                  <x-import component-from-global-scope=\"PapierPivoineDesignSystem_2e8f20.Button\" variant=\"secondary\" size=\"md\" onClick=\"{{ goNewsletter }}\" hint-size=\"260px,46px\">Être prévenue de sa sortie</x-import>\n                  <p style=\"font-family:var(--font-body);font-size:13px;color:var(--ink-faint);line-height:1.6;margin:12px 0 0\">Je l'annonce d'abord dans la lettre.</p>\n                </div>\n              </div>\n            </div>\n\n            <div id=\"cocon-automne\" style=\"display:flex;flex-direction:column;background:var(--paper);border:1px solid var(--border-faint);border-radius:18px;overflow:hidden\">\n              <div style=\"background:var(--sage-soft);padding:36px 0;display:flex;align-items:center;justify-content:center\">\n                <img src=\"/assets/cover-cocon-automne.jpg\" width=\"533\" height=\"800\" loading=\"lazy\" alt=\"Couverture : Le cocon d'automne\" style=\"display:block;height:320px;width:auto;border-radius:6px;border:1px solid var(--border-faint);box-shadow:0 16px 32px rgba(101,109,68,0.2)\">\n              </div>\n              <div style=\"padding:30px 32px 32px;display:flex;flex-direction:column;flex:1\">\n                <x-import component-from-global-scope=\"PapierPivoineDesignSystem_2e8f20.Tag\" tone=\"sage\" hint-size=\"150px,26px\">Automne · disponible</x-import>\n                <h2 style=\"font-family:var(--font-display);font-weight:400;font-size:clamp(24px,3.4vw,30px);letter-spacing:0.04em;color:var(--deep-olive);margin:16px 0 8px\">Le cocon d'automne</h2>\n                <p style=\"font-family:var(--font-body);font-size:15px;font-style:italic;color:var(--rose-deep);margin:0 0 16px\">Pour savourer le calme et la lenteur de l'automne</p>\n                <p style=\"font-family:var(--font-body);font-size:15px;color:var(--ink-soft);line-height:1.7;margin:0 0 12px\">Un carnet pour les soirs où la tête ne s'éteint pas. On y écrit trois lignes, on colorie de grandes illustrations d'automne, on cherche des mots doux, ou on ne fait rien du tout. 140 pages, aucun chrono, rien à finir.</p>\n                <p style=\"font-family:var(--font-body);font-size:15px;color:var(--ink-soft);line-height:1.7;margin:0 0 20px\">Pour soi, ou pour une femme qui donne beaucoup et garde tout à l'intérieur.</p>\n                <div style=\"margin-top:auto\">\n                  <x-import component-from-global-scope=\"PapierPivoineDesignSystem_2e8f20.Button\" variant=\"primary\" size=\"md\" onClick=\"{{ buyCoconAutomneAmazon }}\" hint-size=\"260px,46px\">Feuilleter et commander sur Amazon</x-import>\n                  <p style=\"font-family:var(--font-body);font-size:13px;color:var(--ink-faint);line-height:1.6;margin:12px 0 0\">Sur Amazon, tu peux feuilleter les premières pages avant de choisir.</p>\n                </div>\n              </div>\n            </div>\n\n            <div id=\"sieste-bord-eau\" style=\"display:flex;flex-direction:column;background:var(--paper);border:1px solid var(--border-faint);border-radius:18px;overflow:hidden\">\n              <div style=\"background:var(--sage-soft);padding:36px 0;display:flex;align-items:center;justify-content:center\">\n                <img src=\"/assets/cover-sieste-800.jpg\" width=\"533\" height=\"800\" loading=\"lazy\" alt=\"Couverture : La sieste au bord de l'eau\" style=\"display:block;height:320px;width:auto;border-radius:6px;border:1px solid var(--border-faint);box-shadow:0 16px 32px rgba(101,109,68,0.2)\">\n              </div>\n              <div style=\"padding:30px 32px 32px;display:flex;flex-direction:column;flex:1\">\n                <x-import component-from-global-scope=\"PapierPivoineDesignSystem_2e8f20.Tag\" tone=\"sage\" hint-size=\"150px,26px\">Août · disponible</x-import>\n                <h2 style=\"font-family:var(--font-display);font-weight:400;font-size:clamp(24px,3.4vw,30px);letter-spacing:0.04em;color:var(--deep-olive);margin:16px 0 8px\">La sieste au bord de l'eau</h2>\n                <p style=\"font-family:var(--font-body);font-size:15px;font-style:italic;color:var(--rose-deep);margin:0 0 16px\">Pour se reposer sans culpabiliser, au bord de l'océan</p>\n                <p style=\"font-family:var(--font-body);font-size:15px;color:var(--ink-soft);line-height:1.7;margin:0 0 20px\">Des coloriages de la mer (poissons, tortues, méduses, coquillages, hippocampes), des mots mêlés et mots croisés, des labyrinthes, des anagrammes, du sudoku, des écritures guidées et des listes douces. Ouvre-le où tu veux, saute une page si tu veux. 134 pages, coloriages en recto seul.</p>\n                <div style=\"margin-top:auto\">\n                  <x-import component-from-global-scope=\"PapierPivoineDesignSystem_2e8f20.Button\" variant=\"primary\" size=\"md\" onClick=\"{{ buySiesteAmazon }}\" hint-size=\"260px,46px\">Feuilleter et commander sur Amazon</x-import>\n                  <p style=\"font-family:var(--font-body);font-size:13px;color:var(--ink-faint);line-height:1.6;margin:12px 0 0\">Sur Amazon, tu peux feuilleter une vingtaine de pages avant de choisir.</p>\n                </div>\n              </div>\n            </div>\n\n            <div id=\"ete-emerveiller\" style=\"display:flex;flex-direction:column;background:var(--paper);border:1px solid var(--border-faint);border-radius:18px;overflow:hidden\">\n              <div style=\"background:var(--sage-soft);padding:30px 24px 24px;display:flex;flex-direction:column;align-items:center;gap:18px\">\n                <div style=\"display:flex;align-items:center;justify-content:center;width:100%\">\n                  <div style=\"display:{{ eteShowCover }}\"><img src=\"/assets/cover-un-ete-800.jpg\" width=\"533\" height=\"800\" alt=\"Couverture d'Un été à s'émerveiller\" style=\"display:block;height:300px;width:auto;max-width:100%;border-radius:6px;border:1px solid var(--border-faint);box-shadow:0 16px 32px rgba(101,109,68,0.2);background:var(--paper)\"></div>\n                  <div style=\"display:{{ eteShowA }}\"><img src=\"/assets/blog-ete-a.jpg\" width=\"467\" height=\"700\" loading=\"lazy\" alt=\"Page d'écriture guidée d'Un été à s'émerveiller\" style=\"display:block;height:300px;width:auto;max-width:100%;border-radius:6px;border:1px solid var(--border-faint);box-shadow:0 16px 32px rgba(101,109,68,0.2);background:var(--paper)\"></div>\n                  <div style=\"display:{{ eteShowB }}\"><img src=\"/assets/blog-ete-b.jpg\" width=\"467\" height=\"700\" loading=\"lazy\" alt=\"Coloriage d'Un été à s'émerveiller\" style=\"display:block;height:300px;width:auto;max-width:100%;border-radius:6px;border:1px solid var(--border-faint);box-shadow:0 16px 32px rgba(101,109,68,0.2);background:var(--paper)\"></div>\n                  <div style=\"display:{{ eteShowC }}\"><img src=\"/assets/blog-ete-c.jpg\" width=\"467\" height=\"700\" loading=\"lazy\" alt=\"Mots croisés d'Un été à s'émerveiller\" style=\"display:block;height:300px;width:auto;max-width:100%;border-radius:6px;border:1px solid var(--border-faint);box-shadow:0 16px 32px rgba(101,109,68,0.2);background:var(--paper)\"></div>\n                  <div style=\"display:{{ eteShowD }}\"><img src=\"/assets/blog-ete-d.jpg\" width=\"467\" height=\"700\" loading=\"lazy\" alt=\"Page à dessiner d'Un été à s'émerveiller\" style=\"display:block;height:300px;width:auto;max-width:100%;border-radius:6px;border:1px solid var(--border-faint);box-shadow:0 16px 32px rgba(101,109,68,0.2);background:var(--paper)\"></div>\n                </div>\n                <div style=\"display:flex;gap:10px;flex-wrap:wrap;justify-content:center\">\n                  <div onClick=\"{{ selectEteCover }}\" title=\"Couverture\" style=\"cursor:pointer;border-radius:5px;overflow:hidden;border:2px solid {{ eteBorderCover }};line-height:0;transition:border-color 160ms ease\" style-hover=\"border-color:var(--rose)\"><img src=\"/assets/cover-un-ete-800.jpg\" width=\"533\" height=\"800\" loading=\"lazy\" alt=\"Couverture d'Un été à s'émerveiller\" style=\"display:block;height:58px;width:auto\"></div>\n                  <div onClick=\"{{ selectEteA }}\" title=\"Écriture guidée\" style=\"cursor:pointer;border-radius:5px;overflow:hidden;border:2px solid {{ eteBorderA }};line-height:0;transition:border-color 160ms ease\" style-hover=\"border-color:var(--rose)\"><img src=\"/assets/blog-ete-a.jpg\" width=\"467\" height=\"700\" loading=\"lazy\" alt=\"Page d'écriture guidée\" style=\"display:block;height:58px;width:auto\"></div>\n                  <div onClick=\"{{ selectEteB }}\" title=\"Coloriage\" style=\"cursor:pointer;border-radius:5px;overflow:hidden;border:2px solid {{ eteBorderB }};line-height:0;transition:border-color 160ms ease\" style-hover=\"border-color:var(--rose)\"><img src=\"/assets/blog-ete-b.jpg\" width=\"467\" height=\"700\" loading=\"lazy\" alt=\"Coloriage\" style=\"display:block;height:58px;width:auto\"></div>\n                  <div onClick=\"{{ selectEteC }}\" title=\"Mots croisés\" style=\"cursor:pointer;border-radius:5px;overflow:hidden;border:2px solid {{ eteBorderC }};line-height:0;transition:border-color 160ms ease\" style-hover=\"border-color:var(--rose)\"><img src=\"/assets/blog-ete-c.jpg\" width=\"467\" height=\"700\" loading=\"lazy\" alt=\"Mots croisés\" style=\"display:block;height:58px;width:auto\"></div>\n                  <div onClick=\"{{ selectEteD }}\" title=\"Page à dessiner\" style=\"cursor:pointer;border-radius:5px;overflow:hidden;border:2px solid {{ eteBorderD }};line-height:0;transition:border-color 160ms ease\" style-hover=\"border-color:var(--rose)\"><img src=\"/assets/blog-ete-d.jpg\" width=\"467\" height=\"700\" loading=\"lazy\" alt=\"Page à dessiner\" style=\"display:block;height:58px;width:auto\"></div>\n                </div>\n              </div>\n              <div style=\"padding:30px 32px 32px;display:flex;flex-direction:column;flex:1\">\n                <x-import component-from-global-scope=\"PapierPivoineDesignSystem_2e8f20.Tag\" tone=\"sage\" hint-size=\"150px,26px\">Juillet · disponible</x-import>\n                <h2 style=\"font-family:var(--font-display);font-weight:400;font-size:clamp(24px,3.4vw,30px);letter-spacing:0.04em;color:var(--deep-olive);margin:16px 0 8px\">Un été à s'émerveiller</h2>\n                <p style=\"font-family:var(--font-body);font-size:15px;font-style:italic;color:var(--rose-deep);margin:0 0 16px\">Pour savourer la lumière et la douceur de l'été</p>\n                <p style=\"font-family:var(--font-body);font-size:15px;color:var(--ink-soft);line-height:1.7;margin:0 0 20px\">Des coloriages d'un jardin tropical, des mots mêlés, des mots croisés, une grille de sudoku, des messages à décoder, de petites écritures guidées et des listes à remplir. Aucun ordre à suivre, les solutions t'attendent à la fin.</p>\n                <div style=\"margin-top:auto\">\n                  <x-import component-from-global-scope=\"PapierPivoineDesignSystem_2e8f20.Button\" variant=\"primary\" size=\"md\" onClick=\"{{ buyEteAmazon }}\" hint-size=\"260px,46px\">Feuilleter et commander sur Amazon</x-import>\n                  <p style=\"font-family:var(--font-body);font-size:13px;color:var(--ink-faint);line-height:1.6;margin:12px 0 0\">Sur Amazon, tu peux feuilleter les premières pages avant de choisir.</p>\n                </div>\n              </div>\n            </div>\n\n          </div>\n        </div>\n\n        <div style=\"padding:76px min(48px,5vw)\">\n          <div style=\"max-width:1080px;margin:0 auto\">\n            <h2 style=\"font-family:var(--font-display);font-weight:400;font-size:28px;letter-spacing:0.04em;color:var(--deep-olive);text-align:center;margin:0 0 44px\">Ce que tu trouveras dedans</h2>\n            <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:40px\">\n              <div style=\"border-top:1px solid var(--sage);padding-top:20px\">\n                <div style=\"font-family:var(--font-body);font-size:16px;font-weight:500;color:var(--deep-olive);margin-bottom:8px\">Des coloriages</div>\n                <p style=\"font-family:var(--font-body);font-size:15px;color:var(--ink-soft);line-height:1.65;margin:0\">Un jardin tropical l'été, l'océan en août, un salon douillet à l'automne. Au trait fin, dépasser est permis.</p>\n              </div>\n              <div style=\"border-top:1px solid var(--sage);padding-top:20px\">\n                <div style=\"font-family:var(--font-body);font-size:16px;font-weight:500;color:var(--deep-olive);margin-bottom:8px\">Des puzzles et des jeux de mots</div>\n                <p style=\"font-family:var(--font-body);font-size:15px;color:var(--ink-soft);line-height:1.65;margin:0\">Mots mêlés, mots croisés, sudoku, messages à décoder. Les solutions t'attendent à la fin.</p>\n              </div>\n              <div style=\"border-top:1px solid var(--sage);padding-top:20px\">\n                <div style=\"font-family:var(--font-body);font-size:16px;font-weight:500;color:var(--deep-olive);margin-bottom:8px\">De petites écritures guidées</div>\n                <p style=\"font-family:var(--font-body);font-size:15px;color:var(--ink-soft);line-height:1.65;margin:0\">Et des listes à remplir à ton rythme.</p>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div style=\"padding:0 min(48px,5vw) 76px;text-align:center\">\n          <p style=\"font-family:var(--font-body);font-size:17px;color:var(--ink-soft);line-height:1.8;max-width:56ch;margin:0 auto 14px\">Une méthode simple traverse ces pages, la méthode pivoine : sept petites permissions, de poser ce que tu portes à t'émerveiller d'un rien.</p>\n          <p style=\"font-family:var(--font-body);font-size:17px;color:var(--ink-soft);line-height:1.8;max-width:56ch;margin:0 auto\">C'est un endroit pour respirer, loin des écrans, sans programme à suivre ni résultat à atteindre. Tu peux le garder pour toi, ou l'offrir à une amie qui en a besoin.</p>\n        </div>\n\n        <div style=\"padding:0 min(48px,5vw) 84px\">\n          <div style=\"max-width:1080px;margin:0 auto\">\n            <h3 style=\"font-family:var(--font-display);font-weight:400;font-size:24px;letter-spacing:0.04em;color:var(--deep-olive);text-align:center;margin:0 0 32px\">La suite de la série</h3>\n            <div style=\"display:grid;grid-template-columns:minmax(0,420px);justify-content:center;gap:40px;margin:0 auto\">\n              <div style=\"background:var(--paper);border:1px solid var(--border-faint);border-radius:14px;overflow:hidden\">\n                <div style=\"height:180px;background:var(--blush);display:flex;align-items:center;justify-content:center;opacity:0.8\">\n                  <div style=\"width:130px;min-height:140px;background:var(--paper);border:1px solid var(--border-faint);border-radius:4px;box-shadow:0 10px 20px rgba(101,109,68,0.12);padding:16px 12px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:8px\">\n                    <div style=\"font-family:var(--font-body);font-size:8px;letter-spacing:0.16em;text-transform:uppercase;color:var(--deep-olive);font-weight:500\">Carnet d'activités</div>\n                    <div style=\"font-family:var(--font-display);font-size:15px;line-height:1.3;letter-spacing:0.03em;color:var(--deep-olive)\">Noël</div>\n                  </div>\n                </div>\n                <div style=\"padding:20px 24px 24px;display:flex;align-items:center;justify-content:space-between;gap:12px\">\n                  <div style=\"font-family:var(--font-body);font-size:15px;font-weight:500;color:var(--deep-olive)\">Noël</div>\n                  <x-import component-from-global-scope=\"PapierPivoineDesignSystem_2e8f20.Tag\" tone=\"outline\" hint-size=\"130px,24px\">À venir en décembre</x-import>\n                </div>\n              </div>\n            </div>\n            <p style=\"font-family:var(--font-body);font-size:14px;color:var(--ink-faint);text-align:center;margin:28px 0 0\">La newsletter annonce chaque nouveau carnet en premier.</p>\n          </div>\n        </div>\n\n      </div>\n    </sc-if>\n\n    <!-- ═══════════ LA MÉTHODE ═══════════ -->\n    \n\n    <!-- ═══════════ À PROPOS ═══════════ -->\n    \n\n    <!-- ═══════════ LA NEWSLETTER ═══════════ -->\n    \n\n    <!-- ═══════════ BAND (toutes pages sauf newsletter) ═══════════ -->\n    <sc-if value=\"{{ showBand }}\" hint-placeholder-val=\"{{ true }}\">\n      <div style=\"background:var(--blush)\">\n        <div style=\"max-width:720px;margin:0 auto;padding:80px min(48px,5vw);text-align:center\">\n          <h2 style=\"font-family:var(--font-display);font-weight:400;font-size:clamp(26px,4.2vw,34px);letter-spacing:0.04em;color:var(--deep-olive);margin:0 0 18px\">Commence par un cadeau</h2>\n          <p style=\"font-family:var(--font-body);font-size:16px;color:var(--ink-soft);line-height:1.7;max-width:52ch;margin:0 auto 30px\">Une fois par mois, je t'écris : le thème de la saison, mes réflexions personnelles, un exercice d'écriture guidé, et des nouvelles de ce que je prépare. Pour t'accueillir, je t'offre la première semaine de Mental Léger, mon programme d'écriture, pour vider ta tête le soir.</p>\n          <p style=\"font-family:var(--font-body);font-size:15px;font-style:italic;color:var(--ink-soft);line-height:1.6;max-width:46ch;margin:0 auto 28px\">« Merci pour tes newsletters qui sont de réelles bouffées d'air frais. » · Virginie</p>\n          <sc-if value=\"{{ notSubscribed }}\" hint-placeholder-val=\"{{ true }}\">\n            <div style=\"display:flex;justify-content:center\">\n              <x-import component-from-global-scope=\"PapierPivoineDesignSystem_2e8f20.Button\" variant=\"primary\" size=\"lg\" onClick=\"{{ subscribe }}\" hint-size=\"200px,52px\">Recevoir le cadeau</x-import>\n            </div>\n            <p style=\"font-family:var(--font-body);font-size:12px;color:var(--ink-faint);margin:16px 0 0\">C'est gratuit. Tu peux te désinscrire quand tu veux. <span onClick=\"{{ goNewsletter }}\" style=\"color:var(--rose);cursor:pointer;text-decoration:underline;text-underline-offset:3px\">Voir ce qu'il y a dedans</span></p>\n          </sc-if>\n          <sc-if value=\"{{ subscribed }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:var(--paper);border:1px solid var(--border-faint);border-radius:14px;padding:28px 32px;max-width:440px;margin:0 auto\">\n              <p style=\"font-family:var(--font-body);font-size:16px;color:var(--deep-olive);line-height:1.6;margin:0 0 6px\">C'est noté. La première semaine de Mental Léger est en route vers ta boîte mail.</p>\n              <p style=\"font-family:var(--font-body);font-size:13px;color:var(--ink-faint);margin:0\">Si tu ne la vois pas, regarde dans les courriers indésirables.</p>\n            </div>\n          </sc-if>\n        </div>\n      </div>\n    </sc-if>\n\n  </main>\n\n  <a data-formkit-toggle=\"638990c016\" href=\"https://camelianguyen.kit.com/638990c016\" style=\"display:none\" aria-hidden=\"true\">La newsletter</a>\n\n  <!-- ═══════════ FOOTER ═══════════ -->\n  <footer style=\"background:var(--paper-warm);border-top:1px solid var(--border-faint);padding:56px min(48px,5vw) 40px\">\n    <div style=\"max-width:1180px;margin:0 auto\">\n      <div style=\"display:flex;justify-content:space-between;align-items:flex-start;gap:32px;flex-wrap:wrap\">\n        <div>\n          <div style=\"font-family:var(--font-display);font-size:20px;color:var(--deep-olive);letter-spacing:0.06em;margin-bottom:8px\">Papier Pivoine</div>\n          <p style=\"font-family:var(--font-body);font-style:italic;color:var(--rose);margin:0;font-size:14px\">Un moment à toi, des pages qui font du bien.</p>\n        </div>\n        <div style=\"display:flex;gap:40px 64px;flex-wrap:wrap\">\n          <div>\n            <div class=\"pp-eyebrow\" style=\"margin-bottom:14px\">Découvrir</div>\n            <div style=\"display:flex;flex-direction:column;gap:9px;font-family:var(--font-body);font-size:14px;color:var(--ink-soft)\">\n              <span onClick=\"{{ goProgramme }}\" style=\"cursor:pointer\">Programme d'écriture</span>\n              \n              <sc-if value=\"{{ showActivites }}\" hint-placeholder-val=\"{{ true }}\"><span onClick=\"{{ goActivites }}\" style=\"cursor:pointer\">Carnets d'activités</span></sc-if>\n              <span onClick=\"{{ goMethode }}\" style=\"cursor:pointer\">La méthode</span>\n            </div>\n          </div>\n          <div>\n            <div class=\"pp-eyebrow\" style=\"margin-bottom:14px\">Rester en lien</div>\n            <div style=\"display:flex;flex-direction:column;gap:9px;font-family:var(--font-body);font-size:14px;color:var(--ink-soft)\">\n              <span onClick=\"{{ goNewsletter }}\" style=\"cursor:pointer\">La newsletter gratuite</span>\n              <a href=\"https://fr.pinterest.com/papierpivoine/\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--ink-soft);text-decoration:none\">Pinterest</a>\n              <span onClick=\"{{ goApropos }}\" style=\"cursor:pointer\">À propos</span>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div style=\"height:1px;background:var(--border-faint);margin:36px 0\"></div>\n      <p style=\"font-family:var(--font-body);font-size:12px;color:var(--ink-faint);margin:0 0 8px;max-width:70ch;line-height:1.6\">Ce que tu trouves ici est une pratique douce, pas un soin. Ce n'est pas un substitut à un accompagnement professionnel. Si tu traverses une période difficile, parles-en à un professionnel de santé.</p>\n      <p style=\"font-family:var(--font-body);font-size:12px;color:var(--ink-faint);margin:0\">© 2026 Papier Pivoine · Camélia Nguyen</p>\n    </div>\n  </footer>\n\n  <template id=\"__bundler_thumbnail\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 100\"><rect width=\"100\" height=\"100\" fill=\"#F8E7E1\"></rect><text x=\"50\" y=\"60\" text-anchor=\"middle\" font-family=\"Georgia, serif\" font-size=\"26\" letter-spacing=\"2\" fill=\"#C47A78\">PP</text></svg></template>\n\n</div>\n"}
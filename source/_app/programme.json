{"tpl":"\n<helmet>\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/colors.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/typography.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/spacing.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/effects.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/base.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/styles.css\">\n  <script src=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/_ds_bundle.js\"></script>\n  <link rel=\"preload\" href=\"/assets/fonts/fraunces-latin.woff2\" as=\"font\" type=\"font/woff2\" crossorigin=\"anonymous\">\n  <link rel=\"preload\" href=\"/assets/fonts/nunito-sans-latin.woff2\" as=\"font\" type=\"font/woff2\" crossorigin=\"anonymous\">\n  <style>\n    @font-face { font-family: 'Caveat'; font-style: normal; font-weight: 400 600; font-display: swap; src: url(/assets/fonts/caveat-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Caveat'; font-style: normal; font-weight: 400 600; font-display: swap; src: url(/assets/fonts/caveat-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 300 600; font-display: swap; src: url(/assets/fonts/fraunces-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 300 600; font-display: swap; src: url(/assets/fonts/fraunces-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    @font-face { font-family: 'Nunito Sans'; font-style: normal; font-weight: 300 700; font-display: swap; src: url(/assets/fonts/nunito-sans-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Nunito Sans'; font-style: normal; font-weight: 300 700; font-display: swap; src: url(/assets/fonts/nunito-sans-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    :root {\n      --font-display: 'Fraunces', Georgia, serif;\n      --font-body: 'Nunito Sans', system-ui, sans-serif;\n      --font-accent: 'Caveat', cursive;\n    }\n    /* Saison : automne par défaut (aucun attribut), \"neutre\" = palette d'origine. Réglage : prop season. */\n    /* Palette d'automne : mêmes rôles que la palette d'origine, teintes terre cuite, ocre et olive brun. */\n    html:not([data-season=\"neutre\"]) {\n      --blush: #F6E6D6; --blush-deep: #EFD3BD; --pale-rose: #E8C3A4;\n      --rose: #A85A3E; --rose-deep: #8C4630;\n      --sage: #B9A56A; --sage-soft: #F1DCC6; --olive-soft: #E8E0CB;\n      --deep-olive: #5C5431;\n      --paper: #FFFCF8; --paper-warm: #FAF1E8; --border-faint: #E9D9C8;\n    }\n    body { margin: 0; background: var(--paper-warm, #FCF6F2); }\n    a { color: var(--rose); }\n    a:hover { color: var(--rose-deep); }\n    ::selection { background: var(--blush); }\n    /* Pop-up Kit : autoriser le défilement sur mobile (leur fenêtre dépasse l'écran) */\n    @media (max-width: 700px) {\n      .formkit-overlay, .formkit-modal { overflow-y: auto !important; -webkit-overflow-scrolling: touch !important; align-items: flex-start !important; }\n      .formkit-modal { max-height: 100dvh !important; }\n      .formkit-modal .formkit-form, .formkit-modal > div { max-height: none !important; }\n    }\n    /* Navigation : liens en ligne sur ordinateur, menu replié sur mobile */\n    .pp-burger { display: none; }\n    @media (max-width: 700px) {\n      .pp-nav-desktop { display: none !important; }\n      .pp-burger { display: inline-flex !important; }\n    }\n    @media (min-width: 701px) {\n      .pp-nav-mobile { display: none !important; }\n    }\n    /* Mobile : zones cliquables d'au moins 44 px */\n    @media (max-width: 700px) {\n      .pp-nav-mobile > span, .pp-nav-mobile > * > span { min-height: 44px; display: flex; align-items: center; box-sizing: border-box; }\n      header > span:first-child { min-height: 44px; display: inline-flex; align-items: center; }\n      main button, footer button { min-height: 44px; }\n      footer [style*=\"cursor: pointer\"], footer [style*=\"cursor:pointer\"], footer a { min-height: 44px; display: flex; align-items: center; }\n    }\n  </style>\n</helmet>\n\n<div style=\"min-height:100vh;display:flex;flex-direction:column;background:var(--paper-warm)\">\n\n  <!-- ═══════════ HEADER ═══════════ -->\n  <sc-if value=\"{{ showChrome }}\" hint-placeholder-val=\"{{ true }}\">\n  <header style=\"display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px 24px;padding:18px min(48px,5vw);border-bottom:1px solid var(--border-faint);background:var(--paper-warm);position:sticky;top:0;z-index:10\">\n    <span onClick=\"{{ goAccueil }}\" style=\"cursor:pointer;font-family:var(--font-display);font-size:22px;color:var(--deep-olive);letter-spacing:0.06em\">Papier Pivoine</span>\n    <span class=\"pp-burger\" onClick=\"{{ toggleMenu }}\" role=\"button\" aria-label=\"Menu\" style=\"display:none;align-items:center;justify-content:center;width:44px;height:44px;margin:-8px -10px;cursor:pointer\">\n      <sc-if value=\"{{ menuClosed }}\" hint-placeholder-val=\"{{ true }}\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--deep-olive)\" stroke-width=\"1.4\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M3 8h18\"></path><path d=\"M3 16h18\"></path></svg></sc-if>\n      <sc-if value=\"{{ menuOpen }}\" hint-placeholder-val=\"{{ false }}\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--deep-olive)\" stroke-width=\"1.4\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M6 6l12 12\"></path><path d=\"M18 6L6 18\"></path></svg></sc-if>\n    </span>\n    <nav class=\"pp-nav-desktop\" style=\"display:flex;gap:6px 24px;align-items:center;flex-wrap:wrap\">\n      <span onClick=\"{{ goAccueil }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCAccueil }};border-bottom:1px solid {{ navUAccueil }}\">Accueil</span>\n      \n      <span onClick=\"{{ goActivites }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCActivites }};border-bottom:1px solid {{ navUActivites }}\">Les saisons tranquilles</span>\n      <span onClick=\"{{ goProgramme }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCProgramme }};border-bottom:1px solid {{ navUProgramme }}\">Batterie faible</span>\n      <span onClick=\"{{ goMethode }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCMethode }};border-bottom:1px solid {{ navUMethode }}\">La méthode</span>\n      <span onClick=\"{{ goApropos }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCApropos }};border-bottom:1px solid {{ navUApropos }}\">À propos</span>\n      <span onClick=\"{{ goNewsletter }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCNewsletter }};border-bottom:1px solid {{ navUNewsletter }}\">La newsletter</span>\n    </nav>\n    <sc-if value=\"{{ menuOpen }}\" hint-placeholder-val=\"{{ false }}\">\n      <nav class=\"pp-nav-mobile\" style=\"flex-basis:100%;display:flex;flex-direction:column;padding:2px 0 8px\">\n        <span onClick=\"{{ goAccueil }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCAccueil }};border-top:1px solid var(--border-faint)\">Accueil</span>\n        \n        <span onClick=\"{{ goActivites }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCActivites }};border-top:1px solid var(--border-faint)\">Les saisons tranquilles</span>\n        <span onClick=\"{{ goProgramme }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCProgramme }};border-top:1px solid var(--border-faint)\">Batterie faible</span>\n        <span onClick=\"{{ goMethode }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCMethode }};border-top:1px solid var(--border-faint)\">La méthode</span>\n        <span onClick=\"{{ goApropos }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCApropos }};border-top:1px solid var(--border-faint)\">À propos</span>\n        <span onClick=\"{{ goNewsletter }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCNewsletter }};border-top:1px solid var(--border-faint)\">La newsletter</span>\n      </nav>\n    </sc-if>\n  </header>\n  </sc-if>\n\n  <main style=\"flex:1\">\n\n    <!-- ═══════════ ACCUEIL ═══════════ -->\n    \n\n    <!-- ═══════════ COLLECTION BATTERIE FAIBLE (route /programme/) ═══════════ -->\n    <sc-if value=\"{{ isProgramme }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Collection Batterie faible\">\n\n        <div style=\"padding:clamp(56px,9vw,88px) min(48px,5vw) clamp(40px,6vw,56px);text-align:center\">\n          <sc-if value=\"{{ saisonAutomne }}\" hint-placeholder-val=\"{{ true }}\"><div style=\"display:flex;justify-content:center;margin-bottom:24px\"><img src=\"/assets/automne/plaid-carnet.webp\" width=\"640\" height=\"422\" alt=\"\" aria-hidden=\"true\" style=\"display:block;width:min(300px,66vw);height:auto\"></div></sc-if>\n          <div class=\"pp-eyebrow\" style=\"margin-bottom:20px\">Collection</div>\n          <h1 style=\"font-family:var(--font-display);font-weight:400;font-size:clamp(32px,6vw,46px);line-height:1.14;letter-spacing:0.04em;color:var(--deep-olive);margin:0 auto 22px\">Batterie faible</h1>\n          <p style=\"font-family:var(--font-body);font-size:clamp(16px,2.4vw,19px);color:var(--ink-soft);line-height:1.7;max-width:48ch;margin:0 auto;text-wrap:pretty\">Des cahiers d'activités pour les jours où il ne te reste plus grand-chose. Quand la tête tourne trop et que tu as seulement besoin de t'asseoir, un crayon à la main.</p>\n        </div>\n\n        <div id=\"et-si\" style=\"background:var(--paper);border-top:1px solid var(--border-faint);border-bottom:1px solid var(--border-faint);padding:clamp(48px,8vw,80px) min(48px,5vw)\">\n          <div style=\"max-width:1080px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:min(64px,7vw);align-items:start\">\n            <div style=\"background:var(--blush);border-radius:14px;padding:clamp(28px,5vw,44px) 16px;display:flex;justify-content:center\">\n              <img src=\"/assets/cover-et-si.jpg\" width=\"467\" height=\"700\" alt=\"Couverture : Et si… ? Le cahier d'activités pour apaiser l'anxiété\" style=\"display:block;width:min(280px,70vw);height:auto;border-radius:6px;border:1px solid var(--border-faint);box-shadow:0 16px 32px rgba(101,109,68,0.2)\">\n            </div>\n            <div>\n              <x-import component-from-global-scope=\"PapierPivoineDesignSystem_2e8f20.Tag\" tone=\"rose\" hint-size=\"120px,26px\">Disponible</x-import>\n              <h2 style=\"font-family:var(--font-display);font-weight:400;font-size:clamp(28px,4.6vw,38px);letter-spacing:0.04em;color:var(--deep-olive);line-height:1.15;margin:16px 0 8px\">Et si… ?</h2>\n              <p style=\"font-family:var(--font-body);font-size:15px;font-style:italic;color:var(--rose-deep);line-height:1.5;margin:0 0 22px\">Le cahier d'activités pour apaiser l'anxiété, pour les femmes qui pensent trop</p>\n              <p style=\"font-family:var(--font-body);font-size:16px;color:var(--ink-soft);line-height:1.7;margin:0 0 12px\">Il est 3 h du matin. Tu rejoues la réunion de 9 h. Tu relis ce mail une cinquième fois, et tu cherches ce que ce « ok. » voulait dire.</p>\n              <p style=\"font-family:var(--font-body);font-size:16px;color:var(--ink-soft);line-height:1.7;margin:0 0 12px\">Ton alarme intérieure sonne un peu trop fort, c'est tout. Ce cahier ne te demande pas de guérir. Il te propose de t'asseoir un moment, un crayon à la main.</p>\n              <p style=\"font-family:var(--font-body);font-size:16px;color:var(--ink-soft);line-height:1.7;margin:0 0 26px\">152 pages à remplir, à colorier et à découper, pour penser un peu moins, parfois.</p>\n              <div style=\"display:flex;flex-direction:column;align-items:flex-start;gap:10px\">\n                <x-import component-from-global-scope=\"PapierPivoineDesignSystem_2e8f20.Button\" variant=\"primary\" size=\"md\" onClick=\"{{ buyEtSiAmazon }}\" hint-size=\"300px,46px\">Feuilleter et commander sur Amazon</x-import>\n                <p style=\"font-family:var(--font-body);font-size:13px;color:var(--ink-faint);line-height:1.6;margin:0\">Sur Amazon, tu peux feuilleter les premières pages avant de choisir.</p>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div style=\"padding:clamp(56px,9vw,84px) min(48px,5vw)\">\n          <div style=\"max-width:38rem;margin:0 auto\">\n            <h2 style=\"font-family:var(--font-display);font-weight:400;font-size:clamp(26px,4.4vw,32px);letter-spacing:0.04em;color:var(--deep-olive);line-height:1.2;text-align:center;margin:0 0 32px\">Ce que tu trouveras dedans</h2>\n            <div style=\"display:flex;flex-direction:column;border-bottom:1px solid var(--border-faint)\">\n              <div style=\"padding:18px 0;border-top:1px solid var(--border-faint)\"><p style=\"font-family:var(--font-body);font-size:clamp(15px,2.3vw,17px);color:var(--ink-soft);line-height:1.7;margin:0\">Des jeux : les mots croisés du bureau, le bingo du dimanche soir, le labyrinthe de la réunion, des cherche-et-trouve.</p></div>\n              <div style=\"padding:18px 0;border-top:1px solid var(--border-faint)\"><p style=\"font-family:var(--font-body);font-size:clamp(15px,2.3vw,17px);color:var(--ink-soft);line-height:1.7;margin:0\">Des coloriages pleine page, pour les jours où réfléchir est trop fatigant.</p></div>\n              <div style=\"padding:18px 0;border-top:1px solid var(--border-faint)\"><p style=\"font-family:var(--font-body);font-size:clamp(15px,2.3vw,17px);color:var(--ink-soft);line-height:1.7;margin:0\">Des pages à écrire : le mail que tu n'enverras jamais, une lettre à une amie, le procès du syndrome de l'imposteur.</p></div>\n              <div style=\"padding:18px 0;border-top:1px solid var(--border-faint)\"><p style=\"font-family:var(--font-body);font-size:clamp(15px,2.3vw,17px);color:var(--ink-soft);line-height:1.7;margin:0\">Des techniques simples à garder sous la main : la respiration lente, l'ancrage 5-4-3-2-1, le moment d'inquiétude programmé, la détente musculaire express.</p></div>\n              <div style=\"padding:18px 0;border-top:1px solid var(--border-faint)\"><p style=\"font-family:var(--font-body);font-size:clamp(15px,2.3vw,17px);color:var(--ink-soft);line-height:1.7;margin:0\">Des pages à découper, à froisser et à jeter.</p></div>\n            </div>\n          </div>\n        </div>\n\n        <div style=\"background:var(--blush);padding:clamp(56px,9vw,84px) min(48px,5vw)\">\n          <div style=\"max-width:38rem;margin:0 auto;text-align:center\">\n            <h2 style=\"font-family:var(--font-display);font-weight:400;font-size:clamp(26px,4.4vw,32px);letter-spacing:0.04em;color:var(--deep-olive);line-height:1.2;margin:0 0 20px\">Cinq chapitres</h2>\n            <p style=\"font-family:var(--font-body);font-size:16px;color:var(--ink-soft);line-height:1.7;margin:0 0 40px\">Au travail. Avec les autres. Dans ma tête. Ma boîte à outils. Et une fin en douceur, avec un diplôme et des badges à colorier.</p>\n            <div style=\"width:48px;height:1px;background:var(--sage);margin:0 auto 40px\"></div>\n            <h2 style=\"font-family:var(--font-display);font-weight:400;font-size:clamp(26px,4.4vw,32px);letter-spacing:0.04em;color:var(--deep-olive);line-height:1.2;margin:0 0 20px\">Et Gribouille</h2>\n            <p style=\"font-family:var(--font-body);font-size:16px;color:var(--ink-soft);line-height:1.7;margin:0\">C'est ton petit monstre intérieur. Il veut te protéger, et il s'y prend très mal. Au fil des pages, tu apprends à lui parler.</p>\n          </div>\n        </div>\n\n        <div style=\"padding:clamp(56px,9vw,84px) min(48px,5vw);text-align:center\">\n          <div style=\"max-width:36rem;margin:0 auto\">\n            <p style=\"font-family:var(--font-display);font-size:clamp(20px,3.4vw,26px);letter-spacing:0.03em;color:var(--deep-olive);line-height:1.45;margin:0 0 20px\">Rien à finir, rien à bien faire. Une seule consigne : sois douce avec toi.</p>\n            <p style=\"font-family:var(--font-body);font-size:16px;color:var(--ink-soft);line-height:1.7;margin:0 0 32px\">Si tu t'es reconnue quelque part, ton monstre te dira que ce n'est pas le bon moment. Il dit toujours ça.</p>\n            <div style=\"display:flex;justify-content:center\"><x-import component-from-global-scope=\"PapierPivoineDesignSystem_2e8f20.Button\" variant=\"primary\" size=\"lg\" onClick=\"{{ buyEtSiAmazon }}\" hint-size=\"300px,52px\">Commander Et si… ? sur Amazon</x-import></div>\n          </div>\n        </div>\n\n        <div style=\"background:var(--paper);border-top:1px solid var(--border-faint);border-bottom:1px solid var(--border-faint);padding:clamp(48px,8vw,72px) min(48px,5vw)\">\n          <div style=\"max-width:720px;margin:0 auto;display:grid;grid-template-columns:clamp(90px,22vw,130px) minmax(0,1fr);gap:clamp(20px,5vw,40px);align-items:center\">\n            <div style=\"width:100%;aspect-ratio:2/3;border-radius:6px;background:var(--blush);border:1px solid var(--border-faint)\"></div>\n            <div>\n              <x-import component-from-global-scope=\"PapierPivoineDesignSystem_2e8f20.Tag\" tone=\"sage\" hint-size=\"120px,26px\">Bientôt</x-import>\n              <h3 style=\"font-family:var(--font-display);font-weight:400;font-size:clamp(20px,3vw,25px);letter-spacing:0.04em;color:var(--deep-olive);line-height:1.3;margin:14px 0 10px;text-wrap:balance\">Trop sensible, trop fatiguée, trop bien sous mon plaid</h3>\n              <p style=\"font-family:var(--font-body);font-size:15px;color:var(--ink-soft);line-height:1.7;margin:0 0 18px\">Le prochain cahier de la collection. Je l'annonce d'abord dans la newsletter.</p>\n              <x-import component-from-global-scope=\"PapierPivoineDesignSystem_2e8f20.Button\" variant=\"secondary\" size=\"md\" onClick=\"{{ goNewsletter }}\" hint-size=\"240px,46px\">Être prévenue de sa sortie</x-import>\n            </div>\n          </div>\n        </div>\n\n        <div style=\"padding:clamp(40px,6vw,56px) min(48px,5vw) clamp(48px,7vw,64px)\">\n          <div style=\"max-width:54ch;margin:0 auto;text-align:center\">\n            <p style=\"font-family:var(--font-body);font-size:13px;color:var(--ink-faint);line-height:1.7;margin:0 0 12px\">Ces cahiers t'accompagnent au quotidien. Ils ne remplacent ni un suivi médical, ni une psychothérapie. Des contacts utiles se trouvent à la fin de chaque cahier.</p>\n            <p style=\"font-family:var(--font-body);font-size:13px;color:var(--ink-faint);line-height:1.7;margin:0\">Si tu traverses une période difficile : le 3114, numéro national de prévention du suicide, répond 24 h/24 et 7 j/7. SOS Amitié : 09 72 39 40 50.</p>\n          </div>\n        </div>\n\n      </div>\n    </sc-if>\n\n    <!-- ═══════════ CARNETS D'ÉCRITURE ═══════════ -->\n    \n\n    <!-- ═══════════ COLLECTION LES SAISONS TRANQUILLES (route /activites/) ═══════════ -->\n    \n\n    <!-- ═══════════ LA MÉTHODE ═══════════ -->\n    \n\n    <!-- ═══════════ À PROPOS ═══════════ -->\n    \n\n    <!-- ═══════════ LA NEWSLETTER ═══════════ -->\n    \n\n\n    <!-- ═══════════ LIENS ═══════════ -->\n    \n\n    <!-- ═══════════ BAND (toutes pages sauf newsletter) ═══════════ -->\n    <sc-if value=\"{{ showBand }}\" hint-placeholder-val=\"{{ true }}\">\n      <div style=\"background:var(--blush)\">\n        <div style=\"max-width:720px;margin:0 auto;padding:80px min(48px,5vw);text-align:center\">\n          <h2 style=\"font-family:var(--font-display);font-weight:400;font-size:clamp(26px,4.2vw,34px);letter-spacing:0.04em;color:var(--deep-olive);margin:0 0 18px\">Commence par un cadeau</h2>\n          <p style=\"font-family:var(--font-body);font-size:16px;color:var(--ink-soft);line-height:1.7;max-width:52ch;margin:0 auto 30px\">Une fois par mois, je t'écris : le thème de la saison, mes réflexions, un exercice d'écriture guidé, et les nouveaux cahiers en premier. Pour t'accueillir, je t'offre la première semaine de Mental Léger, pour vider ta tête le soir.</p>\n          <p style=\"font-family:var(--font-body);font-size:15px;font-style:italic;color:var(--ink-soft);line-height:1.6;max-width:46ch;margin:0 auto 28px\">« Merci pour tes newsletters qui sont de réelles bouffées d'air frais. » · Virginie</p>\n          <sc-if value=\"{{ notSubscribed }}\" hint-placeholder-val=\"{{ true }}\">\n            <div style=\"display:flex;justify-content:center\">\n              <x-import component-from-global-scope=\"PapierPivoineDesignSystem_2e8f20.Button\" variant=\"primary\" size=\"lg\" onClick=\"{{ subscribe }}\" hint-size=\"200px,52px\">Recevoir le cadeau</x-import>\n            </div>\n            <p style=\"font-family:var(--font-body);font-size:12px;color:var(--ink-faint);margin:16px 0 0\">C'est gratuit. Tu peux te désinscrire quand tu veux. <span onClick=\"{{ goNewsletter }}\" style=\"color:var(--rose);cursor:pointer;text-decoration:underline;text-underline-offset:3px\">Voir ce qu'il y a dedans</span></p>\n          </sc-if>\n          <sc-if value=\"{{ subscribed }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:var(--paper);border:1px solid var(--border-faint);border-radius:14px;padding:28px 32px;max-width:440px;margin:0 auto\">\n              <p style=\"font-family:var(--font-body);font-size:16px;color:var(--deep-olive);line-height:1.6;margin:0 0 6px\">C'est noté. La première semaine de Mental Léger est en route vers ta boîte mail.</p>\n              <p style=\"font-family:var(--font-body);font-size:13px;color:var(--ink-faint);margin:0\">Si tu ne la vois pas, regarde dans les courriers indésirables.</p>\n            </div>\n          </sc-if>\n        </div>\n        <sc-if value=\"{{ saisonAutomne }}\" hint-placeholder-val=\"{{ true }}\"><div style=\"display:flex;justify-content:center;padding:0 min(48px,5vw)\"><img loading=\"lazy\" decoding=\"async\" src=\"/assets/automne/herbes-sechees.webp\" width=\"1000\" height=\"384\" alt=\"\" aria-hidden=\"true\" style=\"display:block;width:min(900px,100%);height:auto\"></div></sc-if>\n      </div>\n    </sc-if>\n\n  </main>\n\n  <a data-formkit-toggle=\"638990c016\" href=\"https://camelianguyen.kit.com/638990c016\" style=\"display:none\" aria-hidden=\"true\">La newsletter</a>\n\n  <!-- ═══════════ FOOTER ═══════════ -->\n  <sc-if value=\"{{ showChrome }}\" hint-placeholder-val=\"{{ true }}\">\n  <footer style=\"background:var(--paper-warm);border-top:1px solid var(--border-faint);padding:56px min(48px,5vw) 40px\">\n    <div style=\"max-width:1180px;margin:0 auto\">\n      <div style=\"display:flex;justify-content:space-between;align-items:flex-start;gap:32px;flex-wrap:wrap\">\n        <div>\n          <div style=\"font-family:var(--font-display);font-size:20px;color:var(--deep-olive);letter-spacing:0.06em;margin-bottom:8px\">Papier Pivoine</div>\n          <p style=\"font-family:var(--font-body);font-style:italic;color:var(--rose);margin:0;font-size:14px;max-width:32ch;line-height:1.5\">Trop sensible, trop fatiguée, trop bien sous mon plaid.</p>\n        </div>\n        <div style=\"display:flex;gap:40px 64px;flex-wrap:wrap\">\n          <div>\n            <div class=\"pp-eyebrow\" style=\"margin-bottom:14px\">Découvrir</div>\n            <div style=\"display:flex;flex-direction:column;gap:9px;font-family:var(--font-body);font-size:14px;color:var(--ink-soft)\">\n              <span onClick=\"{{ goActivites }}\" style=\"cursor:pointer\">Les saisons tranquilles</span>\n              <span onClick=\"{{ goProgramme }}\" style=\"cursor:pointer\">Batterie faible</span>\n              <span onClick=\"{{ goMethode }}\" style=\"cursor:pointer\">La méthode</span>\n            </div>\n          </div>\n          <div>\n            <div class=\"pp-eyebrow\" style=\"margin-bottom:14px\">Rester en lien</div>\n            <div style=\"display:flex;flex-direction:column;gap:9px;font-family:var(--font-body);font-size:14px;color:var(--ink-soft)\">\n              <span onClick=\"{{ goNewsletter }}\" style=\"cursor:pointer\">La newsletter gratuite</span>\n              <a href=\"https://fr.pinterest.com/papierpivoine/\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--ink-soft);text-decoration:none\">Pinterest</a>\n              <a href=\"https://www.instagram.com/papierpivoine/\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--ink-soft);text-decoration:none\">Instagram</a>\n              <a href=\"https://www.tiktok.com/@papierpivoine\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--ink-soft);text-decoration:none\">TikTok</a>\n              <span onClick=\"{{ goApropos }}\" style=\"cursor:pointer\">À propos</span>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div style=\"height:1px;background:var(--border-faint);margin:36px 0\"></div>\n      <p style=\"font-family:var(--font-body);font-size:12px;color:var(--ink-faint);margin:0 0 8px;max-width:70ch;line-height:1.6\">Ce que tu trouves ici est une pratique douce, pas un soin. Ce n'est pas un substitut à un accompagnement professionnel. Si tu traverses une période difficile, parles-en à un professionnel de santé.</p>\n      <p style=\"font-family:var(--font-body);font-size:12px;color:var(--ink-faint);margin:0\">© 2026 Papier Pivoine · Camélia Nguyen</p>\n    </div>\n  </footer>\n  </sc-if>\n\n  <template id=\"__bundler_thumbnail\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 100\"><rect width=\"100\" height=\"100\" fill=\"#F8E7E1\"></rect><text x=\"50\" y=\"60\" text-anchor=\"middle\" font-family=\"Georgia, serif\" font-size=\"26\" letter-spacing=\"2\" fill=\"#C47A78\">PP</text></svg></template>\n\n</div>\n"}
{"tpl":"\n<helmet>\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/colors.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/typography.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/spacing.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/effects.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/base.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/styles.css\">\n  <script src=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/_ds_bundle.js\"></script>\n  <link rel=\"preload\" href=\"/assets/fonts/fraunces-800-latin.woff2\" as=\"font\" type=\"font/woff2\" crossorigin=\"anonymous\">\n  <link rel=\"preload\" href=\"/assets/fonts/nunito-sans-latin.woff2\" as=\"font\" type=\"font/woff2\" crossorigin=\"anonymous\">\n  <style>\n    @font-face { font-family: 'Caveat'; font-style: normal; font-weight: 400 600; font-display: swap; src: url(/assets/fonts/caveat-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Caveat'; font-style: normal; font-weight: 400 600; font-display: swap; src: url(/assets/fonts/caveat-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 300 600; font-display: swap; src: url(/assets/fonts/fraunces-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 300 600; font-display: swap; src: url(/assets/fonts/fraunces-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    @font-face { font-family: 'Nunito Sans'; font-style: normal; font-weight: 300 700; font-display: swap; src: url(/assets/fonts/nunito-sans-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Nunito Sans'; font-style: normal; font-weight: 300 700; font-display: swap; src: url(/assets/fonts/nunito-sans-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    @font-face { font-family: 'Caveat'; font-style: normal; font-weight: 700; font-display: swap; src: url(/assets/fonts/caveat-700-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Caveat'; font-style: normal; font-weight: 700; font-display: swap; src: url(/assets/fonts/caveat-700-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    @font-face { font-family: 'Fraunces'; font-style: italic; font-weight: 700; font-display: swap; src: url(/assets/fonts/fraunces-italic-700-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Fraunces'; font-style: italic; font-weight: 700; font-display: swap; src: url(/assets/fonts/fraunces-italic-700-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 800; font-display: swap; src: url(/assets/fonts/fraunces-800-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 800; font-display: swap; src: url(/assets/fonts/fraunces-800-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    :root {\n      --font-display: 'Fraunces', Georgia, serif;\n      --font-body: 'Nunito Sans', system-ui, sans-serif;\n      --font-accent: 'Caveat', cursive;\n    }\n    /* Saison : automne par défaut (aucun attribut), \"neutre\" = palette d'origine. Réglage : prop season. */\n    /* Palette d'automne : mêmes rôles que la palette d'origine, teintes terre cuite, ocre et olive brun. */\n    html:not([data-season=\"neutre\"]) {\n      --blush: #F7D9D3; --blush-deep: #F0C7BF; --pale-rose: #DDA9A0;\n      --rose: #E26D5F; --rose-deep: #BF5548;\n      --sage: #B2BD88; --sage-soft: #EEF0DE; --olive-soft: #E9ECD9;\n      --deep-olive: #33321E; --ink: #33321E; --ink-soft: #46452F; --ink-faint: #6B6953;\n      --paper: #FFFCFA; --paper-warm: #FCF6F2; --border-faint: #EDE1D6; --sand: #EAD9AC;\n      --text-on-accent: #FFFCFA;\n    }\n    body { margin: 0; background: var(--paper-warm, #FCF6F2); }\n    a { color: var(--rose-deep); }\n    a:hover { color: var(--ink); }\n    mark { -webkit-box-decoration-break: clone; box-decoration-break: clone; }\n    ::selection { background: var(--blush); }\n    /* Pop-up Kit : autoriser le défilement sur mobile (leur fenêtre dépasse l'écran) */\n    @media (max-width: 700px) {\n      .formkit-overlay, .formkit-modal { overflow-y: auto !important; -webkit-overflow-scrolling: touch !important; align-items: flex-start !important; }\n      .formkit-modal { max-height: 100dvh !important; }\n      .formkit-modal .formkit-form, .formkit-modal > div { max-height: none !important; }\n    }\n    /* Navigation : liens en ligne sur ordinateur, menu replié sur mobile */\n    .pp-burger { display: none; }\n    @media (max-width: 700px) {\n      .pp-nav-desktop { display: none !important; }\n      .pp-burger { display: inline-flex !important; }\n    }\n    @media (min-width: 701px) {\n      .pp-nav-mobile { display: none !important; }\n    }\n    /* Mobile : zones cliquables d'au moins 44 px */\n    @media (max-width: 700px) {\n      .pp-nav-mobile > span, .pp-nav-mobile > * > span { min-height: 44px; display: flex; align-items: center; box-sizing: border-box; }\n      header > span:first-child { min-height: 44px; display: inline-flex; align-items: center; }\n      main button, footer button { min-height: 44px; }\n      footer [style*=\"cursor: pointer\"], footer [style*=\"cursor:pointer\"], footer a { min-height: 44px; display: flex; align-items: center; }\n    }\n  </style>\n</helmet>\n\n<div style=\"min-height:100vh;display:flex;flex-direction:column;background:var(--paper-warm)\">\n\n  <!-- ═══════════ HEADER ═══════════ -->\n  \n\n  <main style=\"flex:1\">\n\n    <!-- ═══════════ ACCUEIL ═══════════ -->\n    \n\n    <!-- ═══════════ CARNETS D'ÉCRITURE ═══════════ -->\n    \n\n    <!-- ═══════════ CARNETS D’ACTIVITÉS DOUCES (route /activites/ : Saisons tranquilles puis Batterie faible) ═══════════ -->\n    \n\n    <!-- ═══════════ 7 PERMISSIONS PIVOINE ═══════════ -->\n    \n\n    <!-- ═══════════ À PROPOS ═══════════ -->\n    \n\n    <!-- ═══════════ NEWSLETTER ═══════════ -->\n    \n\n\n    <!-- ═══════════ LIENS ═══════════ -->\n    <sc-if value=\"{{ isLiens }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Liens\" style=\"min-height:100vh;background-color:#FCF6F2;background-image:radial-gradient(#E9DCCB 1.6px, transparent 1.8px);background-size:32px 32px;padding:clamp(20px,5vw,56px) clamp(12px,3vw,24px);display:flex;justify-content:center;align-items:flex-start;box-sizing:border-box\">\n        <div style=\"width:100%;max-width:560px;background:var(--paper);border:1px solid var(--border-faint);border-radius:22px;box-shadow:0 4px 24px rgba(101,109,68,0.08);padding:clamp(28px,6vw,48px) clamp(18px,5vw,44px) clamp(28px,6vw,40px);box-sizing:border-box\">\n          <img src=\"/assets/logo-papier-pivoine.jpg\" width=\"400\" height=\"400\" alt=\"Camélia et son chat Bao, une tasse de thé à la main\" style=\"display:block;width:112px;height:112px;border-radius:50%;margin:0 auto 14px;border:3px solid var(--ink);box-sizing:border-box\">\n          <a href=\"/\" style=\"display:block;text-align:center;font-family:var(--font-display);font-weight:800;font-variation-settings:'opsz' 72;font-size:22px;color:var(--deep-olive);text-decoration:none;margin-bottom:clamp(20px,5vw,28px)\">Papier Pivoine</a>\n          <div style=\"text-align:center;margin-bottom:clamp(24px,6vw,36px)\">\n            <div class=\"pp-eyebrow\" style=\"margin-bottom:14px\">Tous mes carnets</div>\n            <h1 style=\"font-family:var(--font-display);font-weight:800;font-variation-settings:'opsz' 72;letter-spacing:-0.005em;line-height:1.08;font-size:clamp(34px,8vw,44px);color:var(--deep-olive);margin:0 0 12px\">Mes <mark style=\"background:linear-gradient(transparent 55%, #EAD9AC 55%, #EAD9AC 92%, transparent 92%);color:inherit;padding:0 6px\">liens</mark></h1>\n            <p style=\"font-family:var(--font-body);font-size:18px;color:var(--ink-soft);line-height:1.6;margin:0 auto;max-width:40ch\">Des carnets d’activités cocooning pour hypersensibles et introverties. Prends ton temps pour choisir.</p>\n          </div>\n          <div style=\"margin-bottom:32px\">\n            <div class=\"pp-eyebrow\" style=\"margin-bottom:12px\">Collection</div>\n            <h2 style=\"font-family:var(--font-display);font-weight:800;font-variation-settings:'opsz' 72;letter-spacing:-0.005em;line-height:1.08;font-size:clamp(22px,4vw,26px);color:var(--deep-olive);margin:0 0 6px\">Saisons tranquilles</h2>\n            <div style=\"display:flex;flex-direction:column;border-bottom:1px solid var(--border-faint)\">\n              <div style=\"display:grid;grid-template-columns:clamp(72px,20vw,96px) minmax(0,1fr);gap:clamp(14px,4vw,20px);align-items:center;padding:20px 0;border-top:1px solid var(--border-faint)\">\n                <img src=\"/assets/cover-cocon-automne.jpg\" alt=\"Couverture du carnet Le cocon d’automne\" loading=\"lazy\" style=\"width:100%;height:auto;display:block;border-radius:4px;box-shadow:0 2px 10px rgba(101,109,68,0.14)\">\n                <div style=\"display:flex;flex-direction:column;gap:8px;min-width:0\">\n                  <div style=\"font-family:var(--font-display);font-weight:700;font-style:italic;font-size:clamp(19px,4.8vw,21px);color:var(--deep-olive);line-height:1.2;text-wrap:balance\">Le cocon d’automne</div>\n                  <p style=\"font-family:var(--font-body);font-size:16px;color:var(--ink-soft);line-height:1.6;margin:0;text-wrap:pretty\">Écriture, coloriage, jeux et tests pour se poser sans culpabiliser, quand on ressent tout un peu fort.</p>\n                  <div style=\"display:flex;gap:10px;flex-wrap:wrap;margin-top:4px\"><a href=\"https://www.amazon.fr/dp/B0HHLYRWNM\" target=\"_blank\" rel=\"noopener\" style=\"display:inline-flex;align-items:center;justify-content:center;gap:10px;box-sizing:border-box;max-width:100%;text-align:center;padding:8px 26px 10px;border:3px solid var(--rose);border-radius:999px;color:var(--rose);font-family:var(--font-accent);font-weight:700;font-size:24px;line-height:1.1;transform:rotate(-2deg);background:transparent;cursor:pointer;text-decoration:none;transition:background-color 200ms ease,color 200ms ease;padding:6px 20px 8px;margin:4px 0 0 2px\" style-hover=\"background:var(--rose);color:var(--paper-warm)\" style-focus=\"outline:2px solid var(--ink);outline-offset:4px\">Commander sur Amazon</a></div>\n                </div>\n              </div>\n              <div style=\"display:grid;grid-template-columns:clamp(72px,20vw,96px) minmax(0,1fr);gap:clamp(14px,4vw,20px);align-items:center;padding:20px 0;border-top:1px solid var(--border-faint)\">\n                <img src=\"/assets/cover-cocon-hiver.jpg\" alt=\"Couverture du carnet Mon cocon d’hiver\" loading=\"lazy\" style=\"width:100%;height:auto;display:block;border-radius:4px;box-shadow:0 2px 10px rgba(101,109,68,0.14)\">\n                <div style=\"display:flex;flex-direction:column;gap:8px;min-width:0\">\n                  <div style=\"font-family:var(--font-display);font-weight:700;font-style:italic;font-size:clamp(19px,4.8vw,21px);color:var(--deep-olive);line-height:1.2;text-wrap:balance\">Mon cocon d’hiver</div>\n                  <p style=\"font-family:var(--font-body);font-size:16px;color:var(--ink-soft);line-height:1.6;margin:0;text-wrap:pretty\">Plus de 90 activités : écriture, coloriages, énigmes et tests de personnalité, avec les solutions.</p>\n                  <div style=\"display:flex;gap:10px;flex-wrap:wrap;margin-top:4px\"><a href=\"https://www.amazon.fr/dp/B0HL6VVS5X\" target=\"_blank\" rel=\"noopener\" style=\"display:inline-flex;align-items:center;justify-content:center;gap:10px;box-sizing:border-box;max-width:100%;text-align:center;padding:8px 26px 10px;border:3px solid var(--rose);border-radius:999px;color:var(--rose);font-family:var(--font-accent);font-weight:700;font-size:24px;line-height:1.1;transform:rotate(-2deg);background:transparent;cursor:pointer;text-decoration:none;transition:background-color 200ms ease,color 200ms ease;padding:6px 20px 8px;margin:4px 0 0 2px\" style-hover=\"background:var(--rose);color:var(--paper-warm)\" style-focus=\"outline:2px solid var(--ink);outline-offset:4px\">Commander sur Amazon</a></div>\n                </div>\n              </div>\n            </div>\n          </div>\n          \n          <div style=\"margin-bottom:32px\">\n            <div class=\"pp-eyebrow\" style=\"margin-bottom:12px\">Collection</div>\n            <h2 style=\"font-family:var(--font-display);font-weight:800;font-variation-settings:'opsz' 72;letter-spacing:-0.005em;line-height:1.08;font-size:clamp(22px,4vw,26px);color:var(--deep-olive);margin:0 0 6px\">Batterie faible</h2>\n            <div style=\"display:flex;flex-direction:column;border-bottom:1px solid var(--border-faint)\">\n              <div style=\"display:grid;grid-template-columns:clamp(72px,20vw,96px) minmax(0,1fr);gap:clamp(14px,4vw,20px);align-items:center;padding:20px 0;border-top:1px solid var(--border-faint)\">\n                <img src=\"/assets/cover-et-si.jpg\" alt=\"Couverture du carnet Et si… ?\" loading=\"lazy\" style=\"width:100%;height:auto;display:block;border-radius:4px;box-shadow:0 2px 10px rgba(101,109,68,0.14)\">\n                <div style=\"display:flex;flex-direction:column;gap:8px;min-width:0\">\n                  <div style=\"font-family:var(--font-display);font-weight:700;font-style:italic;font-size:clamp(19px,4.8vw,21px);color:var(--deep-olive);line-height:1.2;text-wrap:balance\">Et si… ?</div>\n                  <p style=\"font-family:var(--font-body);font-size:16px;color:var(--ink-soft);line-height:1.6;margin:0;text-wrap:pretty\">Jeux, coloriages et exercices pour arrêter de ruminer et retrouver le calme. Pour les femmes qui pensent trop.</p>\n                  <div style=\"display:flex;gap:10px;flex-wrap:wrap;margin-top:4px\"><a href=\"https://www.amazon.fr/dp/B0HL27XDWD\" target=\"_blank\" rel=\"noopener\" style=\"display:inline-flex;align-items:center;justify-content:center;gap:10px;box-sizing:border-box;max-width:100%;text-align:center;padding:8px 26px 10px;border:3px solid var(--rose);border-radius:999px;color:var(--rose);font-family:var(--font-accent);font-weight:700;font-size:24px;line-height:1.1;transform:rotate(-2deg);background:transparent;cursor:pointer;text-decoration:none;transition:background-color 200ms ease,color 200ms ease;padding:6px 20px 8px;margin:4px 0 0 2px\" style-hover=\"background:var(--rose);color:var(--paper-warm)\" style-focus=\"outline:2px solid var(--ink);outline-offset:4px\">Commander sur Amazon</a></div>\n                </div>\n              </div>\n              <div style=\"display:grid;grid-template-columns:clamp(72px,20vw,96px) minmax(0,1fr);gap:clamp(14px,4vw,20px);align-items:center;padding:20px 0;border-top:1px solid var(--border-faint)\">\n                <div style=\"width:100%;aspect-ratio:2/3;border-radius:4px;background:var(--blush);border:1px solid var(--border-faint)\"></div>\n                <div style=\"display:flex;flex-direction:column;gap:8px;min-width:0\">\n                  <div style=\"font-family:var(--font-display);font-weight:700;font-style:italic;font-size:clamp(19px,4.8vw,21px);color:var(--deep-olive);line-height:1.2;text-wrap:balance\">Trop sensible, trop fatiguée, trop bien sous mon plaid</div>\n                  <p style=\"font-family:var(--font-body);font-size:16px;color:var(--ink-soft);line-height:1.6;margin:0;text-wrap:pretty\">Le prochain carnet de la collection.</p>\n                  <div style=\"display:flex;gap:10px;flex-wrap:wrap;margin-top:4px\"><span style=\"font-family:var(--font-body);font-size:13px;font-style:italic;color:var(--rose-deep)\">Bientôt disponible</span></div>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div style=\"display:flex;flex-direction:column;gap:12px;margin-top:36px\">\n            <div style=\"display:flex;justify-content:center;margin-bottom:10px\"><a href=\"/newsletter/\" style=\"display:inline-flex;align-items:center;justify-content:center;gap:10px;box-sizing:border-box;max-width:100%;text-align:center;padding:8px 26px 10px;border:3px solid var(--rose);border-radius:999px;color:var(--rose);font-family:var(--font-accent);font-weight:700;font-size:28px;line-height:1.1;transform:rotate(-2deg);background:transparent;cursor:pointer;text-decoration:none;transition:background-color 200ms ease,color 200ms ease\" style-hover=\"background:var(--rose);color:var(--paper-warm)\" style-focus=\"outline:2px solid var(--ink);outline-offset:4px\">Newsletter gratuite, avec un cadeau</a></div>\n            <a href=\"https://fr.pinterest.com/papierpivoine/\" target=\"_blank\" rel=\"noopener\" style=\"display:flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:0 18px;border-radius:999px;border:2px solid var(--ink);color:var(--ink);background:var(--paper);font-family:var(--font-body);font-weight:600;font-size:16px;text-decoration:none;transition:background-color 200ms ease\" style-hover=\"background:var(--blush)\" style-focus=\"outline:2px solid var(--ink);outline-offset:3px\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"8.5\"></circle><path d=\"M10.
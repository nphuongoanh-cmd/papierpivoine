{"tpl":"\n<helmet>\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/colors.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/typography.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/spacing.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/effects.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/base.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/styles.css\">\n  <script src=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/_ds_bundle.js\"></script>\n  <link rel=\"preload\" href=\"/assets/fonts/fraunces-latin.woff2\" as=\"font\" type=\"font/woff2\" crossorigin=\"anonymous\">\n  <link rel=\"preload\" href=\"/assets/fonts/nunito-sans-latin.woff2\" as=\"font\" type=\"font/woff2\" crossorigin=\"anonymous\">\n  <style>\n    @font-face { font-family: 'Caveat'; font-style: normal; font-weight: 400 600; font-display: swap; src: url(/assets/fonts/caveat-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Caveat'; font-style: normal; font-weight: 400 600; font-display: swap; src: url(/assets/fonts/caveat-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 300 600; font-display: swap; src: url(/assets/fonts/fraunces-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 300 600; font-display: swap; src: url(/assets/fonts/fraunces-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    @font-face { font-family: 'Nunito Sans'; font-style: normal; font-weight: 300 700; font-display: swap; src: url(/assets/fonts/nunito-sans-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Nunito Sans'; font-style: normal; font-weight: 300 700; font-display: swap; src: url(/assets/fonts/nunito-sans-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    :root {\n      --font-display: 'Fraunces', Georgia, serif;\n      --font-body: 'Nunito Sans', system-ui, sans-serif;\n      --font-accent: 'Caveat', cursive;\n    }\n    /* Saison : automne par défaut (aucun attribut), \"neutre\" = palette d'origine. Réglage : prop season. */\n    /* Palette d'automne : mêmes rôles que la palette d'origine, teintes terre cuite, ocre et olive brun. */\n    html:not([data-season=\"neutre\"]) {\n      --blush: #F6E6D6; --blush-deep: #EFD3BD; --pale-rose: #E8C3A4;\n      --rose: #A85A3E; --rose-deep: #8C4630;\n      --sage: #B9A56A; --sage-soft: #F1DCC6; --olive-soft: #E8E0CB;\n      --deep-olive: #5C5431;\n      --paper: #FFFCF8; --paper-warm: #FAF1E8; --border-faint: #E9D9C8;\n    }\n    body { margin: 0; background: var(--paper-warm, #FCF6F2); }\n    a { color: var(--rose); }\n    a:hover { color: var(--rose-deep); }\n    ::selection { background: var(--blush); }\n    /* Pop-up Kit : autoriser le défilement sur mobile (leur fenêtre dépasse l'écran) */\n    @media (max-width: 700px) {\n      .formkit-overlay, .formkit-modal { overflow-y: auto !important; -webkit-overflow-scrolling: touch !important; align-items: flex-start !important; }\n      .formkit-modal { max-height: 100dvh !important; }\n      .formkit-modal .formkit-form, .formkit-modal > div { max-height: none !important; }\n    }\n    /* Navigation : liens en ligne sur ordinateur, menu replié sur mobile */\n    .pp-burger { display: none; }\n    @media (max-width: 700px) {\n      .pp-nav-desktop { display: none !important; }\n      .pp-burger { display: inline-flex !important; }\n    }\n    @media (min-width: 701px) {\n      .pp-nav-mobile { display: none !important; }\n    }\n    /* Mobile : zones cliquables d'au moins 44 px */\n    @media (max-width: 700px) {\n      .pp-nav-mobile > span, .pp-nav-mobile > * > span { min-height: 44px; display: flex; align-items: center; box-sizing: border-box; }\n      header > span:first-child { min-height: 44px; display: inline-flex; align-items: center; }\n      main button, footer button { min-height: 44px; }\n      footer [style*=\"cursor: pointer\"], footer [style*=\"cursor:pointer\"], footer a { min-height: 44px; display: flex; align-items: center; }\n    }\n  </style>\n</helmet>\n\n<div style=\"min-height:100vh;display:flex;flex-direction:column;background:var(--paper-warm)\">\n\n  <!-- ═══════════ HEADER ═══════════ -->\n  \n\n  <main style=\"flex:1\">\n\n    <!-- ═══════════ ACCUEIL ═══════════ -->\n    \n\n    <!-- ═══════════ PROGRAMME D'ÉCRITURE · MENTAL LÉGER ═══════════ -->\n    \n\n    <!-- ═══════════ CARNETS D'ÉCRITURE ═══════════ -->\n    \n\n    <!-- ═══════════ CARNETS D'ACTIVITÉS ═══════════ -->\n    \n\n    <!-- ═══════════ LA MÉTHODE ═══════════ -->\n    \n\n    <!-- ═══════════ À PROPOS ═══════════ -->\n    \n\n    <!-- ═══════════ LA NEWSLETTER ═══════════ -->\n    \n\n\n    <!-- ═══════════ LIENS ═══════════ -->\n    <sc-if value=\"{{ isLiens }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Liens\" style=\"min-height:100vh;background:var(--blush);padding:clamp(20px,5vw,56px) clamp(12px,3vw,24px);display:flex;justify-content:center;align-items:flex-start;box-sizing:border-box\">\n        <div style=\"width:100%;max-width:560px;background:var(--paper);border:1px solid var(--border-faint);border-radius:22px;box-shadow:0 4px 24px rgba(101,109,68,0.08);padding:clamp(28px,6vw,48px) clamp(18px,5vw,44px) clamp(28px,6vw,40px);box-sizing:border-box\">\n          <a href=\"/\" style=\"display:block;text-align:center;font-family:var(--font-display);font-size:18px;letter-spacing:0.08em;color:var(--deep-olive);text-decoration:none;margin-bottom:clamp(20px,5vw,28px)\">Papier Pivoine</a>\n          <div style=\"text-align:center;margin-bottom:clamp(24px,6vw,36px)\">\n            <div class=\"pp-eyebrow\" style=\"margin-bottom:14px\">Tous mes carnets</div>\n            <h1 style=\"font-family:var(--font-display);font-weight:400;font-size:clamp(28px,5vw,36px);letter-spacing:0.04em;color:var(--deep-olive);line-height:1.2;margin:0 0 12px\">Mes liens</h1>\n            <p style=\"font-family:var(--font-body);font-size:16px;color:var(--ink-soft);line-height:1.7;margin:0 auto;max-width:40ch\">Tous mes carnets au même endroit. Prends ton temps pour choisir.</p>\n          </div>\n          <div style=\"margin-bottom:32px\">\n            <div class=\"pp-eyebrow\" style=\"margin-bottom:12px\">Collection</div>\n            <h2 style=\"font-family:var(--font-display);font-weight:400;font-size:clamp(22px,4vw,26px);letter-spacing:0.04em;color:var(--deep-olive);line-height:1.25;margin:0 0 6px\">Les saisons tranquilles</h2>\n            <div style=\"display:flex;flex-direction:column;border-bottom:1px solid var(--border-faint)\">\n              <div style=\"display:grid;grid-template-columns:clamp(72px,20vw,96px) minmax(0,1fr);gap:clamp(14px,4vw,20px);align-items:center;padding:20px 0;border-top:1px solid var(--border-faint)\">\n                <img src=\"/assets/cover-cocon-automne.jpg\" alt=\"Couverture du carnet Le cocon d'automne\" loading=\"lazy\" style=\"width:100%;height:auto;display:block;border-radius:4px;box-shadow:0 2px 10px rgba(101,109,68,0.14)\">\n                <div style=\"display:flex;flex-direction:column;gap:8px;min-width:0\">\n                  <div style=\"font-family:var(--font-display);font-size:clamp(17px,4.6vw,19px);letter-spacing:0.03em;color:var(--deep-olive);line-height:1.25;text-wrap:balance\">Le cocon d'automne</div>\n                  <p style=\"font-family:var(--font-body);font-size:14px;color:var(--ink-soft);line-height:1.6;margin:0;text-wrap:pretty\">Écriture, coloriage, jeux et tests pour se poser sans culpabiliser, quand on ressent tout un peu fort.</p>\n                  <div style=\"display:flex;gap:10px;flex-wrap:wrap;margin-top:4px\"><a href=\"https://www.amazon.fr/dp/B0HHLYRWNM\" target=\"_blank\" rel=\"noopener\" style=\"display:flex;align-items:center;justify-content:center;width:100%;box-sizing:border-box;min-height:48px;padding:0 16px;border-radius:999px;background:var(--rose-deep);color:var(--paper);font-family:var(--font-body);font-size:15px;text-decoration:none;-webkit-tap-highlight-color:transparent\">Commander sur Amazon</a></div>\n                </div>\n              </div>\n              <div style=\"display:grid;grid-template-columns:clamp(72px,20vw,96px) minmax(0,1fr);gap:clamp(14px,4vw,20px);align-items:center;padding:20px 0;border-top:1px solid var(--border-faint)\">\n                <img src=\"/assets/cover-cocon-hiver.jpg\" alt=\"Couverture du carnet Mon cocon d'hiver\" loading=\"lazy\" style=\"width:100%;height:auto;display:block;border-radius:4px;box-shadow:0 2px 10px rgba(101,109,68,0.14)\">\n                <div style=\"display:flex;flex-direction:column;gap:8px;min-width:0\">\n                  <div style=\"font-family:var(--font-display);font-size:clamp(17px,4.6vw,19px);letter-spacing:0.03em;color:var(--deep-olive);line-height:1.25;text-wrap:balance\">Mon cocon d'hiver</div>\n                  <p style=\"font-family:var(--font-body);font-size:14px;color:var(--ink-soft);line-height:1.6;margin:0;text-wrap:pretty\">Plus de 90 activités : écriture, coloriages, énigmes et tests de personnalité, avec les solutions.</p>\n                  <div style=\"display:flex;gap:10px;flex-wrap:wrap;margin-top:4px\"><a href=\"https://www.amazon.fr/dp/B0HL6VVS5X\" target=\"_blank\" rel=\"noopener\" style=\"display:flex;align-items:center;justify-content:center;width:100%;box-sizing:border-box;min-height:48px;padding:0 16px;border-radius:999px;background:var(--rose-deep);color:var(--paper);font-family:var(--font-body);font-size:15px;text-decoration:none;-webkit-tap-highlight-color:transparent\">Commander sur Amazon</a></div>\n                </div>\n              </div>\n            </div>\n          </div>\n          \n          <div style=\"margin-bottom:32px\">\n            <div class=\"pp-eyebrow\" style=\"margin-bottom:12px\">Collection</div>\n            <h2 style=\"font-family:var(--font-display);font-weight:400;font-size:clamp(22px,4vw,26px);letter-spacing:0.04em;color:var(--deep-olive);line-height:1.25;margin:0 0 6px\">Batterie faible</h2>\n            <div style=\"display:flex;flex-direction:column;border-bottom:1px solid var(--border-faint)\">\n              <div style=\"display:grid;grid-template-columns:clamp(72px,20vw,96px) minmax(0,1fr);gap:clamp(14px,4vw,20px);align-items:center;padding:20px 0;border-top:1px solid var(--border-faint)\">\n                <img src=\"/assets/cover-et-si.jpg\" alt=\"Couverture du cahier Et si… ?\" loading=\"lazy\" style=\"width:100%;height:auto;display:block;border-radius:4px;box-shadow:0 2px 10px rgba(101,109,68,0.14)\">\n                <div style=\"display:flex;flex-direction:column;gap:8px;min-width:0\">\n                  <div style=\"font-family:var(--font-display);font-size:clamp(17px,4.6vw,19px);letter-spacing:0.03em;color:var(--deep-olive);line-height:1.25;text-wrap:balance\">Et si… ?</div>\n                  <p style=\"font-family:var(--font-body);font-size:14px;color:var(--ink-soft);line-height:1.6;margin:0;text-wrap:pretty\">Jeux, coloriages et exercices pour arrêter de ruminer et retrouver le calme. Pour les femmes qui pensent trop.</p>\n                  <div style=\"display:flex;gap:10px;flex-wrap:wrap;margin-top:4px\"><a href=\"https://www.amazon.fr/dp/B0HL27XDWD\" target=\"_blank\" rel=\"noopener\" style=\"display:flex;align-items:center;justify-content:center;width:100%;box-sizing:border-box;min-height:48px;padding:0 16px;border-radius:999px;background:var(--rose-deep);color:var(--paper);font-family:var(--font-body);font-size:15px;text-decoration:none;-webkit-tap-highlight-color:transparent\">Commander sur Amazon</a></div>\n                </div>\n              </div>\n              <div style=\"display:grid;grid-template-columns:clamp(72px,20vw,96px) minmax(0,1fr);gap:clamp(14px,4vw,20px);align-items:center;padding:20px 0;border-top:1px solid var(--border-faint)\">\n                <div style=\"width:100%;aspect-ratio:2/3;border-radius:4px;background:var(--blush);border:1px solid var(--border-faint)\"></div>\n                <div style=\"display:flex;flex-direction:column;gap:8px;min-width:0\">\n                  <div style=\"font-family:var(--font-display);font-size:clamp(17px,4.6vw,19px);letter-spacing:0.03em;color:var(--deep-olive);line-height:1.25;text-wrap:balance\">Trop sensible, trop fatiguée, trop bien sous mon plaid</div>\n                  <p style=\"font-family:var(--font-body);font-size:14px;color:var(--ink-soft);line-height:1.6;margin:0;text-wrap:pretty\">Le prochain carnet de la collection.</p>\n                  <div style=\"display:flex;gap:10px;flex-wrap:wrap;margin-top:4px\"><span style=\"font-family:var(--font-body);font-size:13px;font-style:italic;color:var(--rose-deep)\">Bientôt disponible</span></div>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div style=\"display:flex;flex-direction:column;gap:12px;margin-top:36px\">\n            <a href=\"/newsletter/\" style=\"display:inline-flex;align-items:center;min-height:44px;padding:0 18px;border-radius:999px;background:var(--rose-deep);color:var(--paper);font-family:var(--font-body);font-size:14px;text-decoration:none;justify-content:center;font-size:15px;min-height:50px\">La newsletter gratuite, avec un cadeau</a>\n            <a href=\"https://fr.pinterest.com/papierpivoine/\" target=\"_blank\" rel=\"noopener\" style=\"display:inline-flex;align-items:center;min-height:44px;padding:0 18px;border-radius:999px;border:1px solid var(--rose-deep);color:var(--rose-deep);font-family:var(--font-body);font-size:14px;text-decoration:none;justify-content:center;font-size:15px;min-height:50px\">Pinterest</a>\n            <a href=\"/\" style=\"display:inline-flex;align-items:center;min-height:44px;padding:0 18px;border-radius:999px;border:1px solid var(--rose-deep);color:var(--rose-deep);font-family:var(--font-body);font-size:14px;text-decoration:none;justify-content:center;font-size:15px;min-height:50px\">Le site Papier Pivoine</a>\n          </div>\n          <div style=\"font-family:var(--font-accent);font-size:32px;line-height:1.1;color:var(--rose);text-align:center;margin-top:40px\">Camélia</div>\n        </div>\n      </div>\n    </sc-if>\n\n    <!-- ═══════════ BAND (toutes pages sauf newsletter) ═══════════ -->\n    <sc-if value=\"{{ showBand }}\" hint-placeholder-val=\"{{ true }}\">\n      <div style=\"background:var(--blush)\">\n        <div style=\"max-width:720px;margin:0 auto;padding:80px min(48px,5vw);text-align:center\">\n          <h2 style=\"font-family:var(--font-display);font-weight:400;font-size:clamp(26px,4.2vw,34px);letter-spacing:0.04em;color:var(--deep-olive);margin:0 0 18px\">Commence par un cadeau</h2>\n          <p style=\"font-family:var(--font-body);font-size:16px;color:var(--ink-soft);line-height:1.7;max-width:52ch;margin:0 auto 30px\">Une fois par mois, je t'écris : le thème de la saison, mes réflexions personnelles, un exercice d'écriture guidé, et des nouvelles de ce que je prépare. Pour t'accueillir, je t'offre la première semaine de Mental Léger, mon programme d'écriture, pour vider ta tête le soir.</p>\n          <p style=\"font-family:var(--font-body);font-size:15px;font-style:italic;color:var(--ink-soft);line-height:1.6;max-width:46ch;margin:0 auto 28px\">« Merci pour tes newsletters qui sont de réelles bouffées d'air frais. » · Virginie</p>\n          <sc-if value=\"{{ notSubscribed }}\" hint-placeholder-val=\"{{ true }}\">\n            <div style=\"display:flex;justify-content:center\">\n              <x-import component-from-global-scope=\"PapierPivoineDesignSystem_2e8f20.Button\" variant=\"primary\" size=\"lg\" onClick=\"{{ subscribe }}\" hint-size=\"200px,52px\">Recevoir le cadeau</x-import>\n            </div>\n            <p style=\"font-family:var(--font-body);font-size:12px;color:var(--ink-faint);margin:16px 0 0\">C'est gratuit. Tu peux te désinscrire quand tu veux. <span onClick=\"{{ goNewsletter }}\" style=\"color:var(--rose);cursor:pointer;text-decoration:underline;text-underline-offset:3px\">Voir ce qu'il y a dedans</span></p>\n          </sc-if>\n          <sc-if value=\"{{ subscribed }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:var(--paper);border:1px solid var(--border-faint);border-radius:14px;padding:28px 32px;max-width:440px;margin:0 auto\">\n              <p style=\"font-family:var(--font-body);font-size:16px;color:var(--deep-olive);line-height:1.6;margin:0 0 6px\">C'est noté. La première semaine de Mental Léger est en route vers ta boîte mail.</p>\n              <p style=\"font-family:var(--font-body);font-size:13px;color:var(--ink-faint);margin:0\">Si tu ne la vois pas, regarde dans les courriers indésirables.</p>\n            </div>\n          </sc-if>\n        </div>\n        <sc-if value=\"{{ saisonAutomne }}\" hint-placeholder-val=\"{{ true }}\"><div style=\"display:flex;justify-content:center;padding:0 min(48px,5vw)\"><img loading=\"lazy\" decoding=\"async\" src=\"/assets/automne/herbes-sechees.webp\" width=\"1000\" height=\"384\" alt=\"\" aria-hidden=\"true\" style=\"display:block;width:min(900px,100%);height:auto\"></div></sc-if>\n      </div>\n    </sc-if>\n\n  </main>\n\n  <a data-formkit-toggle=\"638990c016\" href=\"https://camelianguyen.kit.com/638990c016\" style=\"display:none\" aria-hidden=\"true\">La newsletter</a>\n\n  <!-- ═══════════ FOOTER ═══════════ -->\n  \n\n  <template id=\"__bundler_thumbnail\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 100\"><rect width=\"100\" height=\"100\" fill=\"#F8E7E1\"></rect><text x=\"50\" y=\"60\" text-anchor=\"middle\" font-family=\"Georgia, serif\" font-size=\"26\" letter-spacing=\"2\" fill=\"#C47A78\">PP</text></svg></template>\n\n</div>\n"}
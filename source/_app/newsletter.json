{"tpl":"\n<helmet>\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/colors.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/typography.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/spacing.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/effects.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/base.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/styles.css\">\n  <script src=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/_ds_bundle.js\"></script>\n  <link rel=\"preload\" href=\"/assets/fonts/fraunces-800-latin.woff2\" as=\"font\" type=\"font/woff2\" crossorigin=\"anonymous\">\n  <link rel=\"preload\" href=\"/assets/fonts/nunito-sans-latin.woff2\" as=\"font\" type=\"font/woff2\" crossorigin=\"anonymous\">\n  <style>\n    @font-face { font-family: 'Caveat'; font-style: normal; font-weight: 400 600; font-display: swap; src: url(/assets/fonts/caveat-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Caveat'; font-style: normal; font-weight: 400 600; font-display: swap; src: url(/assets/fonts/caveat-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 300 600; font-display: swap; src: url(/assets/fonts/fraunces-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 300 600; font-display: swap; src: url(/assets/fonts/fraunces-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    @font-face { font-family: 'Nunito Sans'; font-style: normal; font-weight: 300 700; font-display: swap; src: url(/assets/fonts/nunito-sans-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Nunito Sans'; font-style: normal; font-weight: 300 700; font-display: swap; src: url(/assets/fonts/nunito-sans-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    @font-face { font-family: 'Caveat'; font-style: normal; font-weight: 700; font-display: swap; src: url(/assets/fonts/caveat-700-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Caveat'; font-style: normal; font-weight: 700; font-display: swap; src: url(/assets/fonts/caveat-700-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    @font-face { font-family: 'Fraunces'; font-style: italic; font-weight: 700; font-display: swap; src: url(/assets/fonts/fraunces-italic-700-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Fraunces'; font-style: italic; font-weight: 700; font-display: swap; src: url(/assets/fonts/fraunces-italic-700-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 800; font-display: swap; src: url(/assets/fonts/fraunces-800-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 800; font-display: swap; src: url(/assets/fonts/fraunces-800-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    :root {\n      --font-display: 'Fraunces', Georgia, serif;\n      --font-body: 'Nunito Sans', system-ui, sans-serif;\n      --font-accent: 'Caveat', cursive;\n    }\n    /* Saison : automne par défaut (aucun attribut), \"neutre\" = palette d'origine. Réglage : prop season. */\n    /* Palette d'automne : mêmes rôles que la palette d'origine, teintes terre cuite, ocre et olive brun. */\n    html:not([data-season=\"neutre\"]) {\n      --blush: #F7D9D3; --blush-deep: #F0C7BF; --pale-rose: #DDA9A0;\n      --rose: #E26D5F; --rose-deep: #BF5548;\n      --sage: #B2BD88; --sage-soft: #EEF0DE; --olive-soft: #E9ECD9;\n      --deep-olive: #33321E; --ink: #33321E; --ink-soft: #46452F; --ink-faint: #6B6953;\n      --paper: #FFFCFA; --paper-warm: #FCF6F2; --border-faint: #EDE1D6; --sand: #EAD9AC;\n      --text-on-accent: #FFFCFA;\n    }\n    body { margin: 0; background: var(--paper-warm, #FCF6F2); }\n    a { color: var(--rose-deep); }\n    a:hover { color: var(--ink); }\n    mark { -webkit-box-decoration-break: clone; box-decoration-break: clone; }\n    ::selection { background: var(--blush); }\n    /* Pop-up Kit : autoriser le défilement sur mobile (leur fenêtre dépasse l'écran) */\n    @media (max-width: 700px) {\n      .formkit-overlay, .formkit-modal { overflow-y: auto !important; -webkit-overflow-scrolling: touch !important; align-items: flex-start !important; }\n      .formkit-modal { max-height: 100dvh !important; }\n      .formkit-modal .formkit-form, .formkit-modal > div { max-height: none !important; }\n    }\n    /* Navigation : liens en ligne sur ordinateur, menu replié sur mobile */\n    .pp-burger { display: none; }\n    @media (max-width: 700px) {\n      .pp-nav-desktop { display: none !important; }\n      .pp-burger { display: inline-flex !important; }\n    }\n    @media (min-width: 701px) {\n      .pp-nav-mobile { display: none !important; }\n    }\n    /* Mobile : zones cliquables d'au moins 44 px */\n    @media (max-width: 700px) {\n      .pp-nav-mobile > span, .pp-nav-mobile > * > span { min-height: 44px; display: flex; align-items: center; box-sizing: border-box; }\n      header > span:first-child { min-height: 44px; display: inline-flex; align-items: center; }\n      main button, footer button { min-height: 44px; }\n      footer [style*=\"cursor: pointer\"], footer [style*=\"cursor:pointer\"], footer a { min-height: 44px; display: flex; align-items: center; }\n    }\n  </style>\n</helmet>\n\n<div style=\"min-height:100vh;display:flex;flex-direction:column;background:var(--paper-warm)\">\n\n  <!-- ═══════════ HEADER ═══════════ -->\n  <sc-if value=\"{{ showChrome }}\" hint-placeholder-val=\"{{ true }}\">\n  <header style=\"display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px 24px;padding:18px min(48px,5vw);border-bottom:1px solid var(--border-faint);background:var(--paper-warm);position:sticky;top:0;z-index:10\">\n    <span onClick=\"{{ goAccueil }}\" style=\"cursor:pointer;display:inline-flex;align-items:center;gap:10px;font-family:var(--font-display);font-weight:800;font-variation-settings:'opsz' 72;font-size:23px;color:var(--deep-olive);letter-spacing:-0.005em\"><img src=\"/assets/logo-papier-pivoine.jpg\" width=\"400\" height=\"400\" alt=\"\" aria-hidden=\"true\" style=\"display:block;width:40px;height:40px;border-radius:50%;border:2px solid var(--ink);box-sizing:border-box;flex:none\">Papier Pivoine</span>\n    <span class=\"pp-burger\" onClick=\"{{ toggleMenu }}\" role=\"button\" aria-label=\"Menu\" style=\"display:none;align-items:center;justify-content:center;width:44px;height:44px;margin:-8px -10px;cursor:pointer\">\n      <sc-if value=\"{{ menuClosed }}\" hint-placeholder-val=\"{{ true }}\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--deep-olive)\" stroke-width=\"1.4\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M3 8h18\"></path><path d=\"M3 16h18\"></path></svg></sc-if>\n      <sc-if value=\"{{ menuOpen }}\" hint-placeholder-val=\"{{ false }}\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--deep-olive)\" stroke-width=\"1.4\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M6 6l12 12\"></path><path d=\"M18 6L6 18\"></path></svg></sc-if>\n    </span>\n    <nav class=\"pp-nav-desktop\" style=\"display:flex;gap:6px 24px;align-items:center;flex-wrap:wrap\">\n      <span onClick=\"{{ goAccueil }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCAccueil }};border-bottom:1px solid {{ navUAccueil }}\">Accueil</span>\n      \n      <span onClick=\"{{ goActivites }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCActivites }};border-bottom:1px solid {{ navUActivites }}\">Saisons tranquilles</span>\n      <span onClick=\"{{ goProgramme }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCProgramme }};border-bottom:1px solid {{ navUProgramme }}\">Batterie faible</span>\n      <span onClick=\"{{ goMethode }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCMethode }};border-bottom:1px solid {{ navUMethode }}\">7 permissions PIVOINE</span>\n      <span onClick=\"{{ goApropos }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCApropos }};border-bottom:1px solid {{ navUApropos }}\">À propos</span>\n      <span onClick=\"{{ goNewsletter }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCNewsletter }};border-bottom:1px solid {{ navUNewsletter }}\">Newsletter</span>\n    </nav>\n    <sc-if value=\"{{ menuOpen }}\" hint-placeholder-val=\"{{ false }}\">\n      <nav class=\"pp-nav-mobile\" style=\"flex-basis:100%;display:flex;flex-direction:column;padding:2px 0 8px\">\n        <span onClick=\"{{ goAccueil }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCAccueil }};border-top:1px solid var(--border-faint)\">Accueil</span>\n        \n        <span onClick=\"{{ goActivites }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCActivites }};border-top:1px solid var(--border-faint)\">Saisons tranquilles</span>\n        <span onClick=\"{{ goProgramme }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCProgramme }};border-top:1px solid var(--border-faint)\">Batterie faible</span>\n        <span onClick=\"{{ goMethode }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCMethode }};border-top:1px solid var(--border-faint)\">7 permissions PIVOINE</span>\n        <span onClick=\"{{ goApropos }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCApropos }};border-top:1px solid var(--border-faint)\">À propos</span>\n        <span onClick=\"{{ goNewsletter }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCNewsletter }};border-top:1px solid var(--border-faint)\">Newsletter</span>\n      </nav>\n    </sc-if>\n  </header>\n  </sc-if>\n\n  <main style=\"flex:1\">\n\n    <!-- ═══════════ ACCUEIL ═══════════ -->\n    \n\n    <!-- ═══════════ COLLECTION BATTERIE FAIBLE (route /programme/) ═══════════ -->\n    \n\n    <!-- ═══════════ CARNETS D'ÉCRITURE ═══════════ -->\n    \n\n    <!-- ═══════════ COLLECTION SAISONS TRANQUILLES (route /saisons-tranquilles/) ═══════════ -->\n    \n\n    <!-- ═══════════ 7 PERMISSIONS PIVOINE ═══════════ -->\n    \n\n    <!-- ═══════════ À PROPOS ═══════════ -->\n    \n\n    <!-- ═══════════ NEWSLETTER ═══════════ -->\n    <sc-if value=\"{{ isNewsletter }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Newsletter\">\n\n        <div style=\"padding:clamp(56px,9vw,88px) min(48px,5vw) 64px;background-color:#FCF6F2;background-image:radial-gradient(#E9DCCB 1.6px, transparent 1.8px);background-size:32px 32px;text-align:center\">\n          <sc-if value=\"{{ saisonAutomne }}\" hint-placeholder-val=\"{{ true }}\"><div style=\"display:flex;justify-content:center;margin-bottom:24px\"><img src=\"/assets/automne/the-carnet-fleurs.webp\" width=\"680\" height=\"327\" alt=\"Un carnet ouvert, une tasse de thé fumante et une petite fleur\" style=\"display:block;width:min(340px,74vw);height:auto\"></div></sc-if>\n          <div class=\"pp-eyebrow\" style=\"margin-bottom:20px\">Newsletter gratuite</div>\n          <h1 style=\"font-family:var(--font-display);font-weight:800;font-variation-settings:'opsz' 72;letter-spacing:-0.005em;line-height:1.08;font-size:clamp(36px,6vw,54px);color:var(--deep-olive);max-width:22ch;margin:0 auto 22px\">Une lettre, <mark style=\"background:linear-gradient(transparent 55%, #EAD9AC 55%, #EAD9AC 92%, transparent 92%);color:inherit;padding:0 6px\">une fois par mois</mark>.</h1>\n          <p style=\"font-family:var(--font-body);font-size:clamp(18px,2.2vw,19px);color:var(--ink-soft);line-height:1.6;max-width:46ch;margin:0 auto\">Une lettre douce, envoyée le premier dimanche du mois. C’est gratuit, et tu peux te désinscrire quand tu veux.</p>\n          <div style=\"font-family:var(--font-accent);font-weight:700;font-size:26px;line-height:1.2;color:var(--rose-deep);transform:rotate(-2deg);margin:18px 0 0\">(une seule lettre, promis)</div>\n        </div>\n\n        <div style=\"background:var(--paper);border-top:1px solid var(--border-faint);border-bottom:1px solid var(--border-faint);padding:76px min(48px,5vw)\">\n          <div style=\"max-width:560px;margin:0 auto\">\n            <h2 style=\"font-family:var(--font-display);font-weight:800;font-variation-settings:'opsz' 72;letter-spacing:-0.005em;line-height:1.08;font-size:clamp(28px,4.2vw,36px);color:var(--deep-olive);text-align:center;margin:0 0 40px\">Dedans, chaque mois</h2>\n            <div style=\"display:flex;flex-direction:column\">\n              <div style=\"padding:20px 0;border-top:1px solid var(--border-faint)\">\n                <div style=\"font-family:var(--font-body);font-size:19px;font-weight:700;color:var(--deep-olive);margin-bottom:6px\">Le thème du mois</div>\n                <p style=\"font-family:var(--font-body);font-size:18px;color:var(--ink-soft);line-height:1.6;margin:0\">Une saison, une humeur, un fil qui traverse toute la lettre.</p>\n              </div>\n              <div style=\"padding:20px 0;border-top:1px solid var(--border-faint)\">\n                <div style=\"font-family:var(--font-body);font-size:19px;font-weight:700;color:var(--deep-olive);margin-bottom:6px\">Mes réflexions personnelles</div>\n                <p style=\"font-family:var(--font-body);font-size:18px;color:var(--ink-soft);line-height:1.6;margin:0\">Ce que le mois m’a fait : les jours lourds comme les bons moments.</p>\n              </div>\n              <div style=\"padding:20px 0;border-top:1px solid var(--border-faint)\">\n                <div style=\"font-family:var(--font-body);font-size:19px;font-weight:700;color:var(--deep-olive);margin-bottom:6px\">Un exercice d’écriture guidé</div>\n                <p style=\"font-family:var(--font-body);font-size:18px;color:var(--ink-soft);line-height:1.6;margin:0\">Une question douce, dix minutes, une page.</p>\n              </div>\n              <div style=\"padding:20px 0;border-top:1px solid var(--border-faint);border-bottom:1px solid var(--border-faint)\">\n                <div style=\"font-family:var(--font-body);font-size:19px;font-weight:700;color:var(--deep-olive);margin-bottom:6px\">Mes nouveautés</div>\n                <p style=\"font-family:var(--font-body);font-size:18px;color:var(--ink-soft);line-height:1.6;margin:0\">Les cahiers qui viennent de sortir, en premier, et ce que je prépare.</p>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div style=\"background:var(--paper);border-top:1px solid var(--border-faint);padding:76px min(48px,5vw)\">\n          <div style=\"max-width:1080px;margin:0 auto\">\n            <div class=\"pp-eyebrow\" style=\"display:block;text-align:center;margin-bottom:44px\">Ce qu’elles en disent</div>\n            <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:36px;align-items:start\">\n              <div style=\"border-top:1px solid var(--sage);padding-top:20px\">\n                <p style=\"font-family:var(--font-body);font-size:18px;color:var(--ink-soft);line-height:1.6;margin:0 0 16px\">Camélia, ta lettre du mardi est devenue un véritable rendez-vous précieux pour moi. Le travail d’écriture que tu proposes m’apporte énormément dans mon quotidien. Grâce à tes exercices j’apprends à me poser, à réfléchir différemment et à mieux comprendre ce que je ressens. J’avance petit à petit, à mon rythme, et je sens une vraie évolution. Merci pour la douceur, la profondeur et la constance que tu mets dans chacun de tes envois. ☺️✨✨</p>\n                <div style=\"font-family:var(--font-accent);font-size:21px;line-height:1.2;color:var(--rose-deep)\">- Véronique</div>\n              </div>\n              <div style=\"border-top:1px solid var(--sage);padding-top:20px\">\n                <p style=\"font-family:var(--font-body);font-size:18px;color:var(--ink-soft);line-height:1.6;margin:0 0 16px\">Merci pour tes newsletters qui sont de réelles bouffées d’air frais. J’aimais déjà écrire et je tenais mon journal de pensée mais là c’est encore mieux avec les sujets que tu abordes. Merci du fond du cœur.</p>\n                <div style=\"font-family:var(--font-accent);font-size:21px;line-height:1.2;color:var(--rose-deep)\">- Virginie</div>\n              </div>\n              <div style=\"border-top:1px solid var(--sage);padding-top:20px\">\n                <p style=\"font-family:var(--font-body);font-size:18px;color:var(--ink-soft);line-height:1.6;margin:0 0 16px\">J’adore vraiment vos mails et vos écrits, j’en ai déjà réalisé plusieurs et avec un retour en arrière sur mes écrits cela m’a permis de réaliser beaucoup de choses.</p>\n                <div style=\"font-family:var(--font-accent);font-size:21px;line-height:1.2;color:var(--rose-deep)\">- Nathalie</div>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div style=\"background:var(--blush)\">\n          <div style=\"max-width:720px;margin:0 auto;padding:80px min(48px,5vw);text-align:center\">\n            <div class=\"pp-eyebrow\" style=\"margin-bottom:16px\">Le cadeau de bienvenue</div>\n            <h2 style=\"font-family:var(--font-display);font-weight:800;font-variation-settings:'opsz' 72;letter-spacing:-0.005em;line-height:1.08;font-size:clamp(30px,4.6vw,40px);color:var(--deep-olive);margin:0 0 18px\">La première semaine de <mark style=\"background:linear-gradient(transparent 55%, #EAD9AC 55%, #EAD9AC 92%, transparent 92%);color:inherit;padding:0 6px\">Mental Léger</mark></h2>\n            <p style=\"font-family:var(--font-body);font-size:18px;color:var(--ink-soft);line-height:1.6;max-width:50ch;margin:0 auto 30px\">Pour t’accueillir, je t’offre le début de Mental Léger, mon programme d’écriture : la semaine pour t’installer, puis cinq jours pour vider ta tête le soir. Vingt-deux pages, à imprimer ou à remplir à l’écran. C’est à toi, à garder.</p>\n            <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:18px;max-width:640px;margin:0 auto 36px\">\n              <div style=\"aspect-ratio:210/297;background:var(--paper);border:1px solid var(--border-faint);border-radius:6px;box-shadow:0 2px 12px rgba(101,109,68,0.10);overflow:hidden\">\n                <img src=\"/assets/freebie-ml-cover.jpg\" width=\"551\" height=\"780\" alt=\"Mental Léger, la couverture du carnet\" style=\"width:100%;height:100%;object-fit:cover;display:block\">\n              </div>\n              <div style=\"aspect-ratio:210/297;background:var(--paper);border:1px solid var(--border-faint);border-radius:6px;box-shadow:0 2px 12px rgba(101,109,68,0.10);overflow:hidden\">\n                <img src=\"/assets/freebie-ml-coin.jpg\" width=\"552\" height=\"780\" loading=\"lazy\" alt=\"Une page : mon coin d’écriture\" style=\"width:100%;height:100%;object-fit:cover;display:block\">\n              </div>\n              <div style=\"aspect-ratio:210/297;background:var(--paper);border:1px solid var(--border-faint);border-radius:6px;box-shadow:0 2px 12px rgba(101,109,68,0.10);overflow:hidden\">\n                <img src=\"/assets/freebie-ml-vidage.jpg\" width=\"552\" height=\"780\" loading=\"lazy\" alt=\"Une page : le vidage, premier jour\" style=\"width:100%;height:100%;object-fit:cover;display:block\">\n              </div>\n            </div>\n            <sc-if value=\"{{ notSubscribed }}\" hint-placeholder-val=\"{{ true }}\">\n              <div style=\"display:flex;justify-content:center\">\n                <button type=\"button\" onClick=\"{{ subscribe }}\" style=\"display:inline-flex;align-items:center;justify-content:center;gap:10px;box-sizing:border-box;max-width:100%;text-align:center;padding:8px 26px 10px;border:3px solid var(--rose);border-radius:999px;color:var(--rose);font-family:var(--font-accent);font-weight:700;font-size:30px;line-height:1.1;transform:rotate(-2deg);background:transparent;cursor:pointer;text-decoration:none;transition:background-color 200ms ease,color 200ms ease\" style-hover=\"background:var(--rose);color:var(--paper-warm)\" style-focus=\"outline:2px solid var(--ink);outline-offset:4px\">Recevoir la première semaine</button>\n              </div>\n              <p style=\"font-family:var(--font-body);font-size:12px;color:var(--ink-faint);margin:16px 0 0\">Gratuit. Ton adresse ne sert qu’à la newsletter, rien d’autre.</p>\n            </sc-if>\n            <sc-if value=\"{{ subscribed }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"background:var(--paper);border:1px solid var(--border-faint);border-radius:14px;padding:28px 32px;max-width:440px;margin:0 auto\">\n                <p style=\"font-family:var(--font-body);font-size:18px;color:var(--deep-olive);line-height:1.6;margin:0 0 6px\">C’est noté. La première semaine de Mental Léger est en route vers ta boîte mail.</p>\n                <p style=\"font-family:var(--font-body);font-size:13px;color:var(--ink-faint);margin:0\">Si tu ne la vois pas, regarde dans les courriers indésirables.</p>\n              </div>\n            </sc-if>\n          </div>\n        </div>\n\n        <div style=\"padding:84px min(48px,5vw);display:flex;flex-direction:column;align-items:center\">\n          <div class=\"pp-eyebrow\" style=\"margin-bottom:28px\">Un extrait · Papier Pivoine n° 88, juillet</div>\n          <x-import component-from-global-scope=\"PapierPivoineDesignSystem_2e8f20.LetterBlock\" align=\"center\" signature=\"\" hint-size=\"560px,300px\">\n            <p style=\"margin:0 0 1.2em\">Le thème de juillet, c’est l’école buissonnière. Ce petit pincement qu’on a parfois, quand la vie s’est refermée autour du travail et des responsabilités, et qu’une pensée traverse l’esprit sans prévenir : est-ce vraiment tout ?</p>\n            <p style=\"margin:0 0 1.2em\">On ne va pas creuser ça sérieusement ce mois-ci. On va plutôt jouer avec l’idée, inventer d’autres vies possibles, sans obligation d’y croire. C’est une pause faite exprès pour rester légère.</p>\n            <p style=\"margin:0\">L’exercice de juillet : une carte postale d’une autre vie.</p>\n            <div style=\"margin-top:22px;font-family:var(--font-accent);font-size:34px;line-height:1.1;color:var(--rose)\">Camélia</div>\n          </x-import>\n        </div>\n\n\n\n      </div>\n    </sc-if>\n\n\n    <!-- ═══════════ LIENS ═══════════ -->\n    \n\n    <!-- ═══════════ BAND (toutes pages sauf newsletter) ═══════════ -->\n    <sc-if value=\"{{ showBand }}\" hint-placeholder-val=\"{{ true }}\">\n      <div style=\"background:var(--blush)\">\n        <div style=\"max-width:720px;margin:0 auto;padding:80px min(48px,5vw);text-align:center\">\n          <h2 style=\"font-family:var(--font-display);font-weight:800;font-variation-settings:'opsz' 72;letter-spacing:-0.005em;line-height:1.08;font-size:clamp(30px,4.6vw,40px);color:var(--deep-olive);margin:0 0 18px\">Commence par <mark style=\"background:linear-gradient(transparent 55%, #EAD9AC 55%, #EAD9AC 92%, transparent 92%);color:inherit;padding:0 6px\">un cadeau</mark></h2>\n          <p style=\"font-family:var(--font-body);font-size:18px;color:var(--ink-soft);line-height:1.6;max-width:52ch;margin:0 auto 30px\">Une fois par mois, je t’écris : le thème de la saison, mes réflexions, un exercice d’écriture guidé, et les nouveaux cahiers en premier. Pour t’accueillir, je t’offre la première semaine de Mental Léger, pour vider ta tête le soir.</p>\n          <p style=\"font-family:var(--font-body);font-size:17px;font-style:italic;color:var(--ink-soft);line-height:1.6;max-width:46ch;margin:0 auto 28px\">« Merci pour tes newsletters qui sont de réelles bouffées d’air frais. » · Virginie</p>\n          <sc-if value=\"{{ notSubscribed }}\" hint-placeholder-val=\"{{ true }}\">\n            <div style=\"display:flex;justify-content:center\">\n              <button type=\"button\" onClick=\"{{ subscribe }}\" style=\"display:inline-flex;align-items:center;justify-content:center;gap:10px;box-sizing:border-box;max-width:100%;text-align:center;padding:8px 26px 10px;border:3px solid var(--rose);border-radius:999px;color:var(--rose);font-family:var(--font-accent);font-weight:700;font-size:30px;line-height:1.1;transform:rotate(-2deg);background:transparent;cursor:pointer;text-decoration:none;transition:background-color 200ms ease,color 200ms ease\" style-hover=\"background:var(--rose);color:var(--paper-warm)\" style-focus=\"outline:2px solid var(--ink);outline-offset:4px\">Recevoir le cadeau</button>\n            </div>\n            <p style=\"font-family:var(--font-body);font-size:12px;color:var(--ink-faint);margin:16px 0 0\">C’est gratuit. Tu peux te désinscrire quand tu veux. <span onClick=\"{{ goNewsletter }}\" style=\"color:var(--rose);cursor:pointer;text-decoration:underline;text-underline-offset:3px\">Voir ce qu’il y a dedans</span></p>\n          </sc-if>\n          <sc-if value=\"{{ subscribed }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:var(--paper);border:1px solid var(--border-faint);border-radius:14px;padding:28px 32px;max-width:440px;margin:0 auto\">\n              <p style=\"font-family:var(--font-body);font-size:18px;color:var(--deep-olive);line-height:1.6;margin:0 0 6px\">C’est noté. La première semaine de Mental Léger est en route vers ta boîte mail.</p>\n              <p style=\"font-family:var(--font-body);font-size:13px;color:var(--ink-faint);margin:0\">Si tu ne la vois pas, regarde dans les courriers indésirables.</p>\n            </div>\n          </sc-if>\n        </div>\n        <sc-if value=\"{{ saisonAutomne }}\" hint-placeholder-val=\"{{ true }}\"><div style=\"display:flex;justify-content:center;padding:0 min(48px,5vw)\"><img loading=\"lazy\" decoding=\"async\" src=\"/assets/automne/herbes-sechees.webp\" width=\"1000\" height=\"384\" alt=\"Une rangée d’herbes séchées et de fleurs des champs\" style=\"display:block;width:min(900px,100%);height:auto\"></div></sc-if>\n      </div>\n    </sc-if>\n\n  </main>\n\n  <a data-formkit-toggle=\"638990c016\" href=\"https://camelianguyen.kit.com/638990c016\" style=\"display:none\" aria-hidden=\"true\">La newsletter</a>\n\n  <!-- ═══════════ FOOTER ═══════════ -->\n  <sc-if value=\"{{ showChrome }}\" hint-placeholder-val=\"{{ true }}\">\n  <footer style=\"background:var(--paper-warm);border-top:1px solid var(--border-faint);padding:56px min(48px,5vw) 40px\">\n    <div style=\"max-width:1180px;margin:0 auto\">\n      <div style=\"display:flex;justify-content:space-between;align-items:flex-start;gap:32px;flex-wrap:wrap\">\n        <div>\n          <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:8px\"><span style=\"font-family:var(--font-display);font-weight:800;font-variation-settings:'opsz' 72;font-size:21px;color:var(--deep-olive);letter-spacing:-0.005em\">Papier Pivoine</span><svg width=\"30\" height=\"30\" viewBox=\"0 0 120 120\" fill=\"none\" stroke=\"#E26D5F\" stroke-width=\"3.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M62.7,49.8 C66.1,48.3 73.1,61.7 69.5,62.6 C71.8,66.2 60.0,73.3 57.4,69.7 C53.2,71.8 46.4,60.3 50.3,57.4 C49.8,53.3 61.7,47.9 62.7,51.8 M57.1,43.6 C46.3,12.7 80.5,14.0 65.0,44.5 M69.6,46.7 C81.8,18.7 103.5,44.8 74.8,52.4 M77.3,59.3 C107.0,50.6 98.2,86.2 75.1,67.9 M71.5,72.6 C98.7,90.0 68.7,109.6 64.6,76.1 M56.0,75.8 C55.5,106.4 22.2,90.6 49.0,71.4 M46.0,67.6 C19.3,88.3 11.6,52.1 44.5,60.0 M44.9,52.5 C15.6,45.7 36.2,19.9 49.7,47.0\"></path></svg></div>\n          <p style=\"font-family:var(--font-body);font-style:italic;color:var(--rose-deep);margin:0;font-size:15px;max-width:32ch;line-height:1.5\">Trop sensible, trop fatiguée, trop bien sous mon plaid.</p>\n        </div>\n        <div style=\"display:flex;gap:40px 64px;flex-wrap:wrap\">\n          <div>\n            <div class=\"pp-eyebrow\" style=\"margin-bottom:14px\">Découvrir</div>\n            <div style=\"display:flex;flex-direction:column;gap:9px;font-family:var(--font-body);font-size:14px;color:var(--ink-soft)\">\n              <span onClick=\"{{ goActivites }}\" style=\"cursor:pointer\">Saisons tranquilles</span>\n              <span onClick=\"{{ goProgramme }}\" style=\"cursor:pointer\">Batterie faible</span>\n              <span onClick=\"{{ goMethode }}\" style=\"cursor:pointer\">7 permissions PIVOINE</span>\n              <span onClick=\"{{ goApropos }}\" style=\"cursor:pointer\">À propos</span>\n            </div>\n          </div>\n          <div>\n            <div class=\"pp-eyebrow\" style=\"margin-bottom:14px\">Rester en lien</div>\n            <div style=\"display:flex;flex-direction:column;gap:9px;font-family:var(--font-body);font-size:14px;color:var(--ink-soft)\">\n              <span onClick=\"{{ goNewsletter }}\" style=\"cursor:pointer\">Newsletter gratuite</span>\n              <a href=\"https://fr.pinterest.com/papierpivoine/\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--ink-soft);text-decoration:none\">Pinterest</a>\n              <a href=\"https://www.youtube.com/channel/UCGXAZmmLaKEP6ll7voftuNQ\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--ink-soft);text-decoration:none\">YouTube</a>\n              <a href=\"https://www.tiktok.com/@papierpivoine\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--ink-soft);text-decoration:none\">TikTok</a>\n              <a href=\"https://www.instagram.com/papierpivoine/\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--ink-soft);text-decoration:none\">Instagram</a>\n              <a href=\"https://www.facebook.com/share/1Bue8nqYmf/?mibextid=wwXIfr\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--ink-soft);text-decoration:none\">Facebook</a>\n              <a href=\"https://www.threads.com/@papierpivoine?igshid=NTc4MTIwNjQ2YQ==\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--ink-soft);text-decoration:none\">Threads</a>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div style=\"height:1px;background:var(--border-faint);margin:36px 0\"></div>\n      <p style=\"font-family:var(--font-body);font-size:12px;color:var(--ink-faint);margin:0 0 8px;max-width:70ch;line-height:1.6\">Ce que tu trouves ici est une pratique douce, pas un soin. Ce n’est pas un substitut à un accompagnement professionnel. Si tu traverses une période difficile, parles-en à un professionnel de santé.</p>\n      <p style=\"font-family:var(--font-body);font-size:12px;color:var(--ink-faint);margin:0\">© 2026 Papier Pivoine · Camélia Nguyen</p>\n    </div>\n  </footer>\n  </sc-if>\n\n  <template id=\"__bundler_thumbnail\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 100\"><rect width=\"100\" height=\"100\" fill=\"#F8E7E1\"></rect><text x=\"50\" y=\"60\" text-anchor=\"middle\" font-family=\"Georgia, serif\" font-size=\"26\" letter-spacing=\"2\" fill=\"#C47A78\">PP</text></svg></template>\n\n</div>\n"}
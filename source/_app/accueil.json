{"tpl":"\n<helmet>\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/colors.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/typography.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/spacing.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/effects.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/base.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/styles.css\">\n  <script src=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/_ds_bundle.js\"></script>\n  <link rel=\"preload\" href=\"/assets/fonts/fraunces-latin.woff2\" as=\"font\" type=\"font/woff2\" crossorigin=\"anonymous\">\n  <link rel=\"preload\" href=\"/assets/fonts/nunito-sans-latin.woff2\" as=\"font\" type=\"font/woff2\" crossorigin=\"anonymous\">\n  <style>\n    @font-face { font-family: 'Caveat'; font-style: normal; font-weight: 400 600; font-display: swap; src: url(/assets/fonts/caveat-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Caveat'; font-style: normal; font-weight: 400 600; font-display: swap; src: url(/assets/fonts/caveat-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 300 600; font-display: swap; src: url(/assets/fonts/fraunces-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 300 600; font-display: swap; src: url(/assets/fonts/fraunces-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    @font-face { font-family: 'Nunito Sans'; font-style: normal; font-weight: 300 700; font-display: swap; src: url(/assets/fonts/nunito-sans-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Nunito Sans'; font-style: normal; font-weight: 300 700; font-display: swap; src: url(/assets/fonts/nunito-sans-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    :root {\n      --font-display: 'Fraunces', Georgia, serif;\n      --font-body: 'Nunito Sans', system-ui, sans-serif;\n      --font-accent: 'Caveat', cursive;\n    }\n    /* Saison : automne par défaut (aucun attribut), \"neutre\" = palette d'origine. Réglage : prop season. */\n    /* Palette d'automne : mêmes rôles que la palette d'origine, teintes terre cuite, ocre et olive brun. */\n    html:not([data-season=\"neutre\"]) {\n      --blush: #F6E6D6; --blush-deep: #EFD3BD; --pale-rose: #E8C3A4;\n      --rose: #A85A3E; --rose-deep: #8C4630;\n      --sage: #B9A56A; --sage-soft: #F1DCC6; --olive-soft: #E8E0CB;\n      --deep-olive: #5C5431;\n      --paper: #FFFCF8; --paper-warm: #FAF1E8; --border-faint: #E9D9C8;\n    }\n    body { margin: 0; background: var(--paper-warm, #FCF6F2); }\n    a { color: var(--rose); }\n    a:hover { color: var(--rose-deep); }\n    ::selection { background: var(--blush); }\n    /* Pop-up Kit : autoriser le défilement sur mobile (leur fenêtre dépasse l'écran) */\n    @media (max-width: 700px) {\n      .formkit-overlay, .formkit-modal { overflow-y: auto !important; -webkit-overflow-scrolling: touch !important; align-items: flex-start !important; }\n      .formkit-modal { max-height: 100dvh !important; }\n      .formkit-modal .formkit-form, .formkit-modal > div { max-height: none !important; }\n    }\n    /* Navigation : liens en ligne sur ordinateur, menu replié sur mobile */\n    .pp-burger { display: none; }\n    @media (max-width: 700px) {\n      .pp-nav-desktop { display: none !important; }\n      .pp-burger { display: inline-flex !important; }\n    }\n    @media (min-width: 701px) {\n      .pp-nav-mobile { display: none !important; }\n    }\n    /* Mobile : zones cliquables d'au moins 44 px */\n    @media (max-width: 700px) {\n      .pp-nav-mobile > span, .pp-nav-mobile > * > span { min-height: 44px; display: flex; align-items: center; box-sizing: border-box; }\n      header > span:first-child { min-height: 44px; display: inline-flex; align-items: center; }\n      main button, footer button { min-height: 44px; }\n      footer [style*=\"cursor: pointer\"], footer [style*=\"cursor:pointer\"], footer a { min-height: 44px; display: flex; align-items: center; }\n    }\n  </style>\n</helmet>\n\n<div style=\"min-height:100vh;display:flex;flex-direction:column;background:var(--paper-warm)\">\n\n  <!-- ═══════════ HEADER ═══════════ -->\n  <sc-if value=\"{{ showChrome }}\" hint-placeholder-val=\"{{ true }}\">\n  <header style=\"display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px 24px;padding:18px min(48px,5vw);border-bottom:1px solid var(--border-faint);background:var(--paper-warm);position:sticky;top:0;z-index:10\">\n    <span onClick=\"{{ goAccueil }}\" style=\"cursor:pointer;font-family:var(--font-display);font-size:22px;color:var(--deep-olive);letter-spacing:0.06em\">Papier Pivoine</span>\n    <span class=\"pp-burger\" onClick=\"{{ toggleMenu }}\" role=\"button\" aria-label=\"Menu\" style=\"display:none;align-items:center;justify-content:center;width:44px;height:44px;margin:-8px -10px;cursor:pointer\">\n      <sc-if value=\"{{ menuClosed }}\" hint-placeholder-val=\"{{ true }}\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--deep-olive)\" stroke-width=\"1.4\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M3 8h18\"></path><path d=\"M3 16h18\"></path></svg></sc-if>\n      <sc-if value=\"{{ menuOpen }}\" hint-placeholder-val=\"{{ false }}\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--deep-olive)\" stroke-width=\"1.4\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M6 6l12 12\"></path><path d=\"M18 6L6 18\"></path></svg></sc-if>\n    </span>\n    <nav class=\"pp-nav-desktop\" style=\"display:flex;gap:6px 24px;align-items:center;flex-wrap:wrap\">\n      <span onClick=\"{{ goAccueil }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCAccueil }};border-bottom:1px solid {{ navUAccueil }}\">Accueil</span>\n      \n      <span onClick=\"{{ goActivites }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCActivites }};border-bottom:1px solid {{ navUActivites }}\">Les saisons tranquilles</span>\n      <span onClick=\"{{ goProgramme }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCProgramme }};border-bottom:1px solid {{ navUProgramme }}\">Batterie faible</span>\n      <span onClick=\"{{ goMethode }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCMethode }};border-bottom:1px solid {{ navUMethode }}\">La méthode</span>\n      <span onClick=\"{{ goApropos }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCApropos }};border-bottom:1px solid {{ navUApropos }}\">À propos</span>\n      <span onClick=\"{{ goNewsletter }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCNewsletter }};border-bottom:1px solid {{ navUNewsletter }}\">La newsletter</span>\n    </nav>\n    <sc-if value=\"{{ menuOpen }}\" hint-placeholder-val=\"{{ false }}\">\n      <nav class=\"pp-nav-mobile\" style=\"flex-basis:100%;display:flex;flex-direction:column;padding:2px 0 8px\">\n        <span onClick=\"{{ goAccueil }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCAccueil }};border-top:1px solid var(--border-faint)\">Accueil</span>\n        \n        <span onClick=\"{{ goActivites }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCActivites }};border-top:1px solid var(--border-faint)\">Les saisons tranquilles</span>\n        <span onClick=\"{{ goProgramme }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCProgramme }};border-top:1px solid var(--border-faint)\">Batterie faible</span>\n        <span onClick=\"{{ goMethode }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCMethode }};border-top:1px solid var(--border-faint)\">La méthode</span>\n        <span onClick=\"{{ goApropos }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCApropos }};border-top:1px solid var(--border-faint)\">À propos</span>\n        <span onClick=\"{{ goNewsletter }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCNewsletter }};border-top:1px solid var(--border-faint)\">La newsletter</span>\n      </nav>\n    </sc-if>\n  </header>\n  </sc-if>\n\n  <main style=\"flex:1\">\n\n    <!-- ═══════════ ACCUEIL ═══════════ -->\n    <sc-if value=\"{{ isAccueil }}\" hint-placeholder-val=\"{{ true }}\">\n      <div data-screen-label=\"Accueil\">\n\n        <div style=\"padding:clamp(56px,10vw,104px) min(48px,5vw) clamp(56px,8vw,84px);display:flex;flex-direction:column;align-items:center;text-align:center\">\n          <sc-if value=\"{{ saisonAutomne }}\" hint-placeholder-val=\"{{ true }}\"><img src=\"/assets/automne/canape-bao.webp\" width=\"720\" height=\"487\" alt=\"\" aria-hidden=\"true\" style=\"display:block;width:min(400px,80vw);height:auto;margin-bottom:26px\"></sc-if>\n          <div class=\"pp-eyebrow\" style=\"margin-bottom:22px\">Cahiers d'activités cocooning</div>\n          <h1 style=\"font-family:var(--font-display);font-weight:400;font-size:clamp(32px,6vw,50px);line-height:1.14;letter-spacing:0.04em;color:var(--deep-olive);max-width:20ch;margin:0 0 26px;text-wrap:balance\">Trop sensible, trop fatiguée, trop bien sous mon plaid.</h1>\n          <p style=\"font-family:var(--font-body);font-size:clamp(17px,2.6vw,20px);color:var(--ink-soft);line-height:1.7;max-width:46ch;margin:0 0 40px;text-wrap:pretty\">Des cahiers d'activités pour les femmes hypersensibles et introverties. Un peu d'écriture, des coloriages, des jeux, des énigmes et des petits tests. De quoi passer une soirée rien qu'à toi, loin des écrans, sans rien à réussir.</p>\n          <div style=\"display:flex;gap:14px;align-items:center;justify-content:center;flex-wrap:wrap\">\n            <x-import component-from-global-scope=\"PapierPivoineDesignSystem_2e8f20.Button\" variant=\"primary\" size=\"lg\" onClick=\"{{ goActivites }}\" hint-size=\"240px,52px\">Les saisons tranquilles</x-import>\n            <x-import component-from-global-scope=\"PapierPivoineDesignSystem_2e8f20.Button\" variant=\"secondary\" size=\"lg\" onClick=\"{{ goProgramme }}\" hint-size=\"200px,52px\">Batterie faible</x-import>\n          </div>\n        </div>\n\n        <div style=\"background:var(--paper);border-top:1px solid var(--border-faint);border-bottom:1px solid var(--border-faint);padding:clamp(56px,9vw,80px) min(48px,5vw)\">\n          <div style=\"max-width:1080px;margin:0 auto\">\n            <h2 style=\"font-family:var(--font-display);font-weight:400;font-size:clamp(26px,4.4vw,32px);letter-spacing:0.04em;color:var(--deep-olive);line-height:1.2;text-align:center;margin:0 0 12px\">Dans chaque cahier, un peu de tout</h2>\n            <p style=\"font-family:var(--font-body);font-size:16px;color:var(--ink-soft);line-height:1.7;text-align:center;max-width:46ch;margin:0 auto 44px\">Tu ouvres à la page qui te fait envie. Tu en fais une, ou dix, ou aucune.</p>\n            <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:32px\">\n              <div style=\"border-top:1px solid var(--sage);padding-top:18px\">\n                <div style=\"font-family:var(--font-body);font-size:16px;font-weight:600;color:var(--deep-olive);margin-bottom:6px\">Écrire</div>\n                <p style=\"font-family:var(--font-body);font-size:15px;color:var(--ink-soft);line-height:1.65;margin:0\">Des pages guidées pour poser ce qui tourne dans ta tête. Trois lignes suffisent.</p>\n              </div>\n              <div style=\"border-top:1px solid var(--sage);padding-top:18px\">\n                <div style=\"font-family:var(--font-body);font-size:16px;font-weight:600;color:var(--deep-olive);margin-bottom:6px\">Colorier</div>\n                <p style=\"font-family:var(--font-body);font-size:15px;color:var(--ink-soft);line-height:1.65;margin:0\">De grandes illustrations, pour les soirs où réfléchir est trop fatigant.</p>\n              </div>\n              <div style=\"border-top:1px solid var(--sage);padding-top:18px\">\n                <div style=\"font-family:var(--font-body);font-size:16px;font-weight:600;color:var(--deep-olive);margin-bottom:6px\">Jouer</div>\n                <p style=\"font-family:var(--font-body);font-size:15px;color:var(--ink-soft);line-height:1.65;margin:0\">Mots croisés, sudoku, rébus, labyrinthes, messages codés. Les solutions sont à la fin.</p>\n              </div>\n              <div style=\"border-top:1px solid var(--sage);padding-top:18px\">\n                <div style=\"font-family:var(--font-body);font-size:16px;font-weight:600;color:var(--deep-olive);margin-bottom:6px\">Te découvrir</div>\n                <p style=\"font-family:var(--font-body);font-size:15px;color:var(--ink-soft);line-height:1.65;margin:0\">Des tests de personnalité et des quiz, pour rire un peu de toi, gentiment.</p>\n              </div>\n              <div style=\"border-top:1px solid var(--sage);padding-top:18px\">\n                <div style=\"font-family:var(--font-body);font-size:16px;font-weight:600;color:var(--deep-olive);margin-bottom:6px\">Souffler</div>\n                <p style=\"font-family:var(--font-body);font-size:15px;color:var(--ink-soft);line-height:1.65;margin:0\">Des respirations et des petits défis doux, pour les jours qui débordent.</p>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div style=\"padding:clamp(56px,9vw,84px) min(48px,5vw)\">\n          <div style=\"max-width:1080px;margin:0 auto\">\n            <div class=\"pp-eyebrow\" style=\"display:block;text-align:center;margin-bottom:14px\">Deux collections</div>\n            <h2 style=\"font-family:var(--font-display);font-weight:400;font-size:clamp(26px,4.4vw,32px);letter-spacing:0.04em;color:var(--deep-olive);line-height:1.2;text-align:center;margin:0 0 48px\">Choisis selon ton humeur</h2>\n            <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:32px;align-items:stretch\">\n\n              <div style=\"display:flex;flex-direction:column;background:var(--paper);border:1px solid var(--border-faint);border-radius:18px;overflow:hidden\">\n                <div style=\"background:var(--sage-soft);padding:32px 16px;display:flex;align-items:flex-end;justify-content:center;gap:16px\">\n                  <img src=\"/assets/cover-cocon-automne.jpg\" width=\"533\" height=\"800\" loading=\"lazy\" alt=\"Couverture : Le cocon d'automne\" style=\"display:block;height:210px;width:auto;border-radius:6px;border:1px solid var(--border-faint);box-shadow:0 12px 26px rgba(101,109,68,0.18)\">\n                  <img src=\"/assets/cover-cocon-hiver.jpg\" width=\"533\" height=\"800\" loading=\"lazy\" alt=\"Couverture : Mon cocon d'hiver\" style=\"display:block;height:240px;width:auto;border-radius:6px;border:1px solid var(--border-faint);box-shadow:0 12px 26px rgba(101,109,68,0.18)\">\n                </div>\n                <div style=\"padding:28px 30px 30px;display:flex;flex-direction:column;flex:1\">\n                  <div class=\"pp-eyebrow\" style=\"margin-bottom:10px\">Collection</div>\n                  <h3 style=\"font-family:var(--font-display);font-weight:400;font-size:clamp(22px,3.2vw,27px);letter-spacing:0.04em;color:var(--deep-olive);margin:0 0 12px\">Les saisons tranquilles</h3>\n                  <p style=\"font-family:var(--font-body);font-size:15px;color:var(--ink-soft);line-height:1.7;margin:0 0 22px\">Un cahier par saison, pour se poser au chaud. L'hiver et ses soirées qui tombent tôt, l'automne et son plaid, l'été au bord de l'eau.</p>\n                  <div style=\"margin-top:auto;display:flex;gap:10px;flex-wrap:wrap\">\n                    <x-import component-from-global-scope=\"PapierPivoineDesignSystem_2e8f20.Button\" variant=\"primary\" size=\"md\" onClick=\"{{ goActivites }}\" hint-size=\"190px,46px\">Voir la collection</x-import>\n                  </div>\n                </div>\n              </div>\n\n              <div style=\"display:flex;flex-direction:column;background:var(--paper);border:1px solid var(--border-faint);border-radius:18px;overflow:hidden\">\n                <div style=\"background:var(--blush);padding:32px 16px;display:flex;align-items:flex-end;justify-content:center;gap:16px\">\n                  <img src=\"/assets/cover-et-si.jpg\" width=\"533\" height=\"800\" loading=\"lazy\" alt=\"Couverture : Et si… ?\" style=\"display:block;height:240px;width:auto;border-radius:6px;border:1px solid var(--border-faint);box-shadow:0 12px 26px rgba(101,109,68,0.18)\">\n                </div>\n                <div style=\"padding:28px 30px 30px;display:flex;flex-direction:column;flex:1\">\n                  <div class=\"pp-eyebrow\" style=\"margin-bottom:10px\">Collection</div>\n                  <h3 style=\"font-family:var(--font-display);font-weight:400;font-size:clamp(22px,3.2vw,27px);letter-spacing:0.04em;color:var(--deep-olive);margin:0 0 12px\">Batterie faible</h3>\n                  <p style=\"font-family:var(--font-body);font-size:15px;color:var(--ink-soft);line-height:1.7;margin:0 0 22px\">Pour les jours où il ne te reste plus grand-chose. Quand la tête tourne trop, que tout paraît lourd, et que tu as seulement besoin de t'asseoir un moment.</p>\n                  <div style=\"margin-top:auto;display:flex;gap:10px;flex-wrap:wrap\">\n                    <x-import component-from-global-scope=\"PapierPivoineDesignSystem_2e8f20.Button\" variant=\"primary\" size=\"md\" onClick=\"{{ goProgramme }}\" hint-size=\"190px,46px\">Voir la collection</x-import>\n                  </div>\n                </div>\n              </div>\n\n            </div>\n          </div>\n        </div>\n\n        <div style=\"background:var(--paper);border-top:1px solid var(--border-faint);border-bottom:1px solid var(--border-faint);padding:clamp(56px,9vw,84px) min(48px,5vw);display:flex;justify-content:center\">\n          <x-import component-from-global-scope=\"PapierPivoineDesignSystem_2e8f20.LetterBlock\" align=\"center\" signature=\"\" hint-size=\"620px,360px\">\n            <p style=\"margin:0 0 1.2em\">Bonjour, et bienvenue. Je suis contente que tu sois là.</p>\n            <p style=\"margin:0 0 1.2em\">Je m'appelle Camélia. Je ressens tout un peu fort, et le monde me fatigue vite. Le soir, je n'ai pas toujours l'énergie d'écrire une page entière. Alors j'ai fait les cahiers dont j'avais besoin : un coloriage quand la tête est pleine, une grille de mots croisés quand je veux penser à autre chose, trois lignes quand j'ai envie de dire ce qui pèse.</p>\n            <p style=\"margin:0\">Tu n'as rien à finir. Prends la page qui te fait envie, et laisse le reste.</p>\n            <div style=\"margin-top:22px;font-family:var(--font-accent);font-size:34px;line-height:1.1;color:var(--rose)\">Camélia</div>\n          </x-import>\n        </div>\n\n        <div style=\"padding:84px min(48px,5vw)\">\n          <div style=\"max-width:1180px;margin:0 auto\">\n            <sc-if value=\"{{ saisonAutomne }}\" hint-placeholder-val=\"{{ true }}\"><div style=\"display:flex;justify-content:center;margin-bottom:40px\"><img loading=\"lazy\" decoding=\"async\" src=\"/assets/automne/branche-feuilles.webp\" width=\"1120\" height=\"240\" alt=\"\" aria-hidden=\"true\" style=\"display:block;width:min(560px,86vw);height:auto\"></div></sc-if>\n            <div class=\"pp-eyebrow\" style=\"display:block;text-align:center;margin-bottom:44px\">Ce qu'elles en disent</div>\n            <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:36px;align-items:start\">\n              <div style=\"border-top:1px solid var(--sage);padding-top:20px\">\n                <div style=\"font-size:14px;letter-spacing:0.08em;margin-bottom:12px\">⭐️⭐️⭐️⭐️⭐️</div>\n                <p style=\"font-family:var(--font-body);font-size:15px;color:var(--ink-soft);line-height:1.7;margin:0 0 16px\">Je trouve que cette template peut être une ressource pour travailler entre les séances, pour aller vers une autonomisation dans la gestion et l'expression des émotions, tout en construisant la confiance en soi.</p>\n                <div style=\"font-family:var(--font-accent);font-size:21px;line-height:1.2;color:var(--rose-deep)\">Manon · Psychologue pour enfants et adolescents</div>\n              </div>\n              <div style=\"border-top:1px solid var(--sage);padding-top:20px\">\n                <p style=\"font-family:var(--font-body);font-size:15px;color:var(--ink-soft);line-height:1.7;margin:0 0 16px\">J'ai rempli plusieurs pages, sans être pressée par le temps. Je suis à l'après de l'exercice du Jour 1 et je me sens assez soulagée, calme, et je ne pensais pas porter tout ça. Je suis surprise que mes pensées soient si positives, moi qui pensais qu'elles étaient plus négatives qu'autre chose. J'adore écrire et cet exercice est parfait pour moi, c'est une routine que je veux intégrer à mon quotidien. Merci pour cette initiative, j'ai beaucoup apprécié ce moment.</p>\n                <div style=\"font-family:var(--font-accent);font-size:21px;line-height:1.2;color:var(--rose-deep)\">Anne-Sophie</div>\n              </div>\n              <div style=\"border-top:1px solid var(--sage);padding-top:20px\">\n                <p style=\"font-family:var(--font-body);font-size:15px;color:var(--ink-soft);line-height:1.7;margin:0 0 10px\">⭐️⭐️⭐️⭐️⭐️ Super utile et transformateur !</p>\n                <p style=\"font-family:var(--font-body);font-size:15px;color:var(--ink-soft);line-height:1.7;margin:0 0 10px\">💬 Très utile, j'ai ressenti un vrai changement.</p>\n                <p style=\"font-family:var(--font-body);font-size:15px;color:var(--ink-soft);line-height:1.7;margin:0 0 16px\">💌 Merci de tes conseils, j'ai essayé et cela a fonctionné.</p>\n                <div style=\"font-family:var(--font-accent);font-size:21px;line-height:1.2;color:var(--rose-deep)\">Anonymes</div>\n              </div>\n              <div style=\"border-top:1px solid var(--sage);padding-top:20px\">\n                <p style=\"font-family:var(--font-body);font-size:15px;color:var(--ink-soft);line-height:1.7;margin:0 0 16px\">Camélia, ta lettre du mardi est devenue un véritable rendez-vous précieux pour moi. Le travail d'écriture que tu proposes m'apporte énormément dans mon quotidien. Grâce à tes exercices j'apprends à me poser, à réfléchir différemment et à mieux comprendre ce que je ressens. J'avance petit à petit, à mon rythme, et je sens une vraie évolution. Merci pour la douceur, la profondeur et la constance que tu mets dans chacun de tes envois. ☺️✨✨</p>\n                <div style=\"font-family:var(--font-accent);font-size:21px;line-height:1.2;color:var(--rose-deep)\">- Véronique</div>\n              </div>\n              <div style=\"border-top:1px solid var(--sage);padding-top:20px\">\n                <p style=\"font-family:var(--font-body);font-size:15px;color:var(--ink-soft);line-height:1.7;margin:0 0 16px\">Merci pour tes newsletters qui sont de réelles bouffées d'air frais. J'aimais déjà écrire et je tenais mon journal de pensée mais là c'est encore mieux avec les sujets que tu abordes. Merci du fond du cœur.</p>\n                <div style=\"font-family:var(--font-accent);font-size:21px;line-height:1.2;color:var(--rose-deep)\">- Virginie</div>\n              </div>\n              <div style=\"border-top:1px solid var(--sage);padding-top:20px\">\n                <p style=\"font-family:var(--font-body);font-size:15px;color:var(--ink-soft);line-height:1.7;margin:0 0 16px\">J'adore vraiment vos mails et vos écrits, j'en ai déjà réalisé plusieurs et avec un retour en arrière sur mes écrits cela m'a permis de réaliser beaucoup de choses.</p>\n                <div style=\"font-family:var(--font-accent);font-size:21px;line-height:1.2;color:var(--rose-deep)\">- Nathalie</div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <sc-if value=\"{{ saisonAutomne }}\" hint-placeholder-val=\"{{ true }}\"><div style=\"display:flex;justify-content:center;padding:0 min(48px,5vw)\"><img loading=\"lazy\" decoding=\"async\" src=\"/assets/automne/guirlande-eglantier.webp\" width=\"1120\" height=\"254\" alt=\"\" aria-hidden=\"true\" style=\"display:block;width:min(520px,84vw);height:auto\"></div></sc-if>\n        <div style=\"padding:84px min(48px,5vw);text-align:center\">\n          <div class=\"pp-eyebrow\" style=\"margin-bottom:18px\">La méthode pivoine</div>\n          <p style=\"font-family:var(--font-display);font-size:28px;color:var(--deep-olive);letter-spacing:0.04em;line-height:1.4;max-width:24ch;margin:0 auto 36px\">Sept petites permissions, glissées dans chaque cahier.</p>\n          <div style=\"display:flex;justify-content:center;margin-bottom:30px\">\n            <x-import component-from-global-scope=\"PapierPivoineDesignSystem_2e8f20.PivoineBadge\" variant=\"strip\" hint-size=\"560px,64px\"></x-import>\n          </div>\n          <x-import component-from-global-scope=\"PapierPivoineDesignSystem_2e8f20.Button\" variant=\"ghost\" size=\"md\" onClick=\"{{ goMethode }}\" hint-size=\"200px,44px\">Découvrir la méthode</x-import>\n        </div>\n\n      </div>\n    </sc-if>\n\n    <!-- ═══════════ COLLECTION BATTERIE FAIBLE (route /programme/) ═══════════ -->\n    \n\n    <!-- ═══════════ CARNETS D'ÉCRITURE ═══════════ -->\n    \n\n    <!-- ═══════════ COLLECTION LES SAISONS TRANQUILLES (route /activites/) ═══════════ -->\n    \n\n    <!-- ═══════════ LA MÉTHODE ═══════════ -->\n    \n\n    <!-- ═══════════ À PROPOS ═══════════ -->\n    \n\n    <!-- ═══════════ LA NEWSLETTER ═══════════ -->\n    \n\n\n    <!-- ═══════════ LIENS ═══════════ -->\n    \n\n    <!-- ═══════════ BAND (toutes pages sauf newsletter) ═══════════ -->\n    <sc-if value=\"{{ showBand }}\" hint-placeholder-val=\"{{ true }}\">\n      <div style=\"background:var(--blush)\">\n        <div style=\"max-width:720px;margin:0 auto;padding:80px min(48px,5vw);text-align:center\">\n          <h2 style=\"font-family:var(--font-display);font-weight:400;font-size:clamp(26px,4.2vw,34px);letter-spacing:0.04em;color:var(--deep-olive);margin:0 0 18px\">Commence par un cadeau</h2>\n          <p style=\"font-family:var(--font-body);font-size:16px;color:var(--ink-soft);line-height:1.7;max-width:52ch;margin:0 auto 30px\">Une fois par mois, je t'écris : le thème de la saison, mes réflexions, un exercice d'écriture guidé, et les nouveaux cahiers en premier. Pour t'accueillir, je t'offre la première semaine de Mental Léger, pour vider ta tête le soir.</p>\n          <p style=\"font-family:var(--font-body);font-size:15px;font-style:italic;color:var(--ink-soft);line-height:1.6;max-width:46ch;margin:0 auto 28px\">« Merci pour tes newsletters qui sont de réelles bouffées d'air frais. » · Virginie</p>\n          <sc-if value=\"{{ notSubscribed }}\" hint-placeholder-val=\"{{ true }}\">\n            <div style=\"display:flex;justify-content:center\">\n              <x-import component-from-global-scope=\"PapierPivoineDesignSystem_2e8f20.Button\" variant=\"primary\" size=\"lg\" onClick=\"{{ subscribe }}\" hint-size=\"200px,52px\">Recevoir le cadeau</x-import>\n            </div>\n            <p style=\"font-family:var(--font-body);font-size:12px;color:var(--ink-faint);margin:16px 0 0\">C'est gratuit. Tu peux te désinscrire quand tu veux. <span onClick=\"{{ goNewsletter }}\" style=\"color:var(--rose);cursor:pointer;text-decoration:underline;text-underline-offset:3px\">Voir ce qu'il y a dedans</span></p>\n          </sc-if>\n          <sc-if value=\"{{ subscribed }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:var(--paper);border:1px solid var(--border-faint);border-radius:14px;padding:28px 32px;max-width:440px;margin:0 auto\">\n              <p style=\"font-family:var(--font-body);font-size:16px;color:var(--deep-olive);line-height:1.6;margin:0 0 6px\">C'est noté. La première semaine de Mental Léger est en route vers ta boîte mail.</p>\n              <p style=\"font-family:var(--font-body);font-size:13px;color:var(--ink-faint);margin:0\">Si tu ne la vois pas, regarde dans les courriers indésirables.</p>\n            </div>\n          </sc-if>\n        </div>\n        <sc-if value=\"{{ saisonAutomne }}\" hint-placeholder-val=\"{{ true }}\"><div style=\"display:flex;justify-content:center;padding:0 min(48px,5vw)\"><img loading=\"lazy\" decoding=\"async\" src=\"/assets/automne/herbes-sechees.webp\" width=\"1000\" height=\"384\" alt=\"\" aria-hidden=\"true\" style=\"display:block;width:min(900px,100%);height:auto\"></div></sc-if>\n      </div>\n    </sc-if>\n\n  </main>\n\n  <a data-formkit-toggle=\"638990c016\" href=\"https://camelianguyen.kit.com/638990c016\" style=\"display:none\" aria-hidden=\"true\">La newsletter</a>\n\n  <!-- ═══════════ FOOTER ═══════════ -->\n  <sc-if value=\"{{ showChrome }}\" hint-placeholder-val=\"{{ true }}\">\n  <footer style=\"background:var(--paper-warm);border-top:1px solid var(--border-faint);padding:56px min(48px,5vw) 40px\">\n    <div style=\"max-width:1180px;margin:0 auto\">\n      <div style=\"display:flex;justify-content:space-between;align-items:flex-start;gap:32px;flex-wrap:wrap\">\n        <div>\n          <div style=\"font-family:var(--font-display);font-size:20px;color:var(--deep-olive);letter-spacing:0.06em;margin-bottom:8px\">Papier Pivoine</div>\n          <p style=\"font-family:var(--font-body);font-style:italic;color:var(--rose);margin:0;font-size:14px;max-width:32ch;line-height:1.5\">Trop sensible, trop fatiguée, trop bien sous mon plaid.</p>\n        </div>\n        <div style=\"display:flex;gap:40px 64px;flex-wrap:wrap\">\n          <div>\n            <div class=\"pp-eyebrow\" style=\"margin-bottom:14px\">Découvrir</div>\n            <div style=\"display:flex;flex-direction:column;gap:9px;font-family:var(--font-body);font-size:14px;color:var(--ink-soft)\">\n              <span onClick=\"{{ goActivites }}\" style=\"cursor:pointer\">Les saisons tranquilles</span>\n              <span onClick=\"{{ goProgramme }}\" style=\"cursor:pointer\">Batterie faible</span>\n              <span onClick=\"{{ goMethode }}\" style=\"cursor:pointer\">La méthode</span>\n            </div>\n          </div>\n          <div>\n            <div class=\"pp-eyebrow\" style=\"margin-bottom:14px\">Rester en lien</div>\n            <div style=\"display:flex;flex-direction:column;gap:9px;font-family:var(--font-body);font-size:14px;color:var(--ink-soft)\">\n              <span onClick=\"{{ goNewsletter }}\" style=\"cursor:pointer\">La newsletter gratuite</span>\n              <a href=\"https://fr.pinterest.com/papierpivoine/\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--ink-soft);text-decoration:none\">Pinterest</a>\n              <a href=\"https://www.instagram.com/papierpivoine/\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--ink-soft);text-decoration:none\">Instagram</a>\n              <a href=\"https://www.tiktok.com/@papierpivoine\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--ink-soft);text-decoration:none\">TikTok</a>\n              <span onClick=\"{{ goApropos }}\" style=\"cursor:pointer\">À propos</span>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div style=\"height:1px;background:var(--border-faint);margin:36px 0\"></div>\n      <p style=\"font-family:var(--font-body);font-size:12px;color:var(--ink-faint);margin:0 0 8px;max-width:70ch;line-height:1.6\">Ce que tu trouves ici est une pratique douce, pas un soin. Ce n'est pas un substitut à un accompagnement professionnel. Si tu traverses une période difficile, parles-en à un professionnel de santé.</p>\n      <p style=\"font-family:var(--font-body);font-size:12px;color:var(--ink-faint);margin:0\">© 2026 Papier Pivoine · Camélia Nguyen</p>\n    </div>\n  </footer>\n  </sc-if>\n\n  <template id=\"__bundler_thumbnail\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 100\"><rect width=\"100\" height=\"100\" fill=\"#F8E7E1\"></rect><text x=\"50\" y=\"60\" text-anchor=\"middle\" font-family=\"Georgia, serif\" font-size=\"26\" letter-spacing=\"2\" fill=\"#C47A78\">PP</text></svg></template>\n\n</div>\n"}
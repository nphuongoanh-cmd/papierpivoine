{"tpl":"\n<helmet>\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/colors.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/typography.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/spacing.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/effects.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/base.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/styles.css\">\n  <script src=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/_ds_bundle.js\"></script>\n  <link rel=\"preload\" href=\"/assets/fonts/fraunces-800-latin.woff2\" as=\"font\" type=\"font/woff2\" crossorigin=\"anonymous\">\n  <link rel=\"preload\" href=\"/assets/fonts/nunito-sans-latin.woff2\" as=\"font\" type=\"font/woff2\" crossorigin=\"anonymous\">\n  <style>\n    @font-face { font-family: 'Caveat'; font-style: normal; font-weight: 400 600; font-display: swap; src: url(/assets/fonts/caveat-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Caveat'; font-style: normal; font-weight: 400 600; font-display: swap; src: url(/assets/fonts/caveat-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 300 600; font-display: swap; src: url(/assets/fonts/fraunces-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 300 600; font-display: swap; src: url(/assets/fonts/fraunces-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    @font-face { font-family: 'Nunito Sans'; font-style: normal; font-weight: 300 700; font-display: swap; src: url(/assets/fonts/nunito-sans-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Nunito Sans'; font-style: normal; font-weight: 300 700; font-display: swap; src: url(/assets/fonts/nunito-sans-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    @font-face { font-family: 'Caveat'; font-style: normal; font-weight: 700; font-display: swap; src: url(/assets/fonts/caveat-700-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Caveat'; font-style: normal; font-weight: 700; font-display: swap; src: url(/assets/fonts/caveat-700-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    @font-face { font-family: 'Fraunces'; font-style: italic; font-weight: 700; font-display: swap; src: url(/assets/fonts/fraunces-italic-700-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Fraunces'; font-style: italic; font-weight: 700; font-display: swap; src: url(/assets/fonts/fraunces-italic-700-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 800; font-display: swap; src: url(/assets/fonts/fraunces-800-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 800; font-display: swap; src: url(/assets/fonts/fraunces-800-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    :root {\n      --font-display: 'Fraunces', Georgia, serif;\n      --font-body: 'Nunito Sans', system-ui, sans-serif;\n      --font-accent: 'Caveat', cursive;\n    }\n    /* Saison : automne par défaut (aucun attribut), \"neutre\" = palette d'origine. Réglage : prop season. */\n    /* Palette d'automne : mêmes rôles que la palette d'origine, teintes terre cuite, ocre et olive brun. */\n    html:not([data-season=\"neutre\"]) {\n      --blush: #F7D9D3; --blush-deep: #F0C7BF; --pale-rose: #DDA9A0;\n      --rose: #E26D5F; --rose-deep: #BF5548;\n      --sage: #B2BD88; --sage-soft: #EEF0DE; --olive-soft: #E9ECD9;\n      --deep-olive: #33321E; --ink: #33321E; --ink-soft: #46452F; --ink-faint: #6B6953;\n      --paper: #FFFCFA; --paper-warm: #FCF6F2; --border-faint: #EDE1D6; --sand: #EAD9AC;\n      --text-on-accent: #FFFCFA;\n    }\n    body { margin: 0; background: var(--paper-warm, #FCF6F2); }\n    a { color: var(--rose-deep); }\n    a:hover { color: var(--ink); }\n    mark { -webkit-box-decoration-break: clone; box-decoration-break: clone; }\n    ::selection { background: var(--blush); }\n    /* Pop-up Kit : autoriser le défilement sur mobile (leur fenêtre dépasse l'écran) */\n    @media (max-width: 700px) {\n      .formkit-overlay, .formkit-modal { overflow-y: auto !important; -webkit-overflow-scrolling: touch !important; align-items: flex-start !important; }\n      .formkit-modal { max-height: 100dvh !important; }\n      .formkit-modal .formkit-form, .formkit-modal > div { max-height: none !important; }\n    }\n    /* Navigation : liens en ligne sur ordinateur, menu replié sur mobile */\n    .pp-burger { display: none; }\n    @media (max-width: 700px) {\n      .pp-nav-desktop { display: none !important; }\n      .pp-burger { display: inline-flex !important; }\n    }\n    @media (min-width: 701px) {\n      .pp-nav-mobile { display: none !important; }\n    }\n    /* Mobile : zones cliquables d'au moins 44 px */\n    @media (max-width: 700px) {\n      .pp-nav-mobile > span, .pp-nav-mobile > * > span { min-height: 44px; display: flex; align-items: center; box-sizing: border-box; }\n      header > span:first-child { min-height: 44px; display: inline-flex; align-items: center; }\n      main button, footer button { min-height: 44px; }\n      footer [style*=\"cursor: pointer\"], footer [style*=\"cursor:pointer\"], footer a { min-height: 44px; display: flex; align-items: center; }\n    }\n  </style>\n</helmet>\n\n<div style=\"min-height:100vh;display:flex;flex-direction:column;background:var(--paper-warm)\">\n\n  <!-- ═══════════ HEADER ═══════════ -->\n  <sc-if value=\"{{ showChrome }}\" hint-placeholder-val=\"{{ true }}\">\n  <header style=\"display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px 24px;padding:18px min(48px,5vw);border-bottom:1px solid var(--border-faint);background:var(--paper-warm);position:sticky;top:0;z-index:10\">\n    <span onClick=\"{{ goAccueil }}\" style=\"cursor:pointer;display:inline-flex;align-items:center;gap:10px;font-family:var(--font-display);font-weight:800;font-variation-settings:'opsz' 72;font-size:23px;color:var(--deep-olive);letter-spacing:-0.005em\"><img src=\"/assets/logo-papier-pivoine.jpg\" width=\"400\" height=\"400\" alt=\"\" aria-hidden=\"true\" style=\"display:block;width:40px;height:40px;border-radius:50%;border:2px solid var(--ink);box-sizing:border-box;flex:none\">Papier Pivoine</span>\n    <span class=\"pp-burger\" onClick=\"{{ toggleMenu }}\" role=\"button\" aria-label=\"Menu\" style=\"display:none;align-items:center;justify-content:center;width:44px;height:44px;margin:-8px -10px;cursor:pointer\">\n      <sc-if value=\"{{ menuClosed }}\" hint-placeholder-val=\"{{ true }}\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--deep-olive)\" stroke-width=\"1.4\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M3 8h18\"></path><path d=\"M3 16h18\"></path></svg></sc-if>\n      <sc-if value=\"{{ menuOpen }}\" hint-placeholder-val=\"{{ false }}\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--deep-olive)\" stroke-width=\"1.4\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M6 6l12 12\"></path><path d=\"M18 6L6 18\"></path></svg></sc-if>\n    </span>\n    <nav class=\"pp-nav-desktop\" style=\"display:flex;gap:6px 24px;align-items:center;flex-wrap:wrap\">\n      <span onClick=\"{{ goAccueil }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCAccueil }};border-bottom:1px solid {{ navUAccueil }}\">Accueil</span>\n      \n      <span onClick=\"{{ goActivites }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCActivites }};border-bottom:1px solid {{ navUActivites }}\">Saisons tranquilles</span>\n      <span onClick=\"{{ goProgramme }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCProgramme }};border-bottom:1px solid {{ navUProgramme }}\">Batterie faible</span>\n      <span onClick=\"{{ goMethode }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCMethode }};border-bottom:1px solid {{ navUMethode }}\">7 permissions PIVOINE</span>\n      <span onClick=\"{{ goApropos }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCApropos }};border-bottom:1px solid {{ navUApropos }}\">À propos</span>\n      <span onClick=\"{{ goNewsletter }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCNewsletter }};border-bottom:1px solid {{ navUNewsletter }}\">Newsletter</span>\n    </nav>\n    <sc-if value=\"{{ menuOpen }}\" hint-placeholder-val=\"{{ false }}\">\n      <nav class=\"pp-nav-mobile\" style=\"flex-basis:100%;display:flex;flex-direction:column;padding:2px 0 8px\">\n        <span onClick=\"{{ goAccueil }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCAccueil }};border-top:1px solid var(--border-faint)\">Accueil</span>\n        \n        <span onClick=\"{{ goActivites }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCActivites }};border-top:1px solid var(--border-faint)\">Saisons tranquilles</span>\n        <span onClick=\"{{ goProgramme }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCProgramme }};border-top:1px solid var(--border-faint)\">Batterie faible</span>\n        <span onClick=\"{{ goMethode }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCMethode }};border-top:1px solid var(--border-faint)\">7 permissions PIVOINE</span>\n        <span onClick=\"{{ goApropos }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCApropos }};border-top:1px solid var(--border-faint)\">À propos</span>\n        <span onClick=\"{{ goNewsletter }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCNewsletter }};border-top:1px solid var(--border-faint)\">Newsletter</span>\n      </nav>\n    </sc-if>\n  </header>\n  </sc-if>\n\n  <main style=\"flex:1\">\n\n    <!-- ═══════════ ACCUEIL ═══════════ -->\n    <sc-if value=\"{{ isAccueil }}\" hint-placeholder-val=\"{{ true }}\">\n      <div data-screen-label=\"Accueil\">\n\n        <div style=\"padding:clamp(56px,10vw,104px) min(48px,5vw) clamp(56px,8vw,84px);background-color:#FCF6F2;background-image:radial-gradient(#E9DCCB 1.6px, transparent 1.8px);background-size:32px 32px;display:flex;flex-direction:column;align-items:center;text-align:center\">\n          <sc-if value=\"{{ saisonAutomne }}\" hint-placeholder-val=\"{{ true }}\"><div style=\"position:relative;margin-bottom:26px\"><img src=\"/assets/automne/canape-bao.webp\" width=\"720\" height=\"487\" alt=\"Bao qui dort sur le canapé vert, à côté d’un plaid rayé rose\" style=\"display:block;width:min(400px,80vw);height:auto\"><div style=\"position:absolute;right:-8px;bottom:-14px;font-family:var(--font-accent);font-weight:700;font-size:26px;line-height:1;color:var(--rose-deep);transform:rotate(-4deg)\">(Bao approuve)</div></div></sc-if>\n          <div class=\"pp-eyebrow\" style=\"margin-bottom:22px\">Cahiers d’activités cocooning</div>\n          <h1 style=\"font-family:var(--font-display);font-weight:800;font-variation-settings:'opsz' 72;letter-spacing:-0.005em;font-size:clamp(36px,6.4vw,58px);line-height:1.08;color:var(--deep-olive);max-width:20ch;margin:0 0 26px;text-wrap:balance\">Trop sensible, trop fatiguée, trop bien <mark style=\"background:linear-gradient(transparent 55%, #EAD9AC 55%, #EAD9AC 92%, transparent 92%);color:inherit;padding:0 6px\">sous mon plaid</mark>.</h1>\n          <p style=\"font-family:var(--font-body);font-size:clamp(18px,2.2vw,19px);color:var(--ink-soft);line-height:1.6;max-width:46ch;margin:0 0 40px;text-wrap:pretty\">Des cahiers d’activités pour les femmes hypersensibles et introverties. Un peu d’écriture, des coloriages, des jeux, des énigmes et des petits tests. De quoi passer une soirée rien qu’à toi, loin des écrans, sans rien à réussir.</p>\n          <div style=\"display:flex;gap:18px 22px;align-items:center;justify-content:center;flex-wrap:wrap\">\n            <button type=\"button\" onClick=\"{{ goActivites }}\" style=\"display:inline-flex;align-items:center;gap:10px;padding:8px 26px 10px;border:3px solid var(--rose);border-radius:999px;color:var(--rose);font-family:var(--font-accent);font-weight:700;font-size:30px;line-height:1.1;transform:rotate(-2deg);background:transparent;cursor:pointer;transition:background-color 200ms ease,color 200ms ease\" style-hover=\"background:var(--rose);color:var(--paper-warm)\" style-focus=\"outline:2px solid var(--ink);outline-offset:4px\">Saisons tranquilles</button>\n            <button type=\"button\" onClick=\"{{ goProgramme }}\" style=\"display:inline-flex;align-items:center;gap:10px;padding:8px 26px 10px;border:3px solid var(--rose);border-radius:999px;color:var(--rose);font-family:var(--font-accent);font-weight:700;font-size:30px;line-height:1.1;transform:rotate(-2deg);background:transparent;cursor:pointer;transition:background-color 200ms ease,color 200ms ease\" style-hover=\"background:var(--rose);color:var(--paper-warm)\" style-focus=\"outline:2px solid var(--ink);outline-offset:4px\">Batterie faible</button>\n          </div>\n        </div>\n\n        <div style=\"background:var(--paper);border-top:1px solid var(--border-faint);border-bottom:1px solid var(--border-faint);padding:clamp(56px,9vw,80px) min(48px,5vw)\">\n          <div style=\"max-width:1080px;margin:0 auto\">\n            <h2 style=\"font-family:var(--font-display);font-weight:800;font-variation-settings:'opsz' 72;letter-spacing:-0.005em;font-size:clamp(30px,4.6vw,40px);color:var(--deep-olive);line-height:1.08;text-align:center;margin:0 0 12px\">Dans chaque cahier, un <mark style=\"background:linear-gradient(transparent 55%, #EAD9AC 55%, #EAD9AC 92%, transparent 92%);color:inherit;padding:0 6px\">peu de tout</mark></h2>\n            <p style=\"font-family:var(--font-body);font-size:18px;color:var(--ink-soft);line-height:1.6;text-align:center;max-width:46ch;margin:0 auto 44px\">Tu ouvres à la page qui te fait envie. Tu en fais une, ou dix, ou aucune.</p>\n            <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,140px),1fr));gap:24px\">\n              <div style=\"border-top:1px solid var(--sage);padding-top:18px\">\n                <div style=\"font-family:var(--font-body);font-size:19px;font-weight:700;color:var(--deep-olive);margin-bottom:6px\">Écrire</div>\n                <p style=\"font-family:var(--font-body);font-size:18px;color:var(--ink-soft);line-height:1.6;margin:0\">Des pages guidées pour poser ce qui tourne dans ta tête. Trois lignes suffisent.</p>\n              </div>\n              <div style=\"border-top:1px solid var(--sage);padding-top:18px\">\n                <div style=\"font-family:var(--font-body);font-size:19px;font-weight:700;color:var(--deep-olive);margin-bottom:6px\">Colorier</div>\n                <p style=\"font-family:var(--font-body);font-size:18px;color:var(--ink-soft);line-height:1.6;margin:0\">De grandes illustrations, pour les soirs où réfléchir est trop fatigant.</p>\n              </div>\n              <div style=\"border-top:1px solid var(--sage);padding-top:18px\">\n                <div style=\"font-family:var(--font-body);font-size:19px;font-weight:700;color:var(--deep-olive);margin-bottom:6px\">Jouer</div>\n                <p style=\"font-family:var(--font-body);font-size:18px;color:var(--ink-soft);line-height:1.6;margin:0\">Mots croisés, sudoku, rébus, labyrinthes, messages codés. Les solutions sont à la fin.</p>\n              </div>\n              <div style=\"border-top:1px solid var(--sage);padding-top:18px\">\n                <div style=\"font-family:var(--font-body);font-size:19px;font-weight:700;color:var(--deep-olive);margin-bottom:6px\">Te découvrir</div>\n                <p style=\"font-family:var(--font-body);font-size:18px;color:var(--ink-soft);line-height:1.6;margin:0\">Des tests de personnalité et des quiz, pour rire un peu de toi, gentiment.</p>\n              </div>\n              <div style=\"border-top:1px solid var(--sage);padding-top:18px\">\n                <div style=\"font-family:var(--font-body);font-size:19px;font-weight:700;color:var(--deep-olive);margin-bottom:6px\">Souffler</div>\n                <p style=\"font-family:var(--font-body);font-size:18px;color:var(--ink-soft);line-height:1.6;margin:0\">Des respirations et des petits défis doux, pour les jours qui débordent.</p>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div style=\"padding:clamp(56px,9vw,84px) min(48px,5vw)\">\n          <div style=\"max-width:1080px;margin:0 auto\">\n            <div class=\"pp-eyebrow\" style=\"display:block;text-align:center;margin-bottom:14px\">Deux collections</div>\n            <h2 style=\"font-family:var(--font-display);font-weight:800;font-variation-settings:'opsz' 72;letter-spacing:-0.005em;font-size:clamp(30px,4.6vw,40px);color:var(--deep-olive);line-height:1.08;text-align:center;margin:0 0 10px\">Choisis selon ton <mark style=\"background:linear-gradient(transparent 55%, #EAD9AC 55%, #EAD9AC 92%, transparent 92%);color:inherit;padding:0 6px\">humeur</mark></h2>\n            <div style=\"text-align:center;font-family:var(--font-accent);font-weight:700;font-size:26px;line-height:1.2;color:var(--rose-deep);transform:rotate(-2deg);margin:0 0 44px\">(sans pression, promis)</div>\n            <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:32px;align-items:stretch\">\n\n              <div style=\"display:flex;flex-direction:column;background:var(--paper);border:1px solid var(--border-faint);border-radius:18px;overflow:hidden\">\n                <div style=\"background:var(--sage-soft);padding:32px 16px;display:flex;align-items:flex-end;justify-content:center;gap:16px\">\n                  <img src=\"/assets/cover-cocon-automne.jpg\" width=\"533\" height=\"800\" loading=\"lazy\" alt=\"Couverture : Le cocon d’automne\" style=\"display:block;height:210px;width:auto;border-radius:6px;border:1px solid var(--border-faint);box-shadow:0 12px 26px rgba(101,109,68,0.18)\">\n                  <img src=\"/assets/cover-cocon-hiver.jpg\" width=\"533\" height=\"800\" loading=\"lazy\" alt=\"Couverture : Mon cocon d’hiver\" style=\"display:block;height:240px;width:auto;border-radius:6px;border:1px solid var(--border-faint);box-shadow:0 12px 26px rgba(101,109,68,0.18)\">\n                </div>\n                <div style=\"padding:28px 30px 30px;display:flex;flex-direction:column;flex:1\">\n                  <div class=\"pp-eyebrow\" style=\"margin-bottom:10px\">Collection</div>\n                  <h3 style=\"font-family:var(--font-display);font-weight:700;font-style:italic;font-size:clamp(24px,3.2vw,29px);line-height:1.15;color:var(--deep-olive);margin:0 0 12px\">Saisons tranquilles</h3>\n                  <p style=\"font-family:var(--font-body);font-size:18px;color:var(--ink-soft);line-height:1.6;margin:0 0 22px\">Un cahier par saison, pour se poser au chaud. L’hiver et ses soirées qui tombent tôt, l’automne et son plaid, l’été au bord de l’eau.</p>\n                  <div style=\"margin-top:auto;padding-top:6px;display:flex;gap:10px;flex-wrap:wrap\">\n                    <button type=\"button\" onClick=\"{{ goActivites }}\" style=\"display:inline-flex;align-items:center;gap:10px;padding:8px 26px 10px;border:3px solid var(--rose);border-radius:999px;color:var(--rose);font-family:var(--font-accent);font-weight:700;font-size:30px;line-height:1.1;transform:rotate(-2deg);background:transparent;cursor:pointer;transition:background-color 200ms ease,color 200ms ease\" style-hover=\"background:var(--rose);color:var(--paper-warm)\" style-focus=\"outline:2px solid var(--ink);outline-offset:4px\">Voir la collection</button>\n                  </div>\n                </div>\n              </div>\n\n              <div style=\"display:flex;flex-direction:column;background:var(--paper);border:1px solid var(--border-faint);border-radius:18px;overflow:hidden\">\n                <div style=\"background:var(--blush);padding:32px 16px;display:flex;align-items:flex-end;justify-content:center;gap:16px\">\n                  <img src=\"/assets/cover-et-si.jpg\" width=\"533\" height=\"800\" loading=\"lazy\" alt=\"Couverture : Et si… ?\" style=\"display:block;height:240px;width:auto;border-radius:6px;border:1px solid var(--border-faint);box-shadow:0 12px 26px rgba(101,109,68,0.18)\">\n                </div>\n                <div style=\"padding:28px 30px 30px;display:flex;flex-direction:column;flex:1\">\n                  <div class=\"pp-eyebrow\" style=\"margin-bottom:10px\">Collection</div>\n                  <h3 style=\"font-family:var(--font-display);font-weight:700;font-style:italic;font-size:clamp(24px,3.2vw,29px);line-height:1.15;color:var(--deep-olive);margin:0 0 12px\">Batterie faible</h3>\n                  <p style=\"font-family:var(--font-body);font-size:18px;color:var(--ink-soft);line-height:1.6;margin:0 0 22px\">Pour les jours où il ne te reste plus grand-chose. Quand la tête tourne trop, que tout paraît lourd, et que tu as seulement besoin de t’asseoir un moment.</p>\n                  <div style=\"margin-top:auto;padding-top:6px;display:flex;gap:10px;flex-wrap:wrap\">\n                    <button type=\"button\" onClick=\"{{ goProgramme }}\" style=\"display:inline-flex;align-items:center;gap:10px;padding:8px 26px 10px;border:3px solid var(--rose);border-radius:999px;color:var(--rose);font-family:var(--font-accent);font-weight:700;font-size:30px;line-height:1.1;transform:rotate(-2deg);background:transparent;cursor:pointer;transition:background-color 200ms ease,color 200ms ease\" style-hover=\"background:var(--rose);color:var(--paper-warm)\" style-focus=\"outline:2px solid var(--ink);outline-offset:4px\">Voir la collection</button>\n                  </div>\n                </div>\n              </div>\n\n            </div>\n          </div>\n        </div>\n\n        <div style=\"background:var(--paper);border-top:1px solid var(--border-faint);border-bottom:1px solid var(--border-faint);padding:clamp(56px,9vw,84px) min(48px,5vw);display:flex;justify-content:center\">\n          <x-import component-from-global-scope=\"PapierPivoineDesignSystem_2e8f20.LetterBlock\" align=\"center\" signature=\"\" hint-size=\"620px,360px\">\n            <p style=\"margin:0 0 1.2em\">Bonjour, et bienvenue. Je suis contente que tu sois là.</p>\n            <p style=\"margin:0 0 1.2em\">Je m’appelle Camélia. Je ressens tout un peu fort, et le monde me fatigue vite. Le soir, je n’ai pas toujours l’énergie d’écrire une page entière. Alors j’ai fait les cahiers dont j’avais besoin : un coloriage quand la tête est pleine, une grille de mots croisés quand je veux penser à autre chose, trois lignes quand j’ai envie de dire ce qui pèse.</p>\n            <p style=\"margin:0\">Tu n’as rien à finir. Prends la page qui te fait envie, et laisse le reste.</p>\n            <div style=\"margin-top:22px;font-family:var(--font-accent);font-size:34px;line-height:1.1;color:var(--rose)\">Camélia</div>\n          </x-import>\n        </div>\n\n        <div style=\"padding:84px min(48px,5vw)\">\n          <div style=\"max-width:1180px;margin:0 auto\">\n            <sc-if value=\"{{ saisonAutomne }}\" hint-placeholder-val=\"{{ true }}\"><div style=\"display:flex;justify-content:center;margin-bottom:40px\"><img loading=\"lazy\" decoding=\"async\" src=\"/assets/automne/branche-feuilles.webp\" width=\"1120\" height=\"240\" alt=\"Une branche d’automne avec des feuilles et des baies rouges\" style=\"display:block;width:min(560px,86vw);height:auto\"></div></sc-if>\n            <div class=\"pp-eyebrow\" style=\"display:block;text-align:center;margin-bottom:44px\">Ce qu’elles en disent</div>\n            <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:36px;align-items:start\">\n              <div style=\"border-top:1px solid var(--sage);padding-top:20px\">\n                <div style=\"font-size:14px;letter-spacing:0.08em;margin-bottom:12px\">⭐️⭐️⭐️⭐️⭐️</div>\n                <p style=\"font-family:var(--font-body);font-size:18px;color:var(--ink-soft);line-height:1.6;margin:0 0 16px\">Je trouve que cette template peut être une ressource pour travailler entre les séances, pour aller vers une autonomisation dans la gestion et l’expression des émotions, tout en construisant la confiance en soi.</p>\n                <div style=\"font-family:var(--font-accent);font-size:21px;line-height:1.2;color:var(--rose-deep)\">Manon · Psychologue pour enfants et adolescents</div>\n              </div>\n              <div style=\"border-top:1px solid var(--sage);padding-top:20px\">\n                <p style=\"font-family:var(--font-body);font-size:18px;color:var(--ink-soft);line-height:1.6;margin:0 0 16px\">J’ai rempli plusieurs pages, sans être pressée par le temps. Je suis à l’après de l’exercice du Jour 1 et je me sens assez soulagée, calme, et je ne pensais pas porter tout ça. Je suis surprise que mes pensées soient si positives, moi qui pensais qu’elles étaient plus négatives qu’autre chose. J’adore écrire et cet exercice est parfait pour moi, c’est une routine que je veux intégrer à mon quotidien. Merci pour cette initiative, j’ai beaucoup apprécié ce moment.</p>\n                <div style=\"font-family:var(--font-accent);font-size:21px;line-height:1.2;color:var(--rose-deep)\">Anne-Sophie</div>\n              </div>\n              <div style=\"border-top:1px solid var(--sage);padding-top:20px\">\n                <p style=\"font-family:var(--font-body);font-size:18px;color:var(--ink-soft);line-height:1.6;margin:0 0 10px\">⭐️⭐️⭐️⭐️⭐️ Super utile et transformateur !</p>\n                <p style=\"font-family:var(--font-body);font-size:18px;color:var(--ink-soft);line-height:1.6;margin:0 0 10px\">💬 Très utile, j’ai ressenti un vrai changement.</p>\n                <p style=\"font-family:var(--font-body);font-size:18px;color:var(--ink-soft);line-height:1.6;margin:0 0 16px\">💌 Merci de tes conseils, j’ai essayé et cela a fonctionné.</p>\n                <div style=\"font-family:var(--font-accent);font-size:21px;line-height:1.2;color:var(--rose-deep)\">Anonymes</div>\n              </div>\n              <div style=\"border-top:1px solid var(--sage);padding-top:20px\">\n                <p style=\"font-family:var(--font-body);font-size:18px;color:var(--ink-soft);line-height:1.6;margin:0 0 16px\">Camélia, ta lettre du mardi est devenue un véritable rendez-vous précieux pour moi. Le travail d’écriture que tu proposes m’apporte énormément dans mon quotidien. Grâce à tes exercices j’apprends à me poser, à réfléchir différemment et à mieux comprendre ce que je ressens. J’avance petit à petit, à mon rythme, et je sens une vraie évolution. Merci pour la douceur, la profondeur et la constance que tu mets dans chacun de tes envois. ☺️✨✨</p>\n                <div style=\"font-family:var(--font-accent);font-size:21px;line-height:1.2;color:var(--rose-deep)\">- Véronique</div>\n              </div>\n              <div style=\"border-top:1px solid var(--sage);padding-top:20px\">\n                <p style=\"font-family:var(--font-body);font-size:18px;color:var(--ink-soft);line-height:1.6;margin:0 0 16px\">Merci pour tes newsletters qui sont de réelles bouffées d’air frais. J’aimais déjà écrire et je tenais mon journal de pensée mais là c’est encore mieux avec les sujets que tu abordes. Merci du fond du cœur.</p>\n                <div style=\"font-family:var(--font-accent);font-size:21px;line-height:1.2;color:var(--rose-deep)\">- Virginie</div>\n              </div>\n              <div style=\"border-top:1px solid var(--sage);padding-top:20px\">\n                <p style=\"font-family:var(--font-body);font-size:18px;color:var(--ink-soft);line-height:1.6;margin:0 0 16px\">J’adore vraiment vos mails et vos écrits, j’en ai déjà réalisé plusieurs et avec un retour en arrière sur mes écrits cela m’a permis de réaliser beaucoup de choses.</p>\n                <div style=\"font-family:var(--font-accent);font-size:21px;line-height:1.2;color:var(--rose-deep)\">- Nathalie</div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <sc-if value=\"{{ saisonAutomne }}\" hint-placeholder-val=\"{{ true }}\"><div style=\"display:flex;justify-content:center;padding:0 min(48px,5vw)\"><img loading=\"lazy\" decoding=\"async\" src=\"/assets/automne/guirlande-eglantier.webp\" width=\"1120\" height=\"254\" alt=\"Une guirlande d’églantier, petites fleurs roses et baies\" style=\"display:block;width:min(520px,84vw);height:auto\"></div></sc-if>\n        <div style=\"padding:84px min(48px,5vw);text-align:center\">\n          <div class=\"pp-eyebrow\" style=\"margin-bottom:18px\">7 permissions PIVOINE</div>\n          <p style=\"font-family:var(--font-display);font-weight:800;font-variation-settings:'opsz' 72;letter-spacing:-0.005em;font-size:clamp(28px,4.2vw,36px);color:var(--deep-olive);line-height:1.08;max-width:22ch;margin:0 auto 12px;text-wrap:balance\">Sept petites permissions, glissées dans chaque cahier.</p>\n          <div style=\"font-family:var(--font-accent);font-weight:700;font-size:26px;line-height:1.2;color:var(--rose-deep);transform:rotate(-2deg);margin:0 0 32px\">(un carnet, pas un programme)</div>\n          <div style=\"display:flex;justify-content:center;margin-bottom:30px\">\n            <x-import component-from-global-scope=\"PapierPivoineDesignSystem_2e8f20.PivoineBadge\" variant=\"strip\" hint-size=\"560px,64px\"></x-import>\n          </div>\n          <button type=\"button\" onClick=\"{{ goMethode }}\" style=\"display:inline-flex;align-items:center;gap:10px;padding:8px 26px 10px;border:3px solid var(--rose);border-radius:999px;color:var(--rose);font-family:var(--font-accent);font-weight:700;font-size:30px;line-height:1.1;transform:rotate(-2deg);background:transparent;cursor:pointer;transition:background-color 200ms ease,color 200ms ease\" style-hover=\"background:var(--rose);color:var(--paper-warm)\" style-focus=\"outline:2px solid var(--ink);outline-offset:4px\">Découvrir les 7 permissions</button>\n        </div>\n        <div style=\"border-top:1px solid var(--border-faint);padding:clamp(48px,8vw,76px) min(48px,5vw);text-align:center\">\n          <div class=\"pp-eyebrow\" style=\"margin-bottom:16px\">Ailleurs</div>\n          <h2 style=\"font-family:var(--font-display);font-weight:800;font-variation-settings:'opsz' 72;letter-spacing:-0.005em;font-size:clamp(30px,4.6vw,40px);color:var(--deep-olive);line-height:1.08;margin:0 0 10px\">Retrouve-moi <mark style=\"background:linear-gradient(transparent 55%, #EAD9AC 55%, #EAD9AC 92%, transparent 92%);color:inherit;padding:0 6px\">ailleurs</mark></h2>\n          <div style=\"font-family:var(--font-accent);font-weight:700;font-size:26px;line-height:1.2;color:var(--rose-deep);transform:rotate(-2deg);margin:0 0 36px\">(Bao y passe souvent)</div>\n          <div style=\"display:flex;flex-wrap:wrap;justify-content:center;gap:18px 22px\">\n            <a href=\"https://www.instagram.com/papierpivoine/\" target=\"_blank\" rel=\"noopener\" aria-label=\"Papier Pivoine sur Instagram\" style=\"display:flex;flex-direction:column;align-items:center;gap:8px;min-width:76px;text-decoration:none;color:var(--ink);transition:color 200ms ease\" style-hover=\"color:var(--rose-deep)\" style-focus=\"outline:2px solid var(--ink);outline-offset:4px;border-radius:12px\"><span style=\"width:58px;height:58px;box-sizing:border-box;border:2px solid currentColor;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--paper)\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3.5\" y=\"3.5\" width=\"17\" height=\"17\" rx=\"5\"></rect><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><circle cx=\"17\" cy=\"7\" r=\"0.6\" fill=\"currentColor\"></circle></svg></span><span style=\"font-family:var(--font-body);font-size:15px;font-weight:600\">Instagram</span></a>\n            <a href=\"https://www.tiktok.com/@papierpivoine\" target=\"_blank\" rel=\"noopener\" aria-label=\"Papier Pivoine sur TikTok\" style=\"display:flex;flex-direction:column;align-items:center;gap:8px;min-width:76px;text-decoration:none;color:var(--ink);transition:color 200ms ease\" style-hover=\"color:var(--rose-deep)\" style-focus=\"outline:2px solid var(--ink);outline-offset:4px;border-radius:12px\"><span style=\"width:58px;height:58px;box-sizing:border-box;border:2px solid currentColor;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--paper)\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M13.5 3.5v11a3.5 3.5 0 1 1-3.5-3.5\"></path><path d=\"M13.5 3.5c.4 2.6 2.1 4.2 4.8 4.4\"></path></svg></span><span style=\"font-family:var(--font-body);font-size:15px;font-weight:600\">TikTok</span></a>\n            <a href=\"https://www.youtube.com/channel/UCGXAZmmLaKEP6ll7voftuNQ\" target=\"_blank\" rel=\"noopener\" aria-label=\"Papier Pivoine sur YouTube\" style=\"display:flex;flex-direction:column;align-items:center;gap:8px;min-width:76px;text-decoration:none;color:var(--ink);transition:color 200ms ease\" style-hover=\"color:var(--rose-deep)\" style-focus=\"outline:2px solid var(--ink);outline-offset:4px;border-radius:12px\"><span style=\"width:58px;height:58px;box-sizing:border-box;border:2px solid currentColor;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--paper)\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"2.5\" y=\"5.5\" width=\"19\" height=\"13\" rx=\"4\"></rect><path d=\"M10 9.3v5.4l4.6-2.7z\"></path></svg></span><span style=\"font-family:var(--font-body);font-size:15px;font-weight:600\">YouTube</span></a>\n            <a href=\"https://fr.pinterest.com/papierpivoine/\" target=\"_blank\" rel=\"noopener\" aria-label=\"Papier Pivoine sur Pinterest\" style=\"display:flex;flex-direction:column;align-items:center;gap:8px;min-width:76px;text-decoration:none;color:var(--ink);transition:color 200ms ease\" style-hover=\"color:var(--rose-deep)\" style-focus=\"outline:2px solid var(--ink);outline-offset:4px;border-radius:12px\"><span style=\"width:58px;height:58px;box-sizing:border-box;border:2px solid currentColor;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--paper)\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"8.5\"></circle><path d=\"M10.2 20.2l2-7.6\"></path><path d=\"M9.3 13.2c-.9-2.8 1-5.2 3.6-5.2 2.3 0 3.6 1.5 3.6 3.4 0 2.3-1.3 4.1-3.1 4.1-1 0-1.6-.7-1.4-1.6\"></path></svg></span><span style=\"font-family:var(--font-body);font-size:15px;font-weight:600\">Pinterest</span></a>\n            <a href=\"https://www.facebook.com/share/1Bue8nqYmf/?mibextid=wwXIfr\" target=\"_blank\" rel=\"noopener\" aria-label=\"Papier Pivoine sur Facebook\" style=\"display:flex;flex-direction:column;align-items:center;gap:8px;min-width:76px;text-decoration:none;color:var(--ink);transition:color 200ms ease\" style-hover=\"color:var(--rose-deep)\" style-focus=\"outline:2px solid var(--ink);outline-offset:4px;border-radius:12px\"><span style=\"width:58px;height:58px;box-sizing:border-box;border:2px solid currentColor;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--paper)\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M15.5 4h-2a3 3 0 0 0-3 3v13.5\"></path><path d=\"M7.5 11h7\"></path></svg></span><span style=\"font-family:var(--font-body);font-size:15px;font-weight:600\">Facebook</span></a>\n            <a href=\"https://www.threads.com/@papierpivoine?igshid=NTc4MTIwNjQ2YQ==\" target=\"_blank\" rel=\"noopener\" aria-label=\"Papier Pivoine sur Threads\" style=\"display:flex;flex-direction:column;align-items:center;gap:8px;min-width:76px;text-decoration:none;color:var(--ink);transition:color 200ms ease\" style-hover=\"color:var(--rose-deep)\" style-focus=\"outline:2px solid var(--ink);outline-offset:4px;border-radius:12px\"><span style=\"width:58px;height:58px;box-sizing:border-box;border:2px solid currentColor;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--paper)\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M16.3 11.3c-.3-2.4-1.9-3.8-4.2-3.8-2.5 0-4.1 1.8-4.1 4.5s1.6 4.5 4 4.5c2.2 0 3.7-1.3 3.7-3.3 0-1.7-1.3-2.8-3.2-2.8-1.7 0-2.8.9-2.8 2.1 0 1.1.9 1.8 2.1 1.8 2.4 0 3.4-2.2 3.4-4.6C15.2 5.6 13 3.5 12 3.5c-4.7 0-7.5 3.3-7.5 8.5s2.8 8.5 7.4 8.5c2.8 0 4.9-1.2 6.1-3.2\"></path></svg></span><span style=\"font-family:var(--font-body);font-size:15px;font-weight:600\">Threads</span></a>\n          </div>\n        </div>\n\n      </div>\n    </sc-if>\n\n    <!-- ═══════════ COLLECTION BATTERIE FAIBLE (route /programme/) ═══════════ -->\n    \n\n    <!-- ═══════════ CARNETS D'ÉCRITURE ═══════════ -->\n    \n\n    <!-- ═══════════ COLLECTION SAISONS TRANQUILLES (route /saisons-tranquilles/) ═══════════ -->\n    \n\n    <!-- ═══════════ 7 PERMISSIONS PIVOINE ═══════════ -->\n    \n\n    <!-- ═══════════ À PROPOS ═══════════ -->\n    \n\n    <!-- ═══════════ NEWSLETTER ═══════════ -->\n    \n\n\n    <!-- ═══════════ LIENS ═══════════ -->\n    \n\n    <!-- ═══════════ BAND (toutes pages sauf newsletter) ═══════════ -->\n    <sc-if value=\"{{ showBand }}\" hint-placeholder-val=\"{{ true }}\">\n      <div style=\"background:var(--blush)\">\n        <div style=\"max-width:720px;margin:0 auto;padding:80px min(48px,5vw);text-align:center\">\n          <h2 style=\"font-family:var(--font-display);font-weight:800;font-variation-settings:'opsz' 72;letter-spacing:-0.005em;line-height:1.08;font-size:clamp(30px,4.6vw,40px);color:var(--deep-olive);margin:0 0 18px\">Commence par <mark style=\"background:linear-gradient(transparent 55%, #EAD9AC 55%, #EAD9AC 92%, transparent 92%);color:inherit;padding:0 6px\">un cadeau</mark></h2>\n          <p style=\"font-family:var(--font-body);font-size:18px;color:var(--ink-soft);line-height:1.6;max-width:52ch;margin:0 auto 30px\">Une fois par mois, je t’écris : le thème de la saison, mes réflexions, un exercice d’écriture guidé, et les nouveaux cahiers en premier. Pour t’accueillir, je t’offre la première semaine de Mental Léger, pour vider ta tête le soir.</p>\n          <p style=\"font-family:var(--font-body);font-size:17px;font-style:italic;color:var(--ink-soft);line-height:1.6;max-width:46ch;margin:0 auto 28px\">« Merci pour tes newsletters qui sont de réelles bouffées d’air frais. » · Virginie</p>\n          <sc-if value=\"{{ notSubscribed }}\" hint-placeholder-val=\"{{ true }}\">\n            <div style=\"display:flex;justify-content:center\">\n              <button type=\"button\" onClick=\"{{ subscribe }}\" style=\"display:inline-flex;align-items:center;justify-content:center;gap:10px;box-sizing:border-box;max-width:100%;text-align:center;padding:8px 26px 10px;border:3px solid var(--rose);border-radius:999px;color:var(--rose);font-family:var(--font-accent);font-weight:700;font-size:30px;line-height:1.1;transform:rotate(-2deg);background:transparent;cursor:pointer;text-decoration:none;transition:background-color 200ms ease,color 200ms ease\" style-hover=\"background:var(--rose);color:var(--paper-warm)\" style-focus=\"outline:2px solid var(--ink);outline-offset:4px\">Recevoir le cadeau</button>\n            </div>\n            <p style=\"font-family:var(--font-body);font-size:12px;color:var(--ink-faint);margin:16px 0 0\">C’est gratuit. Tu peux te désinscrire quand tu veux. <span onClick=\"{{ goNewsletter }}\" style=\"color:var(--rose);cursor:pointer;text-decoration:underline;text-underline-offset:3px\">Voir ce qu’il y a dedans</span></p>\n          </sc-if>\n          <sc-if value=\"{{ subscribed }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:var(--paper);border:1px solid var(--border-faint);border-radius:14px;padding:28px 32px;max-width:440px;margin:0 auto\">\n              <p style=\"font-family:var(--font-body);font-size:18px;color:var(--deep-olive);line-height:1.6;margin:0 0 6px\">C’est noté. La première semaine de Mental Léger est en route vers ta boîte mail.</p>\n              <p style=\"font-family:var(--font-body);font-size:13px;color:var(--ink-faint);margin:0\">Si tu ne la vois pas, regarde dans les courriers indésirables.</p>\n            </div>\n          </sc-if>\n        </div>\n        <sc-if value=\"{{ saisonAutomne }}\" hint-placeholder-val=\"{{ true }}\"><div style=\"display:flex;justify-content:center;padding:0 min(48px,5vw)\"><img loading=\"lazy\" decoding=\"async\" src=\"/assets/automne/herbes-sechees.webp\" width=\"1000\" height=\"384\" alt=\"Une rangée d’herbes séchées et de fleurs des champs\" style=\"display:block;width:min(900px,100%);height:auto\"></div></sc-if>\n      </div>\n    </sc-if>\n\n  </main>\n\n  <a data-formkit-toggle=\"638990c016\" href=\"https://camelianguyen.kit.com/638990c016\" style=\"display:none\" aria-hidden=\"true\">La newsletter</a>\n\n  <!-- ═══════════ FOOTER ═══════════ -->\n  <sc-if value=\"{{ showChrome }}\" hint-placeholder-val=\"{{ true }}\">\n  <footer style=\"background:var(--paper-warm);border-top:1px solid var(--border-faint);padding:56px min(48px,5vw) 40px\">\n    <div style=\"max-width:1180px;margin:0 auto\">\n      <div style=\"display:flex;justify-content:space-between;align-items:flex-start;gap:32px;flex-wrap:wrap\">\n        <div>\n          <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:8px\"><span style=\"font-family:var(--font-display);font-weight:800;font-variation-settings:'opsz' 72;font-size:21px;color:var(--deep-olive);letter-spacing:-0.005em\">Papier Pivoine</span><svg width=\"30\" height=\"30\" viewBox=\"0 0 120 120\" fill=\"none\" stroke=\"#E26D5F\" stroke-width=\"3.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M62.7,49.8 C66.1,48.3 73.1,61.7 69.5,62.6 C71.8,66.2 60.0,73.3 57.4,69.7 C53.2,71.8 46.4,60.3 50.3,57.4 C49.8,53.3 61.7,47.9 62.7,51.8 M57.1,43.6 C46.3,12.7 80.5,14.0 65.0,44.5 M69.6,46.7 C81.8,18.7 103.5,44.8 74.8,52.4 M77.3,59.3 C107.0,50.6 98.2,86.2 75.1,67.9 M71.5,72.6 C98.7,90.0 68.7,109.6 64.6,76.1 M56.0,75.8 C55.5,106.4 22.2,90.6 49.0,71.4 M46.0,67.6 C19.3,88.3 11.6,52.1 44.5,60.0 M44.9,52.5 C15.6,45.7 36.2,19.9 49.7,47.0\"></path></svg></div>\n          <p style=\"font-family:var(--font-body);font-style:italic;color:var(--rose-deep);margin:0;font-size:15px;max-width:32ch;line-height:1.5\">Trop sensible, trop fatiguée, trop bien sous mon plaid.</p>\n        </div>\n        <div style=\"display:flex;gap:40px 64px;flex-wrap:wrap\">\n          <div>\n            <div class=\"pp-eyebrow\" style=\"margin-bottom:14px\">Découvrir</div>\n            <div style=\"display:flex;flex-direction:column;gap:9px;font-family:var(--font-body);font-size:14px;color:var(--ink-soft)\">\n              <span onClick=\"{{ goActivites }}\" style=\"cursor:pointer\">Saisons tranquilles</span>\n              <span onClick=\"{{ goProgramme }}\" style=\"cursor:pointer\">Batterie faible</span>\n              <span onClick=\"{{ goMethode }}\" style=\"cursor:pointer\">7 permissions PIVOINE</span>\n            </div>\n          </div>\n          <div>\n            <div class=\"pp-eyebrow\" style=\"margin-bottom:14px\">Rester en lien</div>\n            <div style=\"display:flex;flex-direction:column;gap:9px;font-family:var(--font-body);font-size:14px;color:var(--ink-soft)\">\n              <span onClick=\"{{ goNewsletter }}\" style=\"cursor:pointer\">Newsletter gratuite</span>\n              <a href=\"https://fr.pinterest.com/papierpivoine/\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--ink-soft);text-decoration:none\">Pinterest</a>\n              <a href=\"https://www.instagram.com/papierpivoine/\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--ink-soft);text-decoration:none\">Instagram</a>\n              <a href=\"https://www.tiktok.com/@papierpivoine\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--ink-soft);text-decoration:none\">TikTok</a>\n              <a href=\"https://www.youtube.com/channel/UCGXAZmmLaKEP6ll7voftuNQ\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--ink-soft);text-decoration:none\">YouTube</a>\n              <a href=\"https://www.facebook.com/share/1Bue8nqYmf/?mibextid=wwXIfr\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--ink-soft);text-decoration:none\">Facebook</a>\n              <a href=\"https://www.threads.com/@papierpivoine?igshid=NTc4MTIwNjQ2YQ==\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--ink-soft);text-decoration:none\">Threads</a>\n              <span onClick=\"{{ goApropos }}\" style=\"cursor:pointer\">À propos</span>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div style=\"height:1px;background:var(--border-faint);margin:36px 0\"></div>\n      <p style=\"font-family:var(--font-body);font-size:12px;color:var(--ink-faint);margin:0 0 8px;max-width:70ch;line-height:1.6\">Ce que tu trouves ici est une pratique douce, pas un soin. Ce n’est pas un substitut à un accompagnement professionnel. Si tu traverses une période difficile, parles-en à un professionnel de santé.</p>\n      <p style=\"font-family:var(--font-body);font-size:12px;color:var(--ink-faint);margin:0\">© 2026 Papier Pivoine · Camélia Nguyen</p>\n    </div>\n  </footer>\n  </sc-if>\n\n  <template id=\"__bundler_thumbnail\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 100\"><rect width=\"100\" height=\"100\" fill=\"#F8E7E1\"></rect><text x=\"50\" y=\"60\" text-anchor=\"middle\" font-family=\"Georgia, serif\" font-size=\"26\" letter-spacing=\"2\" fill=\"#C47A78\">PP</text></svg></template>\n\n</div>\n"}
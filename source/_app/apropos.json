{"tpl":"\n<helmet>\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/colors.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/typography.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/spacing.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/effects.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/tokens/base.css\">\n  <link rel=\"stylesheet\" href=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/styles.css\">\n  <script src=\"/_ds/papier-pivoine-design-system-2e8f201d-b7b2-4ba9-95cb-6dcf33a643b1/_ds_bundle.js\"></script>\n  <link rel=\"preload\" href=\"/assets/fonts/fraunces-800-latin.woff2\" as=\"font\" type=\"font/woff2\" crossorigin=\"anonymous\">\n  <link rel=\"preload\" href=\"/assets/fonts/nunito-sans-latin.woff2\" as=\"font\" type=\"font/woff2\" crossorigin=\"anonymous\">\n  <style>\n    @font-face { font-family: 'Caveat'; font-style: normal; font-weight: 400 600; font-display: swap; src: url(/assets/fonts/caveat-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Caveat'; font-style: normal; font-weight: 400 600; font-display: swap; src: url(/assets/fonts/caveat-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 300 600; font-display: swap; src: url(/assets/fonts/fraunces-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 300 600; font-display: swap; src: url(/assets/fonts/fraunces-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    @font-face { font-family: 'Nunito Sans'; font-style: normal; font-weight: 300 700; font-display: swap; src: url(/assets/fonts/nunito-sans-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Nunito Sans'; font-style: normal; font-weight: 300 700; font-display: swap; src: url(/assets/fonts/nunito-sans-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    @font-face { font-family: 'Caveat'; font-style: normal; font-weight: 700; font-display: swap; src: url(/assets/fonts/caveat-700-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Caveat'; font-style: normal; font-weight: 700; font-display: swap; src: url(/assets/fonts/caveat-700-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    @font-face { font-family: 'Fraunces'; font-style: italic; font-weight: 700; font-display: swap; src: url(/assets/fonts/fraunces-italic-700-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Fraunces'; font-style: italic; font-weight: 700; font-display: swap; src: url(/assets/fonts/fraunces-italic-700-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 800; font-display: swap; src: url(/assets/fonts/fraunces-800-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }\n    @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 800; font-display: swap; src: url(/assets/fonts/fraunces-800-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }\n    :root {\n      --font-display: 'Fraunces', Georgia, serif;\n      --font-body: 'Nunito Sans', system-ui, sans-serif;\n      --font-accent: 'Caveat', cursive;\n    }\n    /* Saison : automne par défaut (aucun attribut), \"neutre\" = palette d'origine. Réglage : prop season. */\n    /* Palette d'automne : mêmes rôles que la palette d'origine, teintes terre cuite, ocre et olive brun. */\n    html:not([data-season=\"neutre\"]) {\n      --blush: #F7D9D3; --blush-deep: #F0C7BF; --pale-rose: #DDA9A0;\n      --rose: #E26D5F; --rose-deep: #BF5548;\n      --sage: #B2BD88; --sage-soft: #EEF0DE; --olive-soft: #E9ECD9;\n      --deep-olive: #33321E; --ink: #33321E; --ink-soft: #46452F; --ink-faint: #6B6953;\n      --paper: #FFFCFA; --paper-warm: #FCF6F2; --border-faint: #EDE1D6; --sand: #EAD9AC;\n      --text-on-accent: #FFFCFA;\n    }\n    body { margin: 0; background: var(--paper-warm, #FCF6F2); }\n    a { color: var(--rose-deep); }\n    a:hover { color: var(--ink); }\n    mark { -webkit-box-decoration-break: clone; box-decoration-break: clone; }\n    ::selection { background: var(--blush); }\n    /* Pop-up Kit : autoriser le défilement sur mobile (leur fenêtre dépasse l'écran) */\n    @media (max-width: 700px) {\n      .formkit-overlay, .formkit-modal { overflow-y: auto !important; -webkit-overflow-scrolling: touch !important; align-items: flex-start !important; }\n      .formkit-modal { max-height: 100dvh !important; }\n      .formkit-modal .formkit-form, .formkit-modal > div { max-height: none !important; }\n    }\n    /* Navigation : liens en ligne sur ordinateur, menu replié sur mobile */\n    .pp-burger { display: none; }\n    @media (max-width: 700px) {\n      .pp-nav-desktop { display: none !important; }\n      .pp-burger { display: inline-flex !important; }\n    }\n    @media (min-width: 701px) {\n      .pp-nav-mobile { display: none !important; }\n    }\n    /* Mobile : zones cliquables d'au moins 44 px */\n    @media (max-width: 700px) {\n      .pp-nav-mobile > span, .pp-nav-mobile > * > span { min-height: 44px; display: flex; align-items: center; box-sizing: border-box; }\n      header > span:first-child { min-height: 44px; display: inline-flex; align-items: center; }\n      main button, footer button { min-height: 44px; }\n      footer [style*=\"cursor: pointer\"], footer [style*=\"cursor:pointer\"], footer a { min-height: 44px; display: flex; align-items: center; }\n    }\n  </style>\n</helmet>\n\n<div style=\"min-height:100vh;display:flex;flex-direction:column;background:var(--paper-warm)\">\n\n  <!-- ═══════════ HEADER ═══════════ -->\n  <sc-if value=\"{{ showChrome }}\" hint-placeholder-val=\"{{ true }}\">\n  <header style=\"display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px 24px;padding:18px min(48px,5vw);border-bottom:1px solid var(--border-faint);background:var(--paper-warm);position:sticky;top:0;z-index:10\">\n    <span onClick=\"{{ goAccueil }}\" style=\"cursor:pointer;display:inline-flex;align-items:center;gap:10px;font-family:var(--font-display);font-weight:800;font-variation-settings:'opsz' 72;font-size:23px;color:var(--deep-olive);letter-spacing:-0.005em\"><img src=\"/assets/logo-papier-pivoine.jpg\" width=\"400\" height=\"400\" alt=\"\" aria-hidden=\"true\" style=\"display:block;width:40px;height:40px;border-radius:50%;border:2px solid var(--ink);box-sizing:border-box;flex:none\">Papier Pivoine</span>\n    <span class=\"pp-burger\" onClick=\"{{ toggleMenu }}\" role=\"button\" aria-label=\"Menu\" style=\"display:none;align-items:center;justify-content:center;width:44px;height:44px;margin:-8px -10px;cursor:pointer\">\n      <sc-if value=\"{{ menuClosed }}\" hint-placeholder-val=\"{{ true }}\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--deep-olive)\" stroke-width=\"1.4\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M3 8h18\"></path><path d=\"M3 16h18\"></path></svg></sc-if>\n      <sc-if value=\"{{ menuOpen }}\" hint-placeholder-val=\"{{ false }}\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--deep-olive)\" stroke-width=\"1.4\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M6 6l12 12\"></path><path d=\"M18 6L6 18\"></path></svg></sc-if>\n    </span>\n    <nav class=\"pp-nav-desktop\" style=\"display:flex;gap:6px 24px;align-items:center;flex-wrap:wrap\">\n      <span onClick=\"{{ goAccueil }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCAccueil }};border-bottom:1px solid {{ navUAccueil }}\">Accueil</span>\n      \n      <span onClick=\"{{ goActivites }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCActivites }};border-bottom:1px solid {{ navUActivites }}\">Saisons tranquilles</span>\n      <span onClick=\"{{ goProgramme }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCProgramme }};border-bottom:1px solid {{ navUProgramme }}\">Batterie faible</span>\n      <span onClick=\"{{ goMethode }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCMethode }};border-bottom:1px solid {{ navUMethode }}\">7 permissions PIVOINE</span>\n      <span onClick=\"{{ goApropos }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCApropos }};border-bottom:1px solid {{ navUApropos }}\">À propos</span>\n      <span onClick=\"{{ goNewsletter }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:14px;padding:4px 0;color:{{ navCNewsletter }};border-bottom:1px solid {{ navUNewsletter }}\">Newsletter</span>\n    </nav>\n    <sc-if value=\"{{ menuOpen }}\" hint-placeholder-val=\"{{ false }}\">\n      <nav class=\"pp-nav-mobile\" style=\"flex-basis:100%;display:flex;flex-direction:column;padding:2px 0 8px\">\n        <span onClick=\"{{ goAccueil }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCAccueil }};border-top:1px solid var(--border-faint)\">Accueil</span>\n        \n        <span onClick=\"{{ goActivites }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCActivites }};border-top:1px solid var(--border-faint)\">Saisons tranquilles</span>\n        <span onClick=\"{{ goProgramme }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCProgramme }};border-top:1px solid var(--border-faint)\">Batterie faible</span>\n        <span onClick=\"{{ goMethode }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCMethode }};border-top:1px solid var(--border-faint)\">7 permissions PIVOINE</span>\n        <span onClick=\"{{ goApropos }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCApropos }};border-top:1px solid var(--border-faint)\">À propos</span>\n        <span onClick=\"{{ goNewsletter }}\" style=\"cursor:pointer;font-family:var(--font-body);font-size:16px;padding:13px 2px;color:{{ navCNewsletter }};border-top:1px solid var(--border-faint)\">Newsletter</span>\n      </nav>\n    </sc-if>\n  </header>\n  </sc-if>\n\n  <main style=\"flex:1\">\n\n    <!-- ═══════════ ACCUEIL ═══════════ -->\n    \n\n    <!-- ═══════════ COLLECTION BATTERIE FAIBLE (route /programme/) ═══════════ -->\n    \n\n    <!-- ═══════════ CARNETS D'ÉCRITURE ═══════════ -->\n    \n\n    <!-- ═══════════ COLLECTION SAISONS TRANQUILLES (route /saisons-tranquilles/) ═══════════ -->\n    \n\n    <!-- ═══════════ 7 PERMISSIONS PIVOINE ═══════════ -->\n    \n\n    <!-- ═══════════ À PROPOS ═══════════ -->\n    <sc-if value=\"{{ isApropos }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"À propos\">\n\n        <div style=\"padding:clamp(56px,9vw,88px) min(48px,5vw) 56px;background-color:#FCF6F2;background-image:radial-gradient(#E9DCCB 1.6px, transparent 1.8px);background-size:32px 32px;text-align:center\">\n          <sc-if value=\"{{ saisonAutomne }}\" hint-placeholder-val=\"{{ true }}\"><div style=\"display:flex;justify-content:center;margin-bottom:24px\"><img src=\"/assets/logo-papier-pivoine.jpg\" width=\"400\" height=\"400\" alt=\"Camélia et son chat Bao, une tasse de thé à la main\" style=\"display:block;width:min(200px,50vw);height:auto;border-radius:50%\"></div></sc-if>\n          <div class=\"pp-eyebrow\" style=\"margin-bottom:20px\">À propos</div>\n          <h1 style=\"font-family:var(--font-display);font-weight:800;font-variation-settings:'opsz' 72;letter-spacing:-0.005em;line-height:1.08;font-size:clamp(36px,6vw,54px);color:var(--deep-olive);margin:0 auto\">Je m’appelle <mark style=\"background:linear-gradient(transparent 55%, #EAD9AC 55%, #EAD9AC 92%, transparent 92%);color:inherit;padding:0 6px\">Camélia</mark>.</h1>\n        </div>\n\n        <div style=\"background:var(--paper);border-top:1px solid var(--border-faint);border-bottom:1px solid var(--border-faint);padding:84px min(48px,5vw);display:flex;flex-direction:column;align-items:center;gap:48px\">\n          <x-import component-from-global-scope=\"PapierPivoineDesignSystem_2e8f20.LetterBlock\" signature=\"\" hint-size=\"620px,900px\">\n            <p style=\"margin:0 0 1.3em\">Je suis contente que tu sois là. Papier Pivoine, c’est moi : j’imagine les cahiers, j’écris chaque page, je choisis chaque jeu et chaque couleur.</p>\n            <p style=\"margin:0 0 1.3em\">Je suis née au Vietnam. J’étais une enfant discrète et silencieuse, souvent seule avec un livre ou un magazine, et très bien comme ça. À 18 ans, je suis arrivée en France pour mes études. J’y vis depuis plus de vingt ans, dans une petite ville calme près de Toulouse.</p>\n            <p style=\"margin:0 0 1.3em\">Pendant longtemps, je me suis trop adaptée. À l’école, au travail, partout. Dans l’open space, je souriais et je faisais ce qu’il fallait. Le soir, tout ce que j’avais retenu dans la journée continuait de tourner dans ma tête, parfois jusqu’à trois heures du matin. Je ne suis pas sûre d’avoir déjà été vraiment moi. Il y a eu une année plus dure, dont je ne parle pas facilement. C’est là que j’ai arrêté de faire comme si tout allait bien.</p>\n            <p style=\"margin:0 0 1.3em\">Un mot m’a aidée : hypersensible. Je l’ai découvert dans les travaux de la psychologue Elaine Aron. Ce que je prenais pour un défaut avait un nom. Je n’étais pas la seule, et toi non plus.</p>\n            <p style=\"margin:0 0 1.3em\">Ce qui m’aide tient en peu de choses. Écrire ce qui pèse, en listes désordonnées ou en longues lettres. Colorier sans réfléchir. Une grille de mots croisés le dimanche soir. Mon thé vert du matin, mes plantes sur le balcon, mon chat Bao qui dort à côté de moi pendant que je travaille.</p>\n            <p style=\"margin:0 0 1.3em\">On m’a accompagnée pendant des années, et parler m’a fait du bien. Mais entre deux rendez-vous, j’avais besoin de quelque chose à portée de main, pour les soirs où ça déborde. Alors je l’ai fait, d’abord pour moi : un cahier où l’on peut écrire, colorier ou jouer, selon l’énergie du soir. Ça ne m’a pas réparée. Mais ma tête était moins pleine, et c’est resté. Papier Pivoine est né comme ça.</p>\n            <p style=\"margin:0\">Si tu sens tout très fort, si le monde te fatigue vite et si ton plaid te tente plus qu’une soirée, ces cahiers sont pensés pour toi. Il n’y a rien qui ne va pas chez toi. Tu ne verras pas mon visage ici, je suis quelqu’un de discret. Mais dans chaque page, il y a beaucoup de moi.</p>\n          </x-import>\n          <div style=\"display:flex;flex-direction:column;align-items:center;gap:12px\">\n            <img src=\"/assets/bao.jpg\" width=\"400\" height=\"400\" loading=\"lazy\" alt=\"Bao, chat roux et blanc, allongé sur un plaid rose\" style=\"width:180px;height:180px;border-radius:50%;object-fit:cover;border:1px solid var(--border-faint);box-shadow:0 14px 28px rgba(101,109,68,0.16)\">\n            <span style=\"font-family:var(--font-accent);font-weight:700;font-size:26px;line-height:1.2;color:var(--rose-deep);transform:rotate(-2deg)\">(Bao, mon collègue d’écriture)</span>\n          </div>\n          <button type=\"button\" onClick=\"{{ goNewsletter }}\" style=\"display:inline-flex;align-items:center;justify-content:center;gap:10px;box-sizing:border-box;max-width:100%;text-align:center;padding:8px 26px 10px;border:3px solid var(--rose);border-radius:999px;color:var(--rose);font-family:var(--font-accent);font-weight:700;font-size:30px;line-height:1.1;transform:rotate(-2deg);background:transparent;cursor:pointer;text-decoration:none;transition:background-color 200ms ease,color 200ms ease\" style-hover=\"background:var(--rose);color:var(--paper-warm)\" style-focus=\"outline:2px solid var(--ink);outline-offset:4px\">Recevoir la lettre</button>\n          <div style=\"display:flex;flex-direction:column;align-items:center;gap:4px\"><div style=\"font-family:var(--font-accent);font-size:34px;line-height:1.1;color:var(--rose)\">Camélia</div><svg width=\"56\" height=\"56\" viewBox=\"0 0 120 120\" fill=\"none\" stroke=\"#E26D5F\" stroke-width=\"3.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M62.7,49.8 C66.1,48.3 73.1,61.7 69.5,62.6 C71.8,66.2 60.0,73.3 57.4,69.7 C53.2,71.8 46.4,60.3 50.3,57.4 C49.8,53.3 61.7,47.9 62.7,51.8 M57.1,43.6 C46.3,12.7 80.5,14.0 65.0,44.5 M69.6,46.7 C81.8,18.7 103.5,44.8 74.8,52.4 M77.3,59.3 C107.0,50.6 98.2,86.2 75.1,67.9 M71.5,72.6 C98.7,90.0 68.7,109.6 64.6,76.1 M56.0,75.8 C55.5,106.4 22.2,90.6 49.0,71.4 M46.0,67.6 C19.3,88.3 11.6,52.1 44.5,60.0 M44.9,52.5 C15.6,45.7 36.2,19.9 49.7,47.0\"></path></svg></div>\n        </div>\n\n        <div style=\"padding:76px min(48px,5vw) 84px;text-align:center\">\n          <div class=\"pp-eyebrow\" style=\"margin-bottom:14px\">La suite de cette histoire</div>\n          <p style=\"font-family:var(--font-body);font-size:18px;color:var(--ink-soft);line-height:1.6;max-width:40ch;margin:0 auto 24px\">Les 7 permissions PIVOINE sont nées de ces soirées-là. Elles traversent chaque cahier.</p>\n          <button type=\"button\" onClick=\"{{ goMethode }}\" style=\"display:inline-flex;align-items:center;justify-content:center;gap:10px;box-sizing:border-box;max-width:100%;text-align:center;padding:8px 26px 10px;border:3px solid var(--rose);border-radius:999px;color:var(--rose);font-family:var(--font-accent);font-weight:700;font-size:30px;line-height:1.1;transform:rotate(-2deg);background:transparent;cursor:pointer;text-decoration:none;transition:background-color 200ms ease,color 200ms ease\" style-hover=\"background:var(--rose);color:var(--paper-warm)\" style-focus=\"outline:2px solid var(--ink);outline-offset:4px\">Lire les 7 permissions</button>\n          <p style=\"font-family:var(--font-body);font-size:16px;color:var(--ink-soft);line-height:1.6;max-width:40ch;margin:40px auto 0\">Tu as envie de me raconter quelque chose, ou tu as une question sur un cahier ? Tu peux m’écrire à <a href=\"{{ mailHref }}\" style=\"color:var(--rose-deep);text-decoration:underline;text-underline-offset:3px\">{{ mailText }}</a>. Je lis tout, et je réponds moi-même.</p>\n        </div>\n\n      </div>\n    </sc-if>\n\n    <!-- ═══════════ NEWSLETTER ═══════════ -->\n    \n\n\n    <!-- ═══════════ LIENS ═══════════ -->\n    \n\n    <!-- ═══════════ BAND (toutes pages sauf newsletter) ═══════════ -->\n    <sc-if value=\"{{ showBand }}\" hint-placeholder-val=\"{{ true }}\">\n      <div style=\"background:var(--blush)\">\n        <div style=\"max-width:720px;margin:0 auto;padding:80px min(48px,5vw);text-align:center\">\n          <h2 style=\"font-family:var(--font-display);font-weight:800;font-variation-settings:'opsz' 72;letter-spacing:-0.005em;line-height:1.08;font-size:clamp(30px,4.6vw,40px);color:var(--deep-olive);margin:0 0 18px\">Commence par <mark style=\"background:linear-gradient(transparent 55%, #EAD9AC 55%, #EAD9AC 92%, transparent 92%);color:inherit;padding:0 6px\">un cadeau</mark></h2>\n          <p style=\"font-family:var(--font-body);font-size:18px;color:var(--ink-soft);line-height:1.6;max-width:52ch;margin:0 auto 30px\">Une fois par mois, je t’écris : le thème de la saison, mes réflexions, un exercice d’écriture guidé, et les nouveaux cahiers en premier. Pour t’accueillir, je t’offre la première semaine de Mental Léger, pour vider ta tête le soir.</p>\n          <p style=\"font-family:var(--font-body);font-size:17px;font-style:italic;color:var(--ink-soft);line-height:1.6;max-width:46ch;margin:0 auto 28px\">« Merci pour tes newsletters qui sont de réelles bouffées d’air frais. » · Virginie</p>\n          <sc-if value=\"{{ notSubscribed }}\" hint-placeholder-val=\"{{ true }}\">\n            <div style=\"display:flex;justify-content:center\">\n              <button type=\"button\" onClick=\"{{ subscribe }}\" style=\"display:inline-flex;align-items:center;justify-content:center;gap:10px;box-sizing:border-box;max-width:100%;text-align:center;padding:8px 26px 10px;border:3px solid var(--rose);border-radius:999px;color:var(--rose);font-family:var(--font-accent);font-weight:700;font-size:30px;line-height:1.1;transform:rotate(-2deg);background:transparent;cursor:pointer;text-decoration:none;transition:background-color 200ms ease,color 200ms ease\" style-hover=\"background:var(--rose);color:var(--paper-warm)\" style-focus=\"outline:2px solid var(--ink);outline-offset:4px\">Recevoir le cadeau</button>\n            </div>\n            <p style=\"font-family:var(--font-body);font-size:12px;color:var(--ink-faint);margin:16px 0 0\">C’est gratuit. Tu peux te désinscrire quand tu veux. <span onClick=\"{{ goNewsletter }}\" style=\"color:var(--rose);cursor:pointer;text-decoration:underline;text-underline-offset:3px\">Voir ce qu’il y a dedans</span></p>\n          </sc-if>\n          <sc-if value=\"{{ subscribed }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:var(--paper);border:1px solid var(--border-faint);border-radius:14px;padding:28px 32px;max-width:440px;margin:0 auto\">\n              <p style=\"font-family:var(--font-body);font-size:18px;color:var(--deep-olive);line-height:1.6;margin:0 0 6px\">C’est noté. La première semaine de Mental Léger est en route vers ta boîte mail.</p>\n              <p style=\"font-family:var(--font-body);font-size:13px;color:var(--ink-faint);margin:0\">Si tu ne la vois pas, regarde dans les courriers indésirables.</p>\n            </div>\n          </sc-if>\n        </div>\n        <sc-if value=\"{{ saisonAutomne }}\" hint-placeholder-val=\"{{ true }}\"><div style=\"display:flex;justify-content:center;padding:0 min(48px,5vw)\"><img loading=\"lazy\" decoding=\"async\" src=\"/assets/automne/herbes-sechees.webp\" width=\"1000\" height=\"384\" alt=\"Une rangée d’herbes séchées et de fleurs des champs\" style=\"display:block;width:min(900px,100%);height:auto\"></div></sc-if>\n      </div>\n    </sc-if>\n\n  </main>\n\n  <a data-formkit-toggle=\"638990c016\" href=\"https://camelianguyen.kit.com/638990c016\" style=\"display:none\" aria-hidden=\"true\">La newsletter</a>\n\n  <!-- ═══════════ FOOTER ═══════════ -->\n  <sc-if value=\"{{ showChrome }}\" hint-placeholder-val=\"{{ true }}\">\n  <footer style=\"background:var(--paper-warm);border-top:1px solid var(--border-faint);padding:56px min(48px,5vw) 40px\">\n    <div style=\"max-width:1180px;margin:0 auto\">\n      <div style=\"display:flex;justify-content:space-between;align-items:flex-start;gap:32px;flex-wrap:wrap\">\n        <div>\n          <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:8px\"><span style=\"font-family:var(--font-display);font-weight:800;font-variation-settings:'opsz' 72;font-size:21px;color:var(--deep-olive);letter-spacing:-0.005em\">Papier Pivoine</span><svg width=\"30\" height=\"30\" viewBox=\"0 0 120 120\" fill=\"none\" stroke=\"#E26D5F\" stroke-width=\"3.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M62.7,49.8 C66.1,48.3 73.1,61.7 69.5,62.6 C71.8,66.2 60.0,73.3 57.4,69.7 C53.2,71.8 46.4,60.3 50.3,57.4 C49.8,53.3 61.7,47.9 62.7,51.8 M57.1,43.6 C46.3,12.7 80.5,14.0 65.0,44.5 M69.6,46.7 C81.8,18.7 103.5,44.8 74.8,52.4 M77.3,59.3 C107.0,50.6 98.2,86.2 75.1,67.9 M71.5,72.6 C98.7,90.0 68.7,109.6 64.6,76.1 M56.0,75.8 C55.5,106.4 22.2,90.6 49.0,71.4 M46.0,67.6 C19.3,88.3 11.6,52.1 44.5,60.0 M44.9,52.5 C15.6,45.7 36.2,19.9 49.7,47.0\"></path></svg></div>\n          <p style=\"font-family:var(--font-body);font-style:italic;color:var(--rose-deep);margin:0;font-size:15px;max-width:32ch;line-height:1.5\">Trop sensible, trop fatiguée, trop bien sous mon plaid.</p>\n        </div>\n        <div style=\"display:flex;gap:40px 64px;flex-wrap:wrap\">\n          <div>\n            <div class=\"pp-eyebrow\" style=\"margin-bottom:14px\">Découvrir</div>\n            <div style=\"display:flex;flex-direction:column;gap:9px;font-family:var(--font-body);font-size:14px;color:var(--ink-soft)\">\n              <span onClick=\"{{ goActivites }}\" style=\"cursor:pointer\">Saisons tranquilles</span>\n              <span onClick=\"{{ goProgramme }}\" style=\"cursor:pointer\">Batterie faible</span>\n              <span onClick=\"{{ goMethode }}\" style=\"cursor:pointer\">7 permissions PIVOINE</span>\n              <span onClick=\"{{ goApropos }}\" style=\"cursor:pointer\">À propos</span>\n            </div>\n          </div>\n          <div>\n            <div class=\"pp-eyebrow\" style=\"margin-bottom:14px\">Rester en lien</div>\n            <div style=\"display:flex;flex-direction:column;gap:9px;font-family:var(--font-body);font-size:14px;color:var(--ink-soft)\">\n              <span onClick=\"{{ goNewsletter }}\" style=\"cursor:pointer\">Newsletter gratuite</span>\n              <a href=\"{{ mailHref }}\" style=\"color:var(--ink-soft);text-decoration:none\">Écrire à Camélia</a>\n              <a href=\"https://fr.pinterest.com/papierpivoine/\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--ink-soft);text-decoration:none\">Pinterest</a>\n              <a href=\"https://www.youtube.com/@papierpivoine/shorts\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--ink-soft);text-decoration:none\">YouTube</a>\n              <a href=\"https://www.tiktok.com/@papierpivoine\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--ink-soft);text-decoration:none\">TikTok</a>\n              <a href=\"https://www.instagram.com/papierpivoine/\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--ink-soft);text-decoration:none\">Instagram</a>\n              <a href=\"https://www.facebook.com/share/1Bue8nqYmf/?mibextid=wwXIfr\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--ink-soft);text-decoration:none\">Facebook</a>\n              <a href=\"https://www.threads.com/@papierpivoine?igshid=NTc4MTIwNjQ2YQ==\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--ink-soft);text-decoration:none\">Threads</a>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div style=\"height:1px;background:var(--border-faint);margin:36px 0\"></div>\n      <p style=\"font-family:var(--font-body);font-size:12px;color:var(--ink-faint);margin:0 0 8px;max-width:70ch;line-height:1.6\">Ce que tu trouves ici est une pratique douce, pas un soin. Ce n’est pas un substitut à un accompagnement professionnel. Si tu traverses une période difficile, parles-en à un professionnel de santé.</p>\n      <p style=\"font-family:var(--font-body);font-size:12px;color:var(--ink-faint);margin:0\">© 2026 Papier Pivoine · Camélia Nguyen</p>\n    </div>\n  </footer>\n  </sc-if>\n\n  <template id=\"__bundler_thumbnail\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 100\"><rect width=\"100\" height=\"100\" fill=\"#F8E7E1\"></rect><text x=\"50\" y=\"60\" text-anchor=\"middle\" font-family=\"Georgia, serif\" font-size=\"26\" letter-spacing=\"2\" fill=\"#C47A78\">PP</text></svg></template>\n\n</div>\n"}